{
  "name": "blazor-tailwind-ui",
  "version": "1.6.0",
  "private": true,
  "description": "Mobile-first Blazor WASM reusable component library with Tailwind CSS and Light/Dark/System theme support",
  "scripts": {
    "build:css": "tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/app.min.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/app.min.css --watch",
    "build:dist": "npm run build:css && dotnet publish BlazorTailwindUI.csproj -c Release -o dist",
    "tauri": "tauri",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "axe-core": "^4.14.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "gridstack": "12.3.3",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1"
  }
}
