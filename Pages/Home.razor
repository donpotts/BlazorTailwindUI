                                    </div>

                                    <div class="flex items-center gap-4 pt-1">
                                        <TwCheckbox Label="Outlined / Pill" @bind-Checked="_pgOutlined" />
                                        <TwCheckbox Label="Show Dot / Icon" @bind-Checked="_pgShowIcon" />
                                    </div>
                                </div>

                                <!-- Live Rendered Output & Generated Code -->
                                <div class="space-y-4 flex flex-col justify-between">
                                    <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex items-center justify-center min-h-[120px] shadow-inner">
                                        @if (_pgComponent == "button")
                                        {
                                            <TwButton Variant="@GetPgButtonVariant()" Size="@GetPgSize()" ResponsiveFullWidth="false">
                                                @_pgText
                                            </TwButton>
                                        }
                                        else if (_pgComponent == "badge")
                                        {
                                            <TwBadge Variant="@GetPgSemanticVariant()" Size="@GetPgSize()" ShowDot="@_pgShowIcon" Outlined="@_pgOutlined">
                                                @_pgText
                                            </TwBadge>
                                        }
                                        else if (_pgComponent == "alert")
                                        {
                                            <TwAlert Variant="@GetPgSemanticVariant()" Title="@_pgText" Class="w-full">
                                                Enterprise feedback and notification banner.
                                            </TwAlert>
                                        }
                                        else if (_pgComponent == "gauge")
                                        {
                                            <TwGauge Value="88" Label="@_pgText" Min="0" Max="100" Unit="%" />
                                        }
                                        else if (_pgComponent == "countup")
                                        {
                                            <div class="text-3xl font-black text-brand-600">
                                                <TwCountUp StartValue="0" EndValue="124500" Prefix="$" DurationMs="1200" />
                                            </div>
                                        }
                                        else if (_pgComponent == "animate")
                                        {
                                            <TwAnimate Type="TwAnimate.AnimationType.BounceIn">
                                                <div class="p-4 rounded-xl bg-brand-500 text-white font-bold">
                                                    @_pgText
                                                </div>
                                            </TwAnimate>
                                        }
                                        else if (_pgComponent == "bento")
                                        {
                                            <TwBentoCard ColSpan="1" Title="@_pgText" Description="Interactive spotlight card" Class="w-full">
                                                <span class="text-xs text-brand-500 font-semibold">Hover to see radial glow</span>
                                            </TwBentoCard>
                                        }
                                        else if (_pgComponent == "avatargroup")
                                        {
                                            <TwAvatarGroup Avatars="@_teamAvatars" Max="4" Size="@GetPgSize()" />
                                        }
                                        else if (_pgComponent == "codeblock")
                                        {
                                            <TwCodeBlock FileName="Preview.razor" Language="razor" Code="@($"<TwButton Variant=\"ButtonVariant.{_pgVariant}\">{_pgText}</TwButton>")" Class="w-full" />
                                        }
                                        else if (_pgComponent == "kpimetric")
                                        {
                                            <TwKpiMetric Title="@_pgText" Value="$142,850" ChangePercentage="18.4" SparklineData="@(new double[] { 10, 15, 12, 18, 22, 28 })" Class="w-full" />
                                        }
                                        else if (_pgComponent == "mediaplayer")
                                        {
                                            <div class="w-full max-w-md">
                                                <TwMediaPlayer Src="videos/demo-video.mp4"
                                                               Poster="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80"
                                                               Title="@_pgText"
                                                               Subtitle="Interactive Playground Preview" />
                                            </div>
                                        }
                                        else if (_pgComponent == "qrcode")
                                        {
                                            <TwQrCode Value="@_pgText" Title="Preview QR Code" Size="180" DotShape="TwQrCode.QrDotShape.Rounded" CenterIcon="TwQrCode.QrCenterIcon.Bolt" />
                                        }
                                        else if (_pgComponent == "barcode")
                                        {
                                            <TwBarcode Value="@_pgText" Title="Preview Barcode" BarHeight="60" />
                                        }
                                        else if (_pgComponent == "signaturepad")
                                        {
                                            <div class="w-full max-w-md">
                                                <TwSignaturePad Title="@_pgText" Height="160" />
                                            </div>
                                        }
                                        else if (_pgComponent == "imagecompare")
                                        {
                                            <div class="w-full max-w-md">
                                                <TwImageCompare BeforeSrc="images/compare-before.jpg"
                                                                AfterSrc="images/compare-after.jpg"
                                                                BeforeLabel="Before"
                                                                AfterLabel="After"
                                                                Class="aspect-video" />
                                            </div>
                                        }
                                        else if (_pgComponent == "marquee")
                                        {
                                            <div class="w-full max-w-md py-2">
                                                <TwMarquee DurationSeconds="15" FadeEdges="true">
                                                    <span class="px-3 py-1 rounded-lg bg-brand-100 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 font-bold text-xs">.NET 11</span>
                                                    <span class="px-3 py-1 rounded-lg bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 font-bold text-xs">Tailwind CSS</span>
