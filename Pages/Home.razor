    private async Task SwitchOrScroll(string tab, string anchorId)
    {
        if (_activeTab != tab)
        {
            _activeTab = tab;
            StateHasChanged();
            await Task.Delay(150);
        }
        try
        {
            await JS.InvokeVoidAsync("blazorTheme.scrollToElement", anchorId);
        }
        catch
        {
            // Ignore JS interop exceptions during navigation
        }
    }

