                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">AI Chatbot & Reasoning Steppers</span>
                                </div>
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
                                    <span class="text-indigo-500 font-bold">🎬</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">1080p Video Tour & Chapter Player</span>
                                </div>
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
