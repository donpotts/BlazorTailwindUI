                                        </span>
                                    </Badge>
                                    <ChildContent>
                                        <div class="w-full grid grid-cols-1 sm:grid-cols-3 gap-3">
                                            <TwKpiMetric Title="ARR Revenue" Value="$142,850" Subtitle="vs. last month" ChangePercentage="18.4" SparklineData="@(new double[] { 100, 115, 108, 125, 132, 142 })" />
                                            <TwKpiMetric Title="Active Nodes" Value="1,420" Subtitle="Global edge" ChangePercentage="4.2" SparklineData="@(new double[] { 1200, 1240, 1310, 1350, 1390, 1420 })" />
                                            <TwKpiMetric Title="Edge Latency" Value="18ms" Subtitle="p99 percentile" ChangePercentage="-12.5" Color="#10b981" SparklineData="@(new double[] { 32, 28, 24, 22, 19, 18 })" />
                                        </div>
