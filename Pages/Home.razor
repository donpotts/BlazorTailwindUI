                                        <div class="p-4 rounded-2xl bg-brand-500/5 border border-brand-500/20 text-center space-y-2">
                                            <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-wider block">Hover Effect</span>
                                            <p class="text-xs text-slate-500 dark:text-slate-400">
