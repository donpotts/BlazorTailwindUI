                                            <select value="@_pgVariant" @onchange='e => _pgVariant = e.Value?.ToString() ?? "Primary"' class="w-full px-2.5 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs focus:outline-none">
                                                <option value="Primary">Primary</option>
                                                <option value="Success">Success</option>
                                                <option value="Warning">Warning</option>
                                                <option value="Danger">Danger / Destructive</option>
                                                <option value="Info">Info</option>
                                                <option value="Outline">Outline</option>
                                                <option value="Ghost">Ghost</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="text-[11px] font-semibold text-slate-500 block mb-1">Size</label>
                                            <select value="@_pgSize" @onchange='e => _pgSize = e.Value?.ToString() ?? "Sm"' class="w-full px-2.5 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs focus:outline-none">
                                                <option value="Xs">Xs (Extra Small)</option>
                                                <option value="Sm">Sm (Small)</option>
                                                <option value="Md">Md (Medium)</option>
                                                <option value="Lg">Lg (Large)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div>
                                        <label class="text-[11px] font-semibold text-slate-500 block mb-1">Label / Text Content</label>
