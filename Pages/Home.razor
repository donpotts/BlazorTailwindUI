                                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                        <span>1080p Video Tour</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Continuous Ecosystem Marquee -->
                        <div class="py-2">
                            <TwMarquee DurationSeconds="26" PauseOnHover="true" FadeEdges="true" Class="py-1">
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
                                    <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">.NET 11 RC WebAssembly</span>
                                </div>
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
                                    <span class="text-cyan-500 font-bold">⚡</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">Tailwind CSS v3.4+ Standalone</span>
                                </div>
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
                                    <span class="text-emerald-500 font-bold">✓</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">Zero External CDN Dependencies</span>
                                </div>
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
                                    <span class="text-purple-500 font-bold">📊</span>
                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">Enterprise Sortable DataGrid</span>
                                </div>
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
