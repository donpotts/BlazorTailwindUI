                            <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-brand-500/20 blur-3xl pointer-events-none"></div>
                            <div class="relative z-10 max-w-3xl space-y-4">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-500/20 text-brand-300 ring-1 ring-brand-500/30">
