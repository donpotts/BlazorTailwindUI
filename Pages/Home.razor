                                                                <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full @(member.Status == "online" ? "bg-emerald-500" : (member.Status == "busy" ? "bg-rose-500" : "bg-amber-500")) ring-2 ring-white dark:ring-slate-900"></span>
