                        <!-- 4. Interactive Knowledge Check Quiz -->
                        <TwCard Title="Knowledge Check & Certification" Subtitle="Test your understanding of the component library design principles">
                            <div class="space-y-4">
                                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-3">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white block">
                                        Question 1: Why does TwDataGrid switch from a table to stacked cards on screen widths below 768px?
                                    </span>
                                    <div class="space-y-2 text-xs">
                                        <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-slate-200 dark:border-slate-750 cursor-pointer hover:bg-white dark:hover:bg-slate-800">
                                            <input type="radio" name="quiz1" @onchange='() => _quiz1Answer = "a"' checked="@(_quiz1Answer == "a")" class="text-brand-600" />
                                            <span>To prevent awkward horizontal scrolling and ensure tap targets remain accessible on touch devices.</span>
                                        </label>
                                        <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-slate-200 dark:border-slate-750 cursor-pointer hover:bg-white dark:hover:bg-slate-800">
                                            <input type="radio" name="quiz1" @onchange='() => _quiz1Answer = "b"' checked="@(_quiz1Answer == "b")" class="text-brand-600" />
                                            <span>Because WebAssembly cannot render table HTML tags on mobile browsers.</span>
                                        </label>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_quiz1Answer))
                                    {
                                        <div class="p-2.5 rounded-xl text-xs font-semibold @(_quiz1Answer == "a" ? "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : "bg-rose-50 text-rose-700")">
                                            @(_quiz1Answer == "a" ? "✓ Correct! Mobile screens require card transformation for zero horizontal blowout." : "✕ Incorrect. WebAssembly supports all HTML tags; card shift is an intentional UX best practice.")
                                        </div>
                                    }
                                </div>

                                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-3">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white block">
                                        Question 2: How does TwBentoCard achieve the smooth mouse-following radial spotlight glow?
                                    </span>
                                    <div class="space-y-2 text-xs">
                                        <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-slate-200 dark:border-slate-750 cursor-pointer hover:bg-white dark:hover:bg-slate-800">
                                            <input type="radio" name="quiz2" @onchange='() => _quiz2Answer = "a"' checked="@(_quiz2Answer == "a")" class="text-brand-600" />
                                            <span>By updating CSS custom properties (--mouse-x, --mouse-y) via lightweight JS pointer tracking that feeds a radial-gradient layer.</span>
                                        </label>
                                        <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-slate-200 dark:border-slate-750 cursor-pointer hover:bg-white dark:hover:bg-slate-800">
