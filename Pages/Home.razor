    private async Task HandleDemoChatSend(ChatMessage msg)
    {
        _demoChatMessages.Add(msg);
        _demoChatIsTyping = true;
        await Task.Delay(1200);

        _demoChatIsTyping = false;
        var responseContent = msg.Content.ToLower().Contains("cluster")
            ? "Edge cluster telemetry indicates 24 nodes healthy with 1.2ms average roundtrip latency and zero memory leaks under the .NET 11 Runtime Native Async V2 pipeline."
            : msg.Content.ToLower().Contains("schema")
            ? "Generated C# 15 record with closed hierarchy: public union ApiResponse(Success, Failure); public record Success(string Payload); public record Failure(int ErrorCode, string Message);"
            : $"Analyzed prompt: '{msg.Content}'. All downstream data validations passed with zero runtime allocations and sub-millisecond execution.";

        _demoChatMessages.Add(new ChatMessage
        {
            Role = ChatRole.Assistant,
            Content = responseContent,
            Timestamp = DateTime.Now
        });
    }

    private async Task HandleDemoChatRegen(ChatMessage msg)
    {
        _demoChatIsTyping = true;
        await Task.Delay(1000);
        _demoChatIsTyping = false;
        msg.Content = "Regenerated analysis: Pipeline throughput optimized. All 162 enterprise UI components are fully tree-shaken and running natively in client WebAssembly.";
        msg.Timestamp = DateTime.Now;
    }

