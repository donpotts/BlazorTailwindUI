                                                    <button type="button" class="px-4 py-2 text-xs font-bold rounded-xl bg-brand-600 hover:bg-brand-500 text-white shadow-md shadow-brand-500/20 inline-flex items-center gap-2 transition-all">
                                                        <span>⚙️ Configure Metrics</span>
                                                        <span class="text-[10px] bg-white/20 px-1.5 py-0.5 rounded">Popover</span>
                                                    </button>
                                                </AnchorContent>
                                                <ChildContent>
                                                    <div class="space-y-3">
                                                        <div class="text-xs text-slate-600 dark:text-slate-300">
                                                            Configure real-time telemetry filters for your edge cluster view:
                                                        </div>
                                                        <div class="space-y-2">
                                                            <label class="flex items-center gap-2 text-xs font-medium cursor-pointer">
                                                                <input type="checkbox" checked class="rounded text-brand-600 focus:ring-brand-500" />
                                                                <span>Live Memory Stream</span>
                                                            </label>
                                                            <label class="flex items-center gap-2 text-xs font-medium cursor-pointer">
                                                                <input type="checkbox" checked class="rounded text-brand-600 focus:ring-brand-500" />
                                                                <span>P99 Query Latency</span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </ChildContent>
                                                <Footer>
                                                    <button type="button" @onclick='() => _demoPopoverOpen = false' class="px-3 py-1 text-xs font-bold rounded-lg bg-brand-600 text-white">Apply</button>
                                                </Footer>
                                            </TwPopover>

                                            <!-- Placement Switcher -->
                                            <div class="flex items-center gap-1.5 text-xs text-slate-500">
                                                <span>Position:</span>
                                                <select @bind="_demoPopoverPlacement" class="text-xs py-1 px-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800">
                                                    <option value="@TwPopoverPlacement.Bottom">Bottom</option>
                                                    <option value="@TwPopoverPlacement.Top">Top</option>
                                                    <option value="@TwPopoverPlacement.Left">Left</option>
                                                    <option value="@TwPopoverPlacement.Right">Right</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- TwSnackbar -->
                                    <div class="space-y-3">
                                        <div class="flex items-center justify-between">
                                            <h4 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5 uppercase tracking-wider">
                                                <span>🔔</span> 3. Actionable Snackbar (TwSnackbar)
                                            </h4>
                                            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                                                Timer Bar • Undo Action
                                            </span>
                                        </div>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">
                                            Bottom screen banner with interactive action trigger (e.g. Undo), animated countdown progress bar, and hover pause.
                                        </p>
                                        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center justify-center gap-3">
                                            <button type="button"
                                                    @onclick='() => TriggerDemoSnackbar("File moved to trash", "Undo", SemanticVariant.Default)'
                                                    class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 hover:bg-slate-300 transition-colors">
                                                Default Banner
                                            </button>
                                            <button type="button"
                                                    @onclick='() => TriggerDemoSnackbar("Database cluster snapshot completed", "View Log", SemanticVariant.Success)'
                                                    class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/20 transition-colors">
                                                Success with Action
                                            </button>
                                            <button type="button"
                                                    @onclick='() => TriggerDemoSnackbar("High packet loss detected on US-East-1", "Investigate", SemanticVariant.Danger)'
                                                    class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 hover:bg-rose-500/20 transition-colors">
                                                Danger Alert
                                            </button>
                                        </div>

                                        <TwSnackbar @bind-IsOpen="_demoSnackbarOpen"
                                                    Message="@_demoSnackbarMessage"
                                                    ActionText="@_demoSnackbarAction"
                                                    Variant="_demoSnackbarVariant"
                                                    DurationMs="5000"
                                                    OnAction='() => Toast.Show("Snackbar action invoked!", "Undo operation processed successfully.", SemanticVariant.Success)' />
                                    </div>
                                </div>
                            </div>
                        </TwCard>

                        <!-- Enterprise PickList, Duration Picker & Virtual Keyboard Suite -->
                        <TwCard Title="PickList Transfer, Duration & Virtual Keypad Suite" Subtitle="Dual-Listbox Entity Transfer, Precision TimeSpan Steppers, and Touchscreen Kiosk Keypads">
                            <div class="space-y-8">
                                <!-- 1. TwPickList -->
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between">
                                        <h4 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5 uppercase tracking-wider">
                                            <span>🔀</span> 1. Dual-List Item Transfer Picker (TwPickList)
                                        </h4>
                                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-brand-500/10 text-brand-600 dark:text-brand-400">
                                            Dual-Search • Reorder • Batch Transfer
                                        </span>
                                    </div>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">
                                        Enterprise transfer picker with real-time search on both lists, batch transfer buttons, double-click assignment, and target position reordering.
                                    </p>
                                    <TwPickList TItem="string"
                                                Source="_demoAvailableRoles"
                                                @bind-Target="_demoAssignedRoles"
                                                SourceTitle="Available Cloud Roles"
                                                TargetTitle="Assigned Operator Roles"
                                                AllowFiltering="true"
                                                ShowMoveAll="true"
                                                ShowReorder="true"
                                                Height="h-60"
                                                OnTransfer="HandlePickListTransfer" />

                                    <!-- Active Role Assignment & Kubernetes IAM Policy Card -->
                                    <div class="mt-4 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/60 backdrop-blur-sm space-y-3">
                                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
                                            <div class="flex items-center gap-2">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold @(_demoAssignedRoles.Count > 0 ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-slate-200 dark:bg-slate-800 text-slate-500")">
                                                    @(_demoAssignedRoles.Count > 0 ? $"Active Policy: {_demoAssignedRoles.Count} Roles Granted" : "No Roles Assigned")
                                                </span>
                                                @if (_demoAssignedRoles.Any(r => r.Contains("Security") || r.Contains("Kubernetes")))
                                                {
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                        PRIVILEGED ENCLAVE ACCESS
                                                    </span>
                                                }
                                            </div>
                                            <div class="flex items-center gap-2 text-xs">
                                                <button type="button"
                                                        @onclick="ResetDemoRoles"
                                                        class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 font-medium transition-colors">
                                                    Reset Roster
                                                </button>
                                                <button type="button"
                                                        @onclick="CopyDemoIamPolicy"
                                                        class="px-3 py-1 rounded-lg bg-brand-600 hover:bg-brand-500 text-white font-medium shadow-xs transition-colors flex items-center gap-1.5">
                                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                    </svg>
                                                    <span>@(_iamPolicyCopied ? "Copied to Clipboard!" : "Export K8s ClusterRoleBinding")</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Active Granted Roles Chips -->
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <span class="text-xs text-slate-500 font-medium">Granted Subjects:</span>
                                            @if (_demoAssignedRoles.Count == 0)
                                            {
                                                <span class="text-xs italic text-slate-400">None selected. Move roles from the left column into the assigned list.</span>
                                            }
                                            else
                                            {
                                                @foreach (var role in _demoAssignedRoles)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300 border border-brand-200/60 dark:border-brand-800/60">
                                                        <svg class="w-3 h-3 text-brand-500" fill="currentColor" viewBox="0 0 20 20">
                                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                        </svg>
                                                        @role
                                                    </span>
                                                }
                                            }
                                        </div>

                                        <!-- Reactive JSON ClusterRoleBinding IAM Spec -->
                                        <div class="relative rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-900 text-slate-200 p-3 font-mono text-[11px] overflow-x-auto">
                                            <div class="text-slate-400 text-[10px] pb-1 uppercase tracking-wider font-semibold border-b border-slate-800 mb-2 flex justify-between">
                                                <span>Generated Kubernetes RBAC Manifest</span>
                                                <span class="text-emerald-400">Synced Real-Time</span>
                                            </div>
                                            <pre class="m-0 leading-relaxed text-slate-300">@GetGeneratedIamPolicyJson()</pre>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. TwTimeSpanPicker & TwVirtualKeyboard -->
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pt-6 border-t border-slate-100 dark:border-slate-800">
                                    <!-- TwTimeSpanPicker -->
                                    <div class="space-y-3">
                                        <div class="flex items-center justify-between">
                                            <h4 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5 uppercase tracking-wider">
                                                <span>⏱️</span> 2. Duration &amp; TimeSpan Picker (TwTimeSpanPicker)
                                            </h4>
                                            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                                                Spin Steppers • Preset Pills
                                            </span>
                                        </div>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">
                                            Structured days, hours, minutes, and seconds input blocks with spin buttons, zero reset, and quick duration presets.
                                        </p>
                                        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200/80 dark:border-slate-800">
                                            <TwTimeSpanPicker Label="SLA Resolution Target"
                                                              @bind-Value="_demoDurationSla"
                                                              AllowDays="true"
                                                              AllowSeconds="true"
                                                              ShowPresets="true"
                                                              ShowReset="true" />

                                            <!-- Live Incident SLA Expiration Schedule Card -->
                                            <div class="mt-4 p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2.5">
                                                <div class="flex items-center justify-between text-xs">
                                                    <span class="text-slate-500 dark:text-slate-400 font-medium">Computed Target Deadline:</span>
                                                    <span class="font-mono font-bold text-slate-900 dark:text-white">
                                                        @DateTime.UtcNow.Add(_demoDurationSla).ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
                                                    </span>
                                                </div>
                                                <div class="grid grid-cols-4 gap-2 text-center text-xs">
                                                    <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800">
                                                        <div class="font-mono font-bold text-slate-900 dark:text-white text-sm">@_demoDurationSla.Days</div>
                                                        <div class="text-[10px] text-slate-400 uppercase font-semibold">Days</div>
                                                    </div>
                                                    <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800">
                                                        <div class="font-mono font-bold text-slate-900 dark:text-white text-sm">@_demoDurationSla.Hours</div>
                                                        <div class="text-[10px] text-slate-400 uppercase font-semibold">Hours</div>
                                                    </div>
                                                    <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800">
                                                        <div class="font-mono font-bold text-slate-900 dark:text-white text-sm">@_demoDurationSla.Minutes</div>
                                                        <div class="text-[10px] text-slate-400 uppercase font-semibold">Mins</div>
                                                    </div>
                                                    <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800">
                                                        <div class="font-mono font-bold text-slate-900 dark:text-white text-sm">@_demoDurationSla.Seconds</div>
                                                        <div class="text-[10px] text-slate-400 uppercase font-semibold">Secs</div>
                                                    </div>
                                                </div>
                                                <div class="flex items-center justify-between pt-1">
                                                    <div class="flex items-center gap-1.5 text-xs">
                                                        <span class="w-2 h-2 rounded-full @GetSlaUrgencyColor(_demoDurationSla)"></span>
                                                        <span class="font-semibold text-slate-700 dark:text-slate-300">@GetSlaUrgencyLabel(_demoDurationSla)</span>
                                                    </div>
                                                    <button type="button"
                                                            @onclick="DispatchSlaIncident"
                                                            class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white transition-colors shadow-xs">
                                                        Dispatch Incident
                                                    </button>
                                                </div>
                                                @if (!string.IsNullOrEmpty(_slaDispatchStatus))
                                                {
                                                    <div class="p-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-xs font-mono">
                                                        @_slaDispatchStatus
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- TwVirtualKeyboard -->
                                    <div class="space-y-3">
                                        <div class="flex items-center justify-between">
                                            <h4 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5 uppercase tracking-wider">
                                                <span>⌨️</span> 3. Virtual Keypad &amp; PIN Pad (TwVirtualKeyboard)
                                            </h4>
                                            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400">
                                                QWERTY • Numeric • Scrambled PIN
                                            </span>
                                        </div>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">
                                            Touchscreen on-screen keyboard for kiosks and POS terminals with anti-shoulder-surfing randomized PIN keypad scramble.
                                        </p>
                                        <div class="flex flex-col items-center gap-3">
                                            <TwVirtualKeyboard @bind-Value="_demoKeyboardValue"
                                                               Mode="TwVirtualKeyboard.VirtualKeyboardMode.Pin"
                                                               IsPassword="false"
                                                               ShowDisplay="true"
                                                               AllowModeSwitch="true"
                                                               OnSubmit="AuthorizeKioskPin" />

                                            <!-- Live Terminal Authorization Console -->
                                            <div class="w-full max-w-xl p-4 rounded-2xl border @(_terminalUnlocked ? "border-emerald-500/30 bg-emerald-50/40 dark:bg-emerald-950/20" : _terminalAccessDenied ? "border-rose-500/30 bg-rose-50/40 dark:bg-rose-950/20" : "border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/60") space-y-3 transition-all duration-300">
                                                <div class="flex items-center justify-between">
                                                    <div class="flex items-center gap-2">
                                                        @if (_terminalUnlocked)
                                                        {
                                                            <span class="flex h-2.5 w-2.5 relative">
                                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                                                            </span>
                                                            <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
                                                                Enclave Operational • Clearance Level 4
                                                            </span>
                                                        }
                                                        else if (_terminalAccessDenied)
                                                        {
                                                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                                                            <span class="text-xs font-bold text-rose-700 dark:text-rose-400 uppercase tracking-wider">
                                                                Access Denied • Invalid PIN Code
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                                                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                                                                Terminal Locked • PIN Required (Default: 7492)
                                                            </span>
                                                        }
                                                    </div>

                                                    @if (_terminalUnlocked)
                                                    {
                                                        <button type="button"
                                                                @onclick="LockTerminalSession"
                                                                class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-rose-600 hover:bg-rose-500 text-white transition-colors">
                                                            Lock Terminal
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                @onclick="AuthorizeKioskPin"
                                                                class="px-3 py-1 text-xs font-semibold rounded-lg bg-brand-600 hover:bg-brand-500 text-white transition-colors">
                                                            Authenticate PIN
                                                        </button>
                                                    }
                                                </div>

                                                @if (_terminalUnlocked)
                                                {
                                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs pt-1">
                                                        <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
                                                            <div class="text-[10px] text-slate-400 font-medium uppercase">Active Operator</div>
                                                            <div class="font-mono font-bold text-slate-900 dark:text-white">SEC-OPERATOR-9021</div>
                                                            <div class="text-[10px] text-slate-500">Node: us-east-prod-enclave-01</div>
                                                        </div>
                                                        <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
                                                            <div class="text-[10px] text-slate-400 font-medium uppercase">Session Grant Token</div>
                                                            <div class="font-mono font-bold text-emerald-600 dark:text-emerald-400 truncate">@_terminalSessionToken</div>
                                                            <div class="text-[10px] text-slate-500">Hardware Crypto Key Decrypted</div>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-1.5 text-[11px] text-emerald-700 dark:text-emerald-300">
                                                        <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                        </svg>
                                                        <span>Full access granted to Post-Quantum ML-KEM Vault and HSM root key storage.</span>
                                                    </div>
                                                }
                                                else if (_terminalAccessDenied)
                                                {
                                                    <div class="text-xs text-rose-600 dark:text-rose-400">
                                                        Security violation logged to OpenTelemetry audit trail. Please enter passcode <strong>7492</strong> on the keypad and tap Authenticate.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-xs text-slate-500 dark:text-slate-400">
                                                        Tap digits or toggle QWERTY mode above, then click <strong>Authenticate PIN</strong> to unlock the secure operational terminal.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </TwCard>

                        <!-- Enterprise Storage Manager & Advanced Flow Visualizations -->
                        <TwCard Title="Enterprise Storage Manager & Advanced Flow Visualizations" Subtitle="Cloud Asset File Manager, Pure SVG Word Cloud, and Multi-Stage Sankey Pipeline Flow">
                            <div class="space-y-8">
                                <!-- 1. TwFileManager -->
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between">
                                        <h4 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5 uppercase tracking-wider">
                                            <span>🗂️</span> 1. Enterprise Cloud File Manager (TwFileManager)
                                        </h4>
                                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-brand-500/10 text-brand-600 dark:text-brand-400">
                                            Folder Tree • Breadcrumbs • Grid/List Views • Quota Meter
                                        </span>
                                    </div>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">
                                        Enterprise file system explorer featuring folder sidebar tree, breadcrumb hierarchy, grid vs list view toggling, real-time file search, and storage metrics.
                                    </p>
                                    <TwFileManager Items="_demoFileManagerItems"
                                                   @bind-CurrentPath="_demoFileCurrentPath"
                                                   OnFileSelected="HandleDemoFileSelect"
                                                   OnFileOpened="HandleDemoFileOpen"
                                                   OnUpload="HandleDemoFileUpload" />

                                    <!-- Live File Inspector & Content Preview Panel -->
                                    @if (_selectedDemoFile != null)
                                    {
                                        <div class="mt-4 p-5 rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/60 backdrop-blur-md shadow-lg space-y-4">
                                            <!-- Header & Action Row -->
                                            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-10 h-10 rounded-2xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center text-xl shadow-xs">
                                                        @GetFileIconDisplay(_selectedDemoFile)
                                                    </div>
                                                    <div>
                                                        <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                                            <span>@_selectedDemoFile.Name</span>
                                                            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                                                @(_selectedDemoFile.Extension?.ToUpperInvariant() ?? "FILE")
                                                            </span>
                                                        </h4>
                                                        <p class="text-xs text-slate-500 dark:text-slate-400">
                                                            @_selectedDemoFile.Path • @FormatFileSize(_selectedDemoFile.SizeBytes) • Modified @_selectedDemoFile.Modified.ToString("yyyy-MM-dd HH:mm")
                                                        </p>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-2 text-xs">
                                                    <button type="button"
                                                            @onclick='() => _fileInspectorHashVerified = true'
