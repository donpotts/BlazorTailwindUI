                                                <div class="flex items-center justify-between text-xs">
                                                    <span class="font-bold">📊 CRM Draggable Dashboard Widget</span>
                                                    <span class="font-mono text-emerald-400 font-bold">$142,850 ARR</span>
                                                </div>
                                                <p class="text-[11px] text-slate-400">Persistent LocalStorage grid with touch drag handles and SVG charts.</p>
                                                <button type="button" @onclick='() => _activeTab = "dashboard-studio"' class="text-xs text-brand-400 font-bold hover:underline">Launch Full Studio →</button>
                                            </div>
                                        }
                                        else if (_pgComponent == "pdffiller")
                                        {
                                            <div class="w-full p-4 rounded-xl bg-indigo-950 border border-indigo-800 text-white space-y-2">
                                                <div class="flex items-center justify-between text-xs">
                                                    <span class="font-bold">✍️ PDF Form Filler &amp; Contract Signer</span>
                                                    <span class="font-mono text-indigo-300 font-bold">AcroForm Stamp</span>
                                                </div>
                                                <p class="text-[11px] text-indigo-200">Spatial signature placement and irreversible flattening stream export.</p>
                                                <button type="button" @onclick='() => _activeTab = "pdf-studio"' class="text-xs text-indigo-400 font-bold hover:underline">Launch Full Studio →</button>
                                            </div>
                                        }
                                        else if (_pgComponent == "unionboundary")
                                        {
                                            <div class="w-full p-4 rounded-xl bg-emerald-950/80 border border-emerald-800 text-white space-y-2">
                                                <div class="flex items-center justify-between text-xs">
                                                    <span class="font-bold">🛡️ C# 15 Discriminated Union Boundary</span>
                                                    <span class="font-mono text-emerald-400 font-bold">UiState&lt;T&gt;</span>
                                                </div>
                                                <p class="text-[11px] text-emerald-200">Exhaustive compiler matching over Loading, Success, Empty, and Failure.</p>
                                                <button type="button" @onclick='() => _activeTab = "union-studio"' class="text-xs text-emerald-400 font-bold hover:underline">Launch Full Studio →</button>
                                            </div>
                                        }
                                        else if (_pgComponent == "spatialcard")
                                        {
                                            <div class="w-full max-w-sm">
                                                <TwSpatialCard Title="@_pgText" Subtitle="Volumetric 3D Tilt" Glassmorphism="true">
                                                    <p class="text-xs text-slate-300">Hover and move mouse or tilt phone to experience gyroscopic parallax.</p>
                                                </TwSpatialCard>
                                            </div>
                                        }
                                        else if (_pgComponent == "fluidmesh")
                                        {
                                            <div class="w-full max-w-sm">
                                                <TwFluidMesh />
                                            </div>
                                        }
                                        else if (_pgComponent == "micrreader")
                                        {
                                            <div class="w-full max-w-md">
                                                <TwMicrCheckReader />
                                            </div>
                                        }
                                    </div>

                                    <!-- Code Box -->
                                    <div class="space-y-1.5">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Generated Razor Snippet</span>
