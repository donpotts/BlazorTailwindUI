    private IEnumerable<NavGroup> FilteredNavGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_navSearchQuery))
            {
                return _navGroups;
            }

            var query = _navSearchQuery.Trim();
            var result = new List<NavGroup>();

            foreach (var group in _navGroups)
            {
                var matchingItems = group.Items.Where(i =>
                    i.Label.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    i.Key.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    (i.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.Badge?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
                ).ToList();

                var isTitleMatch = group.Title.Contains(query, StringComparison.OrdinalIgnoreCase);
                var itemsToShow = matchingItems.Any() ? matchingItems : (isTitleMatch ? group.Items : new List<NavItem>());
                if (itemsToShow.Any())
                {
                    result.Add(new NavGroup(group.Title, group.Icon, $"{itemsToShow.Count} match", itemsToShow));
                }
            }

            return result;
        }
    }

