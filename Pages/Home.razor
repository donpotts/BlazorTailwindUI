                                            <div class="flex items-center gap-2">
                                                <TwKbd Key="cmd" Size="lg" />
                                                <span class="text-slate-400 font-bold">+</span>
                                                <TwKbd Key="shift" Size="lg" />
                                                <span class="text-slate-400 font-bold">+</span>
                                                <TwKbd Key="@_pgText" Size="lg" />
                                            </div>
