    private string GetGeneratedSnippet()
    {
        if (_pgComponent == "button")
            return $"<TwButton Variant=\"ButtonVariant.{_pgVariant}\" Size=\"ComponentSize.{_pgSize}\">{_pgText}</TwButton>";
        if (_pgComponent == "badge")
            return $"<TwBadge Variant=\"SemanticVariant.{_pgVariant}\" Size=\"ComponentSize.{_pgSize}\" ShowDot=\"{_pgShowIcon.ToString().ToLower()}\">{_pgText}</TwBadge>";
        if (_pgComponent == "alert")
            return $"<TwAlert Variant=\"SemanticVariant.{_pgVariant}\" Title=\"{_pgText}\">Enterprise feedback message.</TwAlert>";
        if (_pgComponent == "gauge")
            return $"<TwGauge Value=\"88\" Label=\"{_pgText}\" Min=\"0\" Max=\"100\" Unit=\"%\" />";
        if (_pgComponent == "countup")
            return $"<TwCountUp StartValue=\"0\" EndValue=\"124500\" Prefix=\"$\" DurationMs=\"1200\" />";
        if (_pgComponent == "bento")
            return $"<TwBentoCard ColSpan=\"1\" Title=\"{_pgText}\" Description=\"Spotlight Card\">\n    <span class=\"text-xs text-brand-500\">Content</span>\n</TwBentoCard>";
        if (_pgComponent == "avatargroup")
            return $"<TwAvatarGroup Avatars=\"@team\" Max=\"4\" Size=\"ComponentSize.{_pgSize}\" />";
        if (_pgComponent == "codeblock")
            return $"<TwCodeBlock FileName=\"Sample.razor\" Language=\"razor\" Code=\"<TwButton Variant=\\\"ButtonVariant.{_pgVariant}\\\">{_pgText}</TwButton>\" />";
        if (_pgComponent == "kpimetric")
            return $"<TwKpiMetric Title=\"{_pgText}\" Value=\"$142,850\" ChangePercentage=\"18.4\" SparklineData=\"@(new double[] {{ 10, 15, 12, 18, 22, 28 }})\" />";
        if (_pgComponent == "mediaplayer")
            return $"<TwMediaPlayer Src=\"videos/demo-video.mp4\"\n               Poster=\"poster.jpg\"\n               Title=\"{_pgText}\"\n               Subtitle=\"Tailwind Blazor WASM Player\" />";
        if (_pgComponent == "qrcode")
            return $"<TwQrCode Value=\"{_pgText}\"\n          Title=\"Quick QR Code\"\n          Size=\"200\"\n          DotShape=\"TwQrCode.QrDotShape.Rounded\"\n          CenterIcon=\"TwQrCode.QrCenterIcon.Bolt\"\n          EccLevel=\"TwQrCode.QrEccLevel.Q\" />";
        if (_pgComponent == "barcode")
            return $"<TwBarcode Value=\"{_pgText}\"\n           Title=\"Inventory SKU\"\n           BarHeight=\"64\"\n           ShowText=\"true\" />";
        if (_pgComponent == "signaturepad")
            return $"<TwSignaturePad Title=\"{_pgText}\"\n                Height=\"220\"\n                ShowGuide=\"true\"\n                OnSave=\"HandleSignatureSaved\" />";
        if (_pgComponent == "imagecompare")
            return $"<TwImageCompare BeforeSrc=\"images/compare-before.jpg\"\n                AfterSrc=\"images/compare-after.jpg\"\n                BeforeLabel=\"Before\"\n                AfterLabel=\"After\"\n                @bind-Position=\"_comparePos\"\n                Class=\"aspect-video\" />";
        if (_pgComponent == "marquee")
            return $"<TwMarquee DurationSeconds=\"25\" PauseOnHover=\"true\" FadeEdges=\"true\">\n    <div class=\"flex items-center gap-2\">{_pgText}</div>\n</TwMarquee>";
        if (_pgComponent == "snippet")
            return $"<TwSnippet Prefix=\"$\" Code=\"{_pgText}\" Title=\"Terminal\" ShowCopyButton=\"true\" />";
        if (_pgComponent == "kbd")
            return $"<TwKbd Key=\"cmd\" /> + <TwKbd Key=\"shift\" /> + <TwKbd Key=\"{_pgText}\" />";
        if (_pgComponent == "confetti")
            return $"<TwConfetti @ref=\"_confetti\" FullScreen=\"true\" />\n// In C#: await _confetti.FireAsync();";
        if (_pgComponent == "dashboard")
            return $"<TwDashboard StorageKey=\"crm-dashboard-user-1\" />";
        if (_pgComponent == "pdffiller")
            return $"<TwPdfFormFiller DefaultDocumentName=\"Master_Services_Agreement.pdf\" />";
        if (_pgComponent == "unionboundary")
            return $"<TwUnionBoundary TItem=\"List<Invoice>\" State=\"@invoiceState\" OnRetry=\"FetchInvoicesAsync\">\n    <Loading><div class=\"animate-pulse\">Loading...</div></Loading>\n    <Success Context=\"items\"><InvoicesTable Items=\"@items\" /></Success>\n    <Empty><div>No records found</div></Empty>\n    <Failure Context=\"err\"><div>Error: @err.Message</div></Failure>\n</TwUnionBoundary>";
        if (_pgComponent == "spatialcard")
            return $"<TwSpatialCard Title=\"{_pgText}\" Subtitle=\"Volumetric 3D Tilt & Specular Shine\">\n    <p class=\"text-xs text-slate-300\">Spatial card contents</p>\n</TwSpatialCard>";
        if (_pgComponent == "fluidmesh")
            return $"<TwFluidMesh Velocity=\"1.2\" Mood=\"FluidMood.Quantum\" />";
        if (_pgComponent == "micrreader")
            return $"<TwMicrCheckReader OnCheckParsed=\"HandleCheckParsed\" />";
        return $"<TwAnimate Type=\"TwAnimate.AnimationType.BounceIn\">{_pgText}</TwAnimate>";
    }

