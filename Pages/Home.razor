        sb.AppendLine("  \"roleRef\": { \"apiGroup\": \"rbac.authorization.k8s.io\", \"kind\": \"ClusterRole\", \"name\": \"cluster-operator\" },");
        sb.AppendLine("  \"subjects\": [");
        var roleList = _demoAssignedRoles.ToList();
