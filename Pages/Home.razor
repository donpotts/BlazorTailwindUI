        public string Initials { get; set; } = "";

        public UserRecord() { }

        public UserRecord(string name, string email, string role, bool isActive, string lastActive, string initials)
        {
            Id = Guid.NewGuid().ToString("N")[..8];
            Name = name;
            Email = email;
            Role = role;
            IsActive = isActive;
            LastActive = lastActive;
            Initials = initials;
        }

        public UserRecord Clone() => new()
        {
            Id = this.Id,
            Name = this.Name,
            Email = this.Email,
            Role = this.Role,
            IsActive = this.IsActive,
            LastActive = this.LastActive,
            Initials = this.Initials
        };
    }

