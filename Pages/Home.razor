@page "/"
@inject ToastService Toast
@inject ThemeService ThemeService
@inject IJSRuntime JS
@inject ServerPortBridgeService ServerBridge

<PageTitle>Blazor Tailwind UI — Mobile-First Core Components</PageTitle>

<TwAppShell Layout="@_activeLayout">
    <!-- Brand / Logo Slot -->
    <BrandContent>
        <div class="flex items-center gap-2.5">
            <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <div>
                <span class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white">Blazor<span class="text-brand-600 dark:text-brand-500">TwUI</span></span>
                <span class="hidden sm:inline-block ml-2 text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400">WASM</span>
            </div>
        </div>
    </BrandContent>

        <!-- Top Navigation Links (Desktop - Grouped Hubs) -->
    <TopNavContent>
        <button type="button" @onclick='() => _activeTab = "showcase"'
                class="px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center gap-1.5 @(_activeTab == "showcase" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400 font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800")">
            <span>⚡</span>
            <span>Showcase</span>
        </button>

        @foreach (var group in _navGroups)
        {
            var isGroupActive = group.Items.Any(i => i.Key == _activeTab);
            <TwDropdown Alignment="left">
                <TriggerContent>
                    <button type="button"
                            class="px-2.5 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition flex items-center gap-1.5 @(isGroupActive ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400 font-semibold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800")">
                        <span>@group.Icon</span>
                        <span>@group.Title</span>
                        <svg class="w-3.5 h-3.5 opacity-60 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </TriggerContent>
                <ChildContent>
                    <div class="w-64 py-1.5">
                        <div class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 flex items-center justify-between border-b border-slate-100 dark:border-slate-800 mb-1">
                            <span>@group.Title</span>
                            <span class="font-mono">@group.Badge</span>
                        </div>
                        @foreach (var item in group.Items)
                        {
                            var isSelected = _activeTab == item.Key;
                            <button type="button"
                                    @onclick="() => NavigateToItem(item)"
                                    class="w-full text-left px-3 py-2 text-xs rounded-lg flex items-center justify-between transition @(isSelected ? "bg-brand-50 dark:bg-brand-950/40 text-brand-600 dark:text-brand-400 font-bold" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")">
                                <div class="flex items-center gap-2 truncate">
                                    <span class="text-sm shrink-0">@item.Icon</span>
                                    <div class="truncate">
                                        <div class="font-medium">@item.Label</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="text-[10px] text-slate-400 dark:text-slate-500 truncate font-normal">@item.Description</div>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Badge))
                                {
                                    <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded shrink-0 @(isSelected ? "bg-brand-500 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-500")">
                                        @item.Badge
                                    </span>
                                }
                            </button>
                        }
                    </div>
                </ChildContent>
            </TwDropdown>
        }
    </TopNavContent>

    <!-- Header Actions Slot: Theme Switcher & Actions -->
    <HeaderActions>
        <!-- Client-Server API Port Health Indicator -->
        <div class="hidden lg:flex items-center gap-2 px-2.5 py-1.5 rounded-xl border border-emerald-500/30 bg-emerald-50/60 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 text-xs font-mono font-bold shadow-xs cursor-default"
             title="Verified Client-Server Port Connection: Active & Pre-flight Healthy">
            <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>API Online :@(ServerBridge.ActivePort)</span>
            <span class="text-[10px] text-emerald-600/70 dark:text-emerald-400/70">(@(ServerBridge.RoundtripMs.ToString("F1"))ms)</span>
        </div>
        <TwActivityMeter OnOpenCockpit="OpenTelemetryCockpit" />
        <button type="button" 
                @onclick="() => _commandPaletteOpen = true"
                class="hidden min-[360px]:flex p-2 sm:px-2.5 sm:py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white text-xs font-semibold transition items-center gap-2 focus:outline-none shadow-xs shrink-0"
                title="Quick Search & Command Palette (Ctrl+K)">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="hidden md:inline">Quick Search...</span>
            <div class="hidden sm:inline-flex items-center gap-0.5">
                <TwKbd Key="cmd" Size="xs" />
                <TwKbd Key="K" Size="xs" />
            </div>
        </button>
        <button type="button" 
                @onclick="() => _tourOpen = true"
                class="hidden md:inline-flex px-2.5 py-1.5 rounded-xl border border-brand-500/30 bg-brand-50/60 dark:bg-brand-950/40 text-brand-700 dark:text-brand-300 hover:bg-brand-100 dark:hover:bg-brand-900/50 text-xs font-bold transition items-center gap-1.5 focus:outline-none shadow-xs"
                title="Start Guided Coaching Tour">
            <span>🎓</span>
            <span>Coaching Tour</span>
        </button>
        <button type="button" 
                @onclick="OpenVideoTour"
                class="hidden lg:inline-flex px-2.5 py-1.5 rounded-xl border border-purple-500/30 bg-purple-50/60 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 hover:bg-purple-100 dark:hover:bg-purple-900/50 text-xs font-bold transition items-center gap-1.5 focus:outline-none shadow-xs"
                title="Watch 1080p Video Tour Walkthrough">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <span>Video Tour</span>
        </button>
        <button type="button" 
                @onclick='() => _activeTab = "docs"'
                class="hidden xl:inline-flex px-2.5 py-1.5 rounded-xl border border-indigo-500/30 bg-indigo-50/60 dark:bg-indigo-950/40 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 text-xs font-bold transition items-center gap-1.5 focus:outline-none shadow-xs"
                title="Browse Component Documentation & Settings (184 Components)">
            <span>📖</span>
            <span>Docs & Help</span>
        </button>
        <TwPwaInstallButton />
        <TwThemeSelector Alignment="right" />
        
        <div class="hidden sm:inline-block">
            <TwDropdown Alignment="right">
                <TriggerContent>
                    <button type="button" class="p-2 rounded-xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none" aria-label="Layout Options">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                    </button>
                </TriggerContent>
                <ChildContent>
                    <div class="px-3 py-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Switch Layout</div>
                    <button type="button" @onclick="() => SetLayout(LayoutVariant.Sidebar)" class="w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-between">
                        <span>Sidebar Layout</span>
                        @if (_activeLayout == LayoutVariant.Sidebar) { <span class="text-brand-600 font-bold">✓</span> }
                    </button>
                    <button type="button" @onclick="() => SetLayout(LayoutVariant.TopNav)" class="w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-between">
                        <span>TopNav Layout</span>
                        @if (_activeLayout == LayoutVariant.TopNav) { <span class="text-brand-600 font-bold">✓</span> }
                    </button>
                    <button type="button" @onclick="() => SetLayout(LayoutVariant.CompactRail)" class="w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-between">
                        <span>Compact Rail Layout</span>
                        @if (_activeLayout == LayoutVariant.CompactRail) { <span class="text-brand-600 font-bold">✓</span> }
                    </button>
                    <button type="button" @onclick="() => SetLayout(LayoutVariant.Stacked)" class="w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-between">
                        <span>Stacked Layout</span>
                        @if (_activeLayout == LayoutVariant.Stacked) { <span class="text-brand-600 font-bold">✓</span> }
                    </button>
                </ChildContent>
            </TwDropdown>
        </div>

        <div class="hidden sm:inline-flex">
            <TwAvatar Initials="JD" Size="ComponentSize.Sm" StatusColor="bg-emerald-500" />
        </div>
    </HeaderActions>

        <!-- Sidebar Navigation Content (Categorized Hubs with Real-Time Filter) -->
    <SidebarContent>
        <!-- Real-Time Navigation Filter Search -->
        <div class="px-1 mb-3">
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input type="text"
                       @bind="_navSearchQuery"
                       @bind:event="oninput"
                       placeholder="Filter navigation..."
                       class="w-full pl-8 pr-7 py-1.5 text-xs rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/70 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 transition" />
                @if (!string.IsNullOrWhiteSpace(_navSearchQuery))
                {
                    <button type="button" @onclick="() => _navSearchQuery = string.Empty" class="absolute inset-y-0 right-0 pr-2 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200" title="Clear filter">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                    </button>
                }
            </div>
        </div>

        <div class="space-y-4">
            @foreach (var group in FilteredNavGroups)
            {
                <div>
                    <div class="px-2 py-1 flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                        <span class="flex items-center gap-1.5">
                            <span>@group.Icon</span>
                            <span>@group.Title</span>
                        </span>
                        <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">@group.Badge</span>
                    </div>
                    <div class="space-y-0.5 mt-1">
                        @foreach (var item in group.Items)
                        {
                            var isSelected = _activeTab == item.Key;
                            <button type="button"
                                    @onclick="() => NavigateToItem(item)"
                                    class="w-full flex items-center justify-between px-2.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition group @(isSelected ? "bg-brand-500/10 text-brand-600 dark:text-brand-400 font-bold border-l-2 border-brand-500 pl-2" : "text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-slate-200")">
                                <div class="flex items-center gap-2.5 truncate">
                                    <span class="text-base shrink-0 transition-transform group-hover:scale-110">@item.Icon</span>
                                    <span class="truncate">@item.Label</span>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Badge))
                                {
                                    <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded-full shrink-0 @(isSelected ? "bg-brand-500 text-white" : "bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                                        @item.Badge
                                    </span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!FilteredNavGroups.Any())
            {
                <div class="p-4 text-center text-xs text-slate-400">
                    <p class="font-medium">No matches for "@_navSearchQuery"</p>
                    <button type="button" @onclick="() => _navSearchQuery = string.Empty" class="mt-2 text-brand-600 dark:text-brand-400 hover:underline">Clear search filter</button>
                </div>
            }
        </div>
    </SidebarContent>

    <SidebarFooter>
        <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between">
            <div class="text-xs">
                <p class="font-semibold text-slate-800 dark:text-slate-200">System Ready</p>
                <p class="text-slate-500 dark:text-slate-400">.NET 11 RC • Blazor WASM</p>
            </div>
            <TwBadge Variant="SemanticVariant.Success" ShowDot="true">Live</TwBadge>
        </div>
    </SidebarFooter>

    <!-- Rail Navigation Slot (Compact Icon-only) -->
    <RailContent>
        <button type="button" @onclick='() => _activeTab = "showcase"' title="Tailwind Showcase"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "showcase" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "components"' title="Core Components"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "components" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "gridcards"' title="Grids & Cards"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "gridcards" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "studio"' title="Studio & Financial Analytics"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "studio" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "aichat"' title="AI Chatbot"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "aichat" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "datatable"' title="Data Table"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "datatable" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "overlays"' title="Modals & Drawers"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "overlays" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "innovations"' title="Innovations & Quick Wins"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "innovations" ? "bg-amber-50 dark:bg-amber-500/15 text-amber-600 dark:text-amber-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "docs"' title="Docs, Settings & Developer Coach"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "docs" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
        </button>
        <button type="button" @onclick='() => _activeTab = "more"' title="More UI Components"
                class="w-12 h-12 flex items-center justify-center rounded-xl transition @(_activeTab == "more" ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
