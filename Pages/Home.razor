    private void SaveUserModal()
    {
        if (string.IsNullOrWhiteSpace(_editingUser.Name))
        {
            Toast.Show("Please enter a valid user name.", variant: SemanticVariant.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingUser.Email) || !_editingUser.Email.Contains('@'))
        {
            Toast.Show("Please enter a valid email address.", variant: SemanticVariant.Warning);
            return;
        }

        var parts = _editingUser.Name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        _editingUser.Initials = parts.Length switch
        {
            >= 2 => $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}",
            1 when parts[0].Length >= 2 => parts[0][..2].ToUpper(),
            1 => parts[0].ToUpper(),
            _ => "US"
        };

        if (_userModalMode == "add")
        {
            _editingUser.LastActive = "Just now";
            _users.Insert(0, _editingUser);
            Toast.Show($"User '{_editingUser.Name}' created successfully!", variant: SemanticVariant.Success);
        }
        else if (_userModalMode == "edit" && _originalUserToEdit != null)
        {
            _originalUserToEdit.Name = _editingUser.Name;
            _originalUserToEdit.Email = _editingUser.Email;
            _originalUserToEdit.Role = _editingUser.Role;
            _originalUserToEdit.IsActive = _editingUser.IsActive;
            _originalUserToEdit.Initials = _editingUser.Initials;
            Toast.Show($"User '{_originalUserToEdit.Name}' updated successfully!", variant: SemanticVariant.Success);
        }

        _userModalOpen = false;
        StateHasChanged();
    }

    private void OpenDeleteUserConfirm(UserRecord user)
    {
        _userToDelete = user;
        _deleteConfirmOpen = true;
    }

    private void ConfirmDeleteUser()
    {
        if (_userToDelete != null)
        {
            _users.Remove(_userToDelete);
            Toast.Show($"User '{_userToDelete.Name}' permanently deleted.", variant: SemanticVariant.Danger);
            _userToDelete = null;
        }
        _deleteConfirmOpen = false;
        StateHasChanged();
    }

    private void DeleteSelectedUsers(IReadOnlyList<UserRecord> selected)
    {
        if (selected == null || selected.Count == 0) return;
        var count = selected.Count;
        foreach (var u in selected.ToList())
        {
            _users.Remove(u);
        }
        Toast.Show($"Deleted {count} selected records.", variant: SemanticVariant.Danger);
        StateHasChanged();
    }

