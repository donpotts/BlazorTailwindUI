                                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200">Vector QR & Code 128 Barcodes</span>
                                </div>
                                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-xs">
