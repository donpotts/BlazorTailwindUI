@using BlazorTailwindUI.Models
@using BlazorTailwindUI.Services
@inject HttpClient Http
@* The Agent Ops console with a transport switch: the offline simulated agent, or a live AG-UI endpoint over server-sent events. *@
<div class="space-y-4" data-testid="agentops-workspace">
    <section aria-label="Agent connection" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <fieldset class="flex flex-wrap items-end gap-4">
            <legend class="text-sm font-black text-slate-900 dark:text-white mb-2">Agent connection</legend>
            <TwRadioGroup TValue="string" Horizontal="true" Value="@_mode" ValueChanged="SetModeAsync"
                          Items="Modes" />
            @if (_mode == "live")
            {
                <div class="flex-1 min-w-[16rem]">
                    <label for="agui-url" class="text-xs font-semibold text-slate-800 dark:text-slate-200">AG-UI run endpoint (POST, answers text/event-stream)</label>
                    <div class="flex gap-2 mt-1">
                        <input id="agui-url" @bind="_url" @bind:event="oninput" data-testid="agui-url"
                               class="flex-1 min-h-[40px] rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-3 text-sm text-slate-900 dark:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" />
                        <button type="button" @onclick="ConnectAsync" data-testid="agui-connect"
                                class="min-h-[40px] px-4 rounded-xl bg-brand-700 text-white text-sm font-bold hover:bg-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500">Connect</button>
                    </div>
                    <p class="text-xs text-slate-700 dark:text-slate-300 mt-1">Approval decisions are posted to <code>@DecisionUrl</code>, so the server waits for you at every gated tool call.</p>
                </div>
            }
        </fieldset>
    </section>

    @* @key rebuilds the console (and its session) when the transport changes. *@
    <TwAgentConsole @key="_generation" Transport="_transport" TransportLabel="@_label" ShowThreads="true" />
</div>

@code {
    private static readonly IReadOnlyList<TwRadioGroup<string>.Option> Modes = new[]
    {
        new TwRadioGroup<string>.Option("sim", "Simulated agent", "Offline demo, no server needed"),
        new TwRadioGroup<string>.Option("live", "Live AG-UI endpoint", "Your agent over server-sent events")
    };

    private string _mode = "sim";
    private string _url = "http://127.0.0.1:5300/agui/run";
    private IAgentTransport? _transport;
    private string _label = "Simulated agent (offline)";
    private int _generation;

    private string DecisionUrl => _url.EndsWith("/run", StringComparison.OrdinalIgnoreCase) ? _url[..^4] + "/decision" : _url.TrimEnd('/') + "/decision";

    private Task SetModeAsync(string mode)
    {
        _mode = mode;
        if (mode == "sim")
        {
            _transport = null;
            _label = "Simulated agent (offline)";
            _generation++;
        }
        return Task.CompletedTask;
    }

    private void ConnectAsync()
    {
        _transport = new SseAgentTransport(Http, new SseAgentTransportOptions { RunUrl = _url, DecisionUrl = DecisionUrl });
        _label = "Live AG-UI agent at " + _url;
        _generation++;
    }
}
