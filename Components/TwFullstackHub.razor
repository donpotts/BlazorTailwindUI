                    </p>
                </div>

                <!-- State Switcher Controls -->
                <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-xl bg-slate-200/60 dark:bg-slate-800 text-xs font-semibold">
                    <button type="button" @onclick="() => SetUnionState(1)" class="px-2.5 py-1 rounded-lg transition @(_demoUnionKind == 1 ? "bg-white dark:bg-slate-900 text-purple-600 dark:text-purple-400 shadow-xs font-bold" : "text-slate-600 dark:text-slate-400")">
                        1. Loading
                    </button>
                    <button type="button" @onclick="() => SetUnionState(2)" class="px-2.5 py-1 rounded-lg transition @(_demoUnionKind == 2 ? "bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-400 shadow-xs font-bold" : "text-slate-600 dark:text-slate-400")">
