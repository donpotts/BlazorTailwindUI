            </TwUnionBoundary>
        </div>

        <!-- 6B. Blazor Donut Caching & ShortCircuit -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-4">
            <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>🍩</span> Pillar 13: Blazor Donut Caching &amp; <code class="text-purple-600 dark:text-purple-400 text-xs">[ShortCircuit]</code> Edge Endpoints (<code class="text-purple-600 dark:text-purple-400 text-xs">TwDonutCache</code>)
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Edge-caches 95%+ of static SSR page markup while dynamically carving out personalized holes per request with sub-millisecond bypass endpoints.
                </p>
            </div>

            <!-- Live TwDonutCache Instance -->
            <TwDonutCache CacheKey="enterprise_catalog_shell_v1" Tags="@(["catalog", "pricing"])">
                <StaticContent>
                    <div class="p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2">
                            <span class="text-lg">🏢</span>
                            <div>
                                <div class="font-bold text-slate-900 dark:text-white">Enterprise Catalog &amp; Navigation Shell</div>
                                <div class="text-[11px] text-slate-500">Edge-Cached HTML Segment (Shared across 10,000+ simultaneous users)</div>
                            </div>
                        </div>
                        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                            Zero Server CPU
                        </span>
                    </div>
                </StaticContent>
                <DynamicHole>
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-slate-700 dark:text-slate-200">
                                Live Personalized User Cart: <strong class="font-mono text-brand-600 dark:text-brand-400">4 Items ($1,420.00 ARR)</strong>
                            </span>
                        </div>
                        <span class="text-[10px] font-mono text-slate-400">
                            Rendered at @DateTime.UtcNow.ToString("HH:mm:ss.fff") UTC
                        </span>
                    </div>
                </DynamicHole>
            </TwDonutCache>
        </div>

        <!-- 6C. Native Zstandard Ultra-Fast Compression -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <span>🗜️</span> Pillar 14: Native Zstandard Compression Pipeline (<code class="text-purple-600 dark:text-purple-400 text-xs">TwZstandardService</code>)
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Native .NET 11 <code class="font-mono">ZstandardStream</code> yielding 2–7x faster compression and drastically faster decompression than GZip.
                    </p>
                </div>

                <button type="button"
                        @onclick="RunZstandardBenchmarkAsync"
                        disabled="@_isCompressingZstd"
                        class="px-4 py-2 text-xs font-bold rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition flex items-center gap-1.5 disabled:opacity-50">
                    @if (_isCompressingZstd)
                    {
                        <span class="w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin"></span>
                        <span>Compressing SIMD...</span>
                    }
                    else
                    {
                        <span>⚡ Run Zstandard Benchmark</span>
                    }
                </button>
            </div>

            @if (_zstdResult != null)
            {
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                    <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                        <span class="text-slate-400 font-semibold block text-[10px] uppercase">Original JSON</span>
                        <div class="text-base font-mono font-bold text-slate-900 dark:text-white">@(_zstdResult.OriginalSizeBytes.ToString("N0")) B</div>
                        <span class="text-[10px] text-slate-500">Uncompressed Payload</span>
                    </div>
                    <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                        <span class="text-slate-400 font-semibold block text-[10px] uppercase">Zstandard Size</span>
                        <div class="text-base font-mono font-bold text-indigo-600 dark:text-indigo-400">@(_zstdResult.CompressedSizeBytes.ToString("N0")) B</div>
                        <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400">@(_zstdResult.SavingsPercentage.ToString("F1"))% Saved</span>
                    </div>
                    <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                        <span class="text-slate-400 font-semibold block text-[10px] uppercase">Compress Duration</span>
                        <div class="text-base font-mono font-bold text-emerald-600 dark:text-emerald-400">@(_zstdResult.CompressionDurationMs.ToString("F2")) ms</div>
                        <span class="text-[10px] text-slate-500">Native SIMD Stream</span>
                    </div>
                    <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                        <span class="text-slate-400 font-semibold block text-[10px] uppercase">Throughput Speed</span>
                        <div class="text-base font-mono font-bold text-purple-600 dark:text-purple-400">@(_zstdResult.SpeedMBps.ToString("F0")) MB/s</div>
                        <span class="text-[10px] text-slate-500">7x Faster Than GZip</span>
                    </div>
                </div>
            }
        </div>

        <!-- 6D. Post-Quantum Cryptography Enclave (ML-KEM-768) -->
        <TwPostQuantumVault />

        <!-- 6E. Native OpenTelemetry Performance Cockpit -->
        <TwTelemetryDashboard />

        <!-- 6F. Hardware Acceleration & SIMD Vector Engine (Pillar 18) -->
        <TwVectorMath />

        <!-- 6G. .NET Aspire 11 Live App Host Cockpit (Pillar 17) -->
        <TwAspireHub />
    </div>
</div>

@code {
    private RenderModeKind _selectedMode = RenderModeKind.InteractiveAuto;
    private readonly RenderModeKind[] _allModes = new[]
    {
        RenderModeKind.InteractiveAuto,
        RenderModeKind.InteractiveWebAssembly,
        RenderModeKind.InteractiveServer,
        RenderModeKind.StreamingSsr,
        RenderModeKind.StaticSsr
    };

    private string _activeCodeTab = "program";

    private bool _isSimulatingDoubleFetch = false;
    private bool _isSimulatingHydration = false;
    private bool _demoViewLoading = false;
    private bool _demoViewRestored = true;

    private async Task SimulateDoubleFetch()
    {
        _isSimulatingDoubleFetch = true;
        _demoViewLoading = true;
        _demoViewRestored = false;

        // Server Prerender query (240ms)
        await Task.Delay(240);
        // Client Hydration duplicate DB query (240ms)
        await Task.Delay(240);

        _demoViewLoading = false;
        _isSimulatingDoubleFetch = false;
        Toast.Show("Double-Fetch Penalty Simulated", "Executed 2 separate database roundtrips (480ms). Visual flicker occurred.", SemanticVariant.Warning);
    }

    private async Task SimulateZeroFlickerHydration()
    {
        _isSimulatingHydration = true;
        _demoViewLoading = true;

        // Load via TwHydrationService with persistent cache hit
        var result = await Hydration.GetOrLoadAsync("demo-q4-plan", async () =>
        {
            await Task.Delay(10);
            return "Active ARR $42.5M";
        });

        _demoViewLoading = false;
        _demoViewRestored = result.WasRestoredFromPrerender;
        _isSimulatingHydration = false;
        Toast.Show("Zero-Flicker Hydration Hit!", "State restored from SSR cache in 0ms. Zero redundant database queries.", SemanticVariant.Success);
    }

    private void ResetHydrationBench()
    {
        Hydration.Reset();
        _demoViewRestored = false;
        _demoViewLoading = false;
        Toast.Show("Hydration Bench Reset", "Simulated cache cleared.", SemanticVariant.Default);
    }

    private int _demoUnionKind = 2; // 1: Loading, 2: Success, 3: Empty, 4: Failure
    private UiState<string> _demoUnionState = new UiState<string>.Success("Enterprise Asset Portfolio #9021-Active");
    private ZstandardBenchmarkResult? _zstdResult;
    private bool _isCompressingZstd = false;

    protected override async Task OnInitializedAsync()
    {
        await RunZstandardBenchmarkAsync();
    }

    private void SetUnionState(int kind)
    {
        _demoUnionKind = kind;
        _demoUnionState = kind switch
        {
            1 => new UiState<string>.Loading(),
            2 => new UiState<string>.Success("Enterprise Asset Portfolio #9021-Active"),
            3 => new UiState<string>.Empty(),
            4 => new UiState<string>.Failure("Simulated database connection timeout (BL0015)"),
            _ => new UiState<string>.Success("Default State")
        };
    }

    private async Task RunZstandardBenchmarkAsync()
    {
        _isCompressingZstd = true;
        try
        {
            var samplePayload = System.Text.Json.JsonSerializer.Serialize(new
            {
                BatchId = Guid.NewGuid(),
                Timestamp = DateTime.UtcNow,
                Records = Enumerable.Range(1, 200).Select(i => new
                {
                    Id = i,
                    Account = $"ACC-{1000 + i}",
                    Routing = "⑆021000021⑆",
                    Balance = 1500.50 + i * 25.10,
                    Verified = true,
                    Tags = new[] { "Checking", "Active", "Tier-1" }
                })
            });

            _zstdResult = await ZstdService.BenchmarkPayloadAsync("EnterpriseLedgerBatch200.json", samplePayload);
        }
        finally
        {
            _isCompressingZstd = false;
        }
    }

    private string GetModeDisplayName(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "Interactive Auto 🚀",
        RenderModeKind.InteractiveWebAssembly => "WebAssembly (WASM)",
        RenderModeKind.InteractiveServer => "Interactive Server",
        RenderModeKind.StreamingSsr => "Streaming SSR",
        RenderModeKind.StaticSsr => "Static SSR",
        _ => mode.ToString()
    };

    private string GetModeIcon(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "⚡",
        RenderModeKind.InteractiveWebAssembly => "💻",
        RenderModeKind.InteractiveServer => "🔌",
        RenderModeKind.StreamingSsr => "🌊",
        RenderModeKind.StaticSsr => "📄",
        _ => "🌐"
    };

    private string GetModeHeading(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "Interactive Auto (.NET 11 Flagship Mode)",
        RenderModeKind.InteractiveWebAssembly => "Interactive WebAssembly (Client-Side SIMD)",
        RenderModeKind.InteractiveServer => "Interactive Server (SignalR Stateful WebSocket)",
        RenderModeKind.StreamingSsr => "Streaming Server-Side Rendering (Chunked HTML)",
        RenderModeKind.StaticSsr => "Static Server-Side Rendering (Zero JS Required)",
        _ => mode.ToString()
    };

    private string GetModeDirective(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "@rendermode InteractiveAuto",
        RenderModeKind.InteractiveWebAssembly => "@rendermode InteractiveWebAssembly",
        RenderModeKind.InteractiveServer => "@rendermode InteractiveServer",
        RenderModeKind.StreamingSsr => "@attribute [StreamRendering]",
        RenderModeKind.StaticSsr => "None (Default Static Page)",
        _ => ""
    };

    private string GetModeRecommendation(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "Recommended for Modern Enterprise Apps",
        RenderModeKind.InteractiveWebAssembly => "Best for Offline PWAs & Zero Server Load",
        RenderModeKind.InteractiveServer => "Best for Intranets with Fast Low-Latency Network",
        RenderModeKind.StreamingSsr => "Best for Async Data-Heavy Dashboards with Fast FCP",
        RenderModeKind.StaticSsr => "Best for Public Marketing, Documentation & Blogs",
        _ => ""
    };

    private string GetModeBadgeClass(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800",
        RenderModeKind.InteractiveWebAssembly => "bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800",
        RenderModeKind.InteractiveServer => "bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800",
        RenderModeKind.StreamingSsr => "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
        RenderModeKind.StaticSsr => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700",
        _ => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
    };

    private string GetModeDescription(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "Initializes with ultra-fast server prerendering (SSR). The browser immediately opens a lightweight SignalR connection for instantaneous interactivity while the WebAssembly .NET runtime downloads in the background. On subsequent navigations, the app transitions seamlessly to pure client-side WebAssembly execution with zero server CPU overhead.",
        RenderModeKind.InteractiveWebAssembly => "Executes modern C# directly inside the browser using WebAssembly and SIMD vector instructions. Ideal for high-density client charting, local OCR parsing, and offline-first PWAs. Server memory footprint per user is strictly 0 KB.",
        RenderModeKind.InteractiveServer => "Renders UI on the ASP.NET Core server and streams DOM diffs over a persistent SignalR WebSocket. Extremely lightweight on client devices, but requires persistent server affinity and active network connectivity.",
        RenderModeKind.StreamingSsr => "Flushes the initial HTML layout shell to the browser immediately, then streams asynchronous data chunks as backend queries complete. Eliminates blank screens during long database aggregations without needing WebSocket connections.",
        RenderModeKind.StaticSsr => "Renders pure standard HTML5 directly on the server without any JavaScript runtime needed. Interactivity is handled via progressive enhancement (Enhanced Navigation and Form POST actions). Optimal for SEO, blogs, and public portals.",
        _ => ""
    };

    private string GetModeFirstPaint(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "< 25ms (SSR Prerendered)",
        RenderModeKind.InteractiveWebAssembly => "~150ms - 350ms (Initial WASM Load)",
        RenderModeKind.InteractiveServer => "< 30ms (SSR Prerendered)",
        RenderModeKind.StreamingSsr => "< 15ms (Immediate Shell Flush)",
        RenderModeKind.StaticSsr => "< 10ms (Instant Pure HTML)",
        _ => "Fast"
    };

    private string GetModeServerMemory(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "0 KB (Post WASM Hydration)",
        RenderModeKind.InteractiveWebAssembly => "Strictly 0 KB / user",
        RenderModeKind.InteractiveServer => "~150 KB - 500 KB / user circuit",
        RenderModeKind.StreamingSsr => "Transient only (~0 KB / user)",
        RenderModeKind.StaticSsr => "Transient only (~0 KB / user)",
        _ => "Minimal"
    };

    private string GetModeOfflineCapability(RenderModeKind mode) => mode switch
    {
        RenderModeKind.InteractiveAuto => "Full Offline PWA (Post Hydration)",
        RenderModeKind.InteractiveWebAssembly => "Full Offline PWA (Service Worker)",
        RenderModeKind.InteractiveServer => "No (Requires Active WebSocket)",
        RenderModeKind.StreamingSsr => "Cached Pages Only",
        RenderModeKind.StaticSsr => "Cached Pages Only",
        _ => "N/A"
    };
