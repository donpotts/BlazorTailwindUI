                    </button>
                    <button type="button" @onclick="() => SetUnionState(3)" class="px-2.5 py-1 rounded-lg transition @(_demoUnionKind == 3 ? "bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-400 shadow-xs font-bold" : "text-slate-600 dark:text-slate-400")">
