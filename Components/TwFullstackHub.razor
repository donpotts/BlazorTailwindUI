@namespace BlazorTailwindUI.Components
@using BlazorTailwindUI.Models
@using BlazorTailwindUI.Services
@inject TwHydrationService Hydration
@inject ToastService Toast
@inject TwZstandardService ZstdService
@inject TwDonutCacheService DonutService
@inject TwOpenTelemetryService OtelService

<div class="space-y-8 animate-fade-in">
    <!-- Hero Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950 border border-indigo-500/30 p-6 sm:p-8 text-white shadow-xl shadow-indigo-950/20">
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-12 -bottom-12 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-4 max-w-4xl">
            <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wide uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-500/40">
                    .NET 11 Full-Stack Ready 🚀
                </span>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wide uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
                    Zero-Flicker Hydration
                </span>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wide uppercase bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">
                    IAsyncEnumerable Streaming
                </span>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wide uppercase bg-amber-500/20 text-amber-300 border border-amber-500/40">
                    Nov 10 GA Launch
                </span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
                Modern <span class="bg-gradient-to-r from-indigo-400 via-cyan-300 to-emerald-400 bg-clip-text text-transparent">Full-Stack Blazor</span> Architecture
            </h1>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
                Seamlessly unify <strong>Static Server Rendering (SSR)</strong>, <strong>Streaming SSR</strong>, <strong>Interactive Server</strong>, and <strong>Interactive WebAssembly</strong> into a single cohesive application. Eliminate the notorious double-fetch flicker with built-in hydration caches, stream high-throughput telemetry with native <code class="text-cyan-300 bg-slate-800/80 px-1.5 py-0.5 rounded">IAsyncEnumerable&lt;T&gt;</code>, and scaffold fullstack enterprise apps in seconds.
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
                <a href="#hydration-bench" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold transition flex items-center gap-2 shadow-md shadow-indigo-600/30">
                    <span>⚡ Zero-Flicker Hydration Bench</span>
                </a>
                <a href="#streaming-grid" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold transition flex items-center gap-2">
                    <span>🌊 Live Streaming Grid</span>
                </a>
                <a href="#fullstack-form" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold transition flex items-center gap-2">
                    <span>📋 Dual-Mode Form Engine</span>
                </a>
                <a href="#fullstack-coaching" class="px-4 py-2 rounded-xl bg-emerald-950/60 hover:bg-emerald-900/60 text-emerald-300 border border-emerald-800/60 font-semibold transition flex items-center gap-2">
                    <span>🎓 Fullstack Coaching & CLI</span>
                </a>
                <a href="#nextgen-net11" class="px-4 py-2 rounded-xl bg-purple-950/60 hover:bg-purple-900/60 text-purple-300 border border-purple-800/60 font-semibold transition flex items-center gap-2 shadow-md shadow-purple-950/30">
                    <span>🚀 .NET 11 & C# 15 Architecture Lab</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 1. Interactive Render Mode Architecture Explorer -->
    <div class="p-6 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>🧭</span>
                    <span>.NET 11 Unified Render Mode Matrix</span>
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Explore how Blazor Tailwind UI components operate across all five modern rendering paradigms.
                </p>
            </div>
            
            <div class="flex flex-wrap gap-1.5 p-1 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-semibold">
                @foreach (var mode in _allModes)
                {
                    <button type="button" 
                            @onclick="() => _selectedMode = mode"
                            class="px-3 py-1 rounded-lg transition @(_selectedMode == mode ? "bg-white dark:bg-slate-900 text-brand-600 dark:text-brand-400 shadow-xs font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
                        @GetModeDisplayName(mode)
                    </button>
                }
            </div>
        </div>

        <!-- Selected Render Mode Deep Dive Card -->
        <div class="p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/50 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">@GetModeIcon(_selectedMode)</span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">@GetModeHeading(_selectedMode)</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@GetModeDirective(_selectedMode)</p>
                    </div>
                </div>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider @GetModeBadgeClass(_selectedMode)">
                    @GetModeRecommendation(_selectedMode)
                </span>
            </div>

            <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
                @GetModeDescription(_selectedMode)
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
                <div class="p-3 rounded-xl bg-white dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60">
                    <span class="text-slate-400 font-semibold block text-[10px] uppercase">First Paint</span>
                    <span class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">@GetModeFirstPaint(_selectedMode)</span>
                </div>
                <div class="p-3 rounded-xl bg-white dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60">
                    <span class="text-slate-400 font-semibold block text-[10px] uppercase">Server Memory / User</span>
                    <span class="font-bold text-slate-800 dark:text-slate-200 text-sm">@GetModeServerMemory(_selectedMode)</span>
                </div>
                <div class="p-3 rounded-xl bg-white dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60">
                    <span class="text-slate-400 font-semibold block text-[10px] uppercase">Offline PWA</span>
                    <span class="font-bold text-slate-800 dark:text-slate-200 text-sm">@GetModeOfflineCapability(_selectedMode)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Zero-Flicker Hydration Live Workbench -->
    <div id="hydration-bench" class="p-6 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>⚡</span>
                    <span>Zero-Flicker SSR Hydration Live Workbench</span>
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Watch in real-time how <code class="text-brand-600 dark:text-brand-400 font-bold">TwHydrationService</code> preserves server prerender state and prevents the Blazor double-fetch penalty.
                </p>
            </div>

            <!-- Live Telemetry Counters -->
            <div class="flex items-center gap-3 text-xs font-mono">
                <div class="px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 flex items-center gap-1.5">
                    <span>Saved:</span>
                    <span class="font-bold">@Hydration.Telemetry.MillisecondsSaved.ToString("F0") ms</span>
                </div>
                <div class="px-3 py-1.5 rounded-xl bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-300 flex items-center gap-1.5">
                    <span>Hydrated:</span>
                    <span class="font-bold">@Hydration.Telemetry.ClientRestoredCount hits</span>
                </div>
                <button type="button" @onclick="ResetHydrationBench" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs hover:text-slate-900">
                    Reset
                </button>
            </div>
        </div>

        <!-- Simulation Grid: Cold Fetch vs Zero-Flicker Hydrated -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Left: Standard Double Fetch (The Problem) -->
            <div class="p-5 rounded-2xl border border-rose-200 dark:border-rose-900/40 bg-rose-50/20 dark:bg-rose-950/10 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-rose-700 dark:text-rose-400 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                        Standard Blazor (Double-Fetch Flicker)
                    </span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-rose-100 dark:bg-rose-900/40 text-rose-800 dark:text-rose-300">
                        2x Database Queries
                    </span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    Without state persistence, components query the database once on the server during SSR, and then run <code class="text-rose-500">OnInitializedAsync</code> again on the client, wiping out early clicks and causing screen flicker.
                </p>

                <div class="p-4 rounded-xl border border-rose-200/80 dark:border-rose-800/40 bg-white dark:bg-slate-900 space-y-2">
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-500">Server Prerender:</span>
                        <span class="font-mono font-bold text-slate-800 dark:text-slate-200">240ms (Executed)</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-500">Client Hydration:</span>
                        <span class="font-mono font-bold text-rose-600 dark:text-rose-400">240ms (Duplicate DB Query!)</span>
                    </div>
                    <div class="flex justify-between text-xs pt-1 border-t border-slate-100 dark:border-slate-800">
                        <span class="font-semibold text-slate-700 dark:text-slate-300">Total Latency:</span>
                        <span class="font-mono font-bold text-rose-600 dark:text-rose-400">480ms + UI Flicker</span>
                    </div>
                </div>

                <button type="button" @onclick="SimulateDoubleFetch" disabled="@_isSimulatingDoubleFetch" class="w-full py-2 rounded-xl border border-rose-300 dark:border-rose-800 bg-rose-100/60 dark:bg-rose-900/30 text-rose-800 dark:text-rose-300 text-xs font-bold hover:bg-rose-200 dark:hover:bg-rose-900/50 transition flex items-center justify-center gap-2">
                    @if (_isSimulatingDoubleFetch)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        <span>Simulating Double-Fetch (480ms)...</span>
                    }
                    else
                    {
                        <span>Trigger Standard Double-Fetch</span>
                    }
                </button>
            </div>

            <!-- Right: TwHydrationService (The Solution) -->
            <div class="p-5 rounded-2xl border border-emerald-200 dark:border-emerald-900/40 bg-emerald-50/20 dark:bg-emerald-950/10 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        Blazor Tailwind UI (Zero-Flicker Hydration)
                    </span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300">
                        1x Database Query (0ms Client Hit)
                    </span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    <code class="text-emerald-600 dark:text-emerald-400 font-bold">TwHydrationService</code> serializes the initial SSR state into a cryptographically verified payload. The client immediately restores state with zero duplicate queries.
                </p>

                <div class="p-4 rounded-xl border border-emerald-200/80 dark:border-emerald-800/40 bg-white dark:bg-slate-900 space-y-2">
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-500">Server Prerender:</span>
                        <span class="font-mono font-bold text-slate-800 dark:text-slate-200">240ms (Executed)</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-500">Client Hydration:</span>
                        <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">0ms (Restored from Cache!)</span>
                    </div>
                    <div class="flex justify-between text-xs pt-1 border-t border-slate-100 dark:border-slate-800">
                        <span class="font-semibold text-slate-700 dark:text-slate-300">Total Latency:</span>
                        <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">240ms (Zero Screen Blink)</span>
                    </div>
                </div>

                <button type="button" @onclick="SimulateZeroFlickerHydration" disabled="@_isSimulatingHydration" class="w-full py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-md shadow-emerald-600/20 transition flex items-center justify-center gap-2">
                    @if (_isSimulatingHydration)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        <span>Simulating Zero-Flicker Restore...</span>
                    }
                    else
                    {
                        <span>Trigger Zero-Flicker Hydration</span>
                    }
                </button>
            </div>
        </div>

        <!-- Live Hydrated Component Container Demo -->
        <TwHydratedView IsRestored="@_demoViewRestored" IsLoading="@_demoViewLoading">
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold text-sm">
                        OKRs
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 dark:text-white">Q4 Enterprise Financial Milestone</h4>
                        <p class="text-xs text-slate-500">Restored State: $42,500,000 ARR • 99.98% Service SLA</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-bold border border-emerald-200 dark:border-emerald-800">
                        @(_demoViewRestored ? "Hydrated with 0ms Delay" : "Initial Cold Fetch Render")
                    </span>
                </div>
            </div>
        </TwHydratedView>
    </div>

    <!-- 3. High-Throughput Streaming Engine (IAsyncEnumerable) -->
    <div id="streaming-grid" class="space-y-4">
        <TwStreamingGrid />
    </div>

    <!-- 4. Universal Fullstack Form Engine -->
    <div id="fullstack-form" class="space-y-4">
        <TwFullstackForm />
    </div>

    <!-- 5. Fullstack Coaching & CLI Quickstart -->
    <div id="fullstack-coaching" class="p-6 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-6">
        <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span>🎓</span>
                <span>Fullstack Developer Masterclass & CLI Scaffolding</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                How to set up enterprise .NET 11 Fullstack projects in under 60 seconds.
            </p>
        </div>

        <!-- 1-Click CLI Scaffolding Section -->
        <div class="p-5 rounded-2xl bg-slate-950 text-white font-mono text-xs space-y-3 border border-slate-800">
            <div class="flex items-center justify-between text-slate-400 pb-2 border-b border-slate-800 text-[11px]">
                <span>1-CLICK ENTERPRISE TEMPLATE CLI</span>
                <span class="text-emerald-400">.NET 11 CLI Ready</span>
            </div>
            <div class="space-y-1 text-slate-300">
                <p><span class="text-purple-400"># 1. Install template from GitHub repository</span></p>
                <p class="text-emerald-300 font-bold">dotnet new install https://github.com/donpotts/BlazorTailwindUI.git</p>
                <p class="pt-2"><span class="text-purple-400"># 2. Scaffold enterprise solution with Interactive Auto & Tailwind</span></p>
                <p class="text-cyan-300 font-bold">dotnet new blazortw -n AcmeCorp.Portal --render-mode auto</p>
                <p class="pt-2"><span class="text-purple-400"># 3. Run fullstack development server</span></p>
                <p class="text-amber-300 font-bold">cd AcmeCorp.Portal && dotnet run</p>
            </div>
        </div>

        <!-- Code Snippet Tabs -->
        <div class="space-y-3">
            <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold">
                <button type="button" @onclick='() => _activeCodeTab = "program"' class="pb-2 border-b-2 px-1 transition @(_activeCodeTab == "program" ? "border-brand-600 text-brand-600 dark:text-brand-400" : "border-transparent text-slate-500 hover:text-slate-800")">Program.cs Setup</button>
                <button type="button" @onclick='() => _activeCodeTab = "app"' class="pb-2 border-b-2 px-1 transition @(_activeCodeTab == "app" ? "border-brand-600 text-brand-600 dark:text-brand-400" : "border-transparent text-slate-500 hover:text-slate-800")">App.razor Routing</button>
                <button type="button" @onclick='() => _activeCodeTab = "hydration"' class="pb-2 border-b-2 px-1 transition @(_activeCodeTab == "hydration" ? "border-brand-600 text-brand-600 dark:text-brand-400" : "border-transparent text-slate-500 hover:text-slate-800")">Zero-Flicker Hydration</button>
                <button type="button" @onclick='() => _activeCodeTab = "streaming"' class="pb-2 border-b-2 px-1 transition @(_activeCodeTab == "streaming" ? "border-brand-600 text-brand-600 dark:text-brand-400" : "border-transparent text-slate-500 hover:text-slate-800")">IAsyncEnumerable API</button>
            </div>

            <div class="p-4 rounded-xl bg-slate-900 text-slate-200 font-mono text-xs overflow-x-auto">
                @if (_activeCodeTab == "program")
                {
<pre><code>// Program.cs (.NET 11 Full-Stack Blazor Web App)
var builder = WebApplication.CreateBuilder(args);

// Register Blazor services with Interactive WebAssembly & Server
builder.Services.AddRazorComponents()
    .AddInteractiveServerComponents()
    .AddInteractiveWebAssemblyComponents();

// 1-Line Registration of Blazor Tailwind UI Fullstack Suite
builder.Services.AddBlazorTailwindUI();

var app = builder.Build();

app.UseAntiforgery();
app.MapStaticAssets();

app.MapRazorComponents&lt;App&gt;()
    .AddInteractiveServerRenderMode()
    .AddInteractiveWebAssemblyRenderMode()
    .AddAdditionalAssemblies(typeof(BlazorTailwindUI.Components.TwStreamingGrid).Assembly);

app.Run();</code></pre>
                }
                else if (_activeCodeTab == "app")
                {
<pre><code>&lt;!-- App.razor (.NET 11 Unified Routes) --&gt;
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
    &lt;meta charset="utf-8" /&gt;
    &lt;meta name="viewport" content="width=device-width, initial-scale=1.0" /&gt;
    &lt;base href="/" /&gt;
    &lt;link rel="stylesheet" href="css/app.min.css" /&gt;
    &lt;HeadOutlet @@rendermode="InteractiveAuto" /&gt;
&lt;/head&gt;
&lt;body class="bg-slate-50 dark:bg-slate-950 font-sans"&gt;
    &lt;Routes @@rendermode="InteractiveAuto" /&gt;
    &lt;script src="_framework/blazor.web.js"&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
                }
                else if (_activeCodeTab == "hydration")
                {
<pre><code>@@inject TwHydrationService Hydration

&lt;TwHydratedView IsRestored="@@_isRestored" IsLoading="@@_loading"&gt;
    &lt;TwCompanyPlanForm Model="@@_plan" /&gt;
&lt;/TwHydratedView&gt;

@@code {
    private CompanyPlanModel? _plan;
    private bool _isRestored;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // 1-Line Zero-Flicker Hydration: executes on server during SSR,
        // then restores instantly in 0ms on client hydration!
        var state = await Hydration.GetOrLoadAsync("q4-plan", async () =&gt; 
        {
            return await DbContext.CompanyPlans.FindAsync(1);
        });

        _plan = state.Value;
        _isRestored = state.WasRestoredFromPrerender;
        _loading = false;
    }
}</code></pre>
                }
                else if (_activeCodeTab == "streaming")
                {
<pre><code>// Backend ASP.NET Core Minimal API (IAsyncEnumerable Streaming Endpoint)
app.MapGet("/api/telemetry/stream", async IAsyncEnumerable&lt;StreamingTelemetryItem&gt; (
    [EnumeratorCancellation] CancellationToken ct) =&gt;
{
    var random = new Random();
    while (!ct.IsCancellationRequested)
    {
        await Task.Delay(50, ct); // 20 items per second
        yield return new StreamingTelemetryItem
        {
            Symbol = "MSFT",
            Price = 425.50 + random.NextDouble(),
            Timestamp = DateTime.UtcNow
        };
    }
});</code></pre>
                }
            </div>
        </div>
    </div>

    <!-- 6. .NET 11 & C# 15 Next-Gen Architecture Lab (Pillars 12–16) -->
    <div id="nextgen-net11" class="p-6 rounded-3xl border border-purple-200 dark:border-purple-900/60 bg-white dark:bg-slate-900 shadow-sm space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-purple-100 dark:border-purple-900/40 pb-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
                        .NET 11 &amp; C# 15 Headline Lab
                    </span>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        MIT Free Tier
                    </span>
                </div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mt-1.5 flex items-center gap-2">
                    <span>🔬</span>
                    <span>Next-Gen Architectural Innovations</span>
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">
