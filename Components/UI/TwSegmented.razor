@namespace BlazorTailwindUI.Components.UI

<div class="inline-flex p-1 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 gap-1 @(FullWidth ? "w-full" : "") @Class"
     role="radiogroup">
    @foreach (var item in Items)
    {
        var isSelected = string.Equals(Value, item.Id, StringComparison.OrdinalIgnoreCase);
        <button type="button"
                @onclick="() => SelectItem(item.Id)"
                role="radio"
                aria-checked="@isSelected"
                class="flex items-center justify-center gap-2 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-500/50 
                       @(FullWidth ? "flex-1" : "")
                       @(isSelected 
                         ? "bg-white dark:bg-slate-900 text-brand-600 dark:text-brand-400 shadow-sm shadow-slate-900/5 font-bold" 
                         : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
            
            @if (!string.IsNullOrEmpty(item.IconSvg))
            {
                <span class="w-4 h-4 shrink-0 flex items-center justify-center">
                    @((MarkupString)item.IconSvg)
                </span>
            }

            <span class="truncate">@item.Text</span>

            @if (!string.IsNullOrEmpty(item.Badge))
            {
                <span class="text-[10px] px-1.5 py-0.2 rounded-full @(isSelected ? "bg-brand-50 dark:bg-brand-500/20 text-brand-600 dark:text-brand-300" : "bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300")">
                    @item.Badge
                </span>
            }
        </button>
    }
</div>

@code {
    public sealed record SegmentItem(string Id, string Text, string? IconSvg = null, string? Badge = null);

    [Parameter] public IReadOnlyList<SegmentItem> Items { get; set; } = Array.Empty<SegmentItem>();
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task SelectItem(string id)
    {
        if (Value != id)
        {
            Value = id;
            await ValueChanged.InvokeAsync(id);
        }
    }
}
