@using BlazorTailwindUI.Models

<div class="w-full space-y-8 @Class">
    <!-- Billing Cycle Toggle Header -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-center">
        <span class="text-sm font-semibold @(!_isAnnual ? "text-slate-900 dark:text-white" : "text-slate-500 dark:text-slate-400")">
            Monthly billing
        </span>
        <button type="button"
                @onclick="ToggleBilling"
                class="relative inline-flex h-7 w-14 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-slate-200 dark:bg-slate-700 transition-colors duration-200 ease-in-out focus:outline-hidden focus:ring-2 focus:ring-brand-500 @(_isAnnual ? "!bg-brand-600" : "")">
            <span class="pointer-events-none inline-block h-6 w-6 transform rounded-full bg-white shadow-md ring-0 transition duration-200 ease-in-out @(_isAnnual ? "translate-x-7" : "translate-x-0")"></span>
        </button>
        <div class="flex items-center gap-2">
            <span class="text-sm font-semibold @(_isAnnual ? "text-slate-900 dark:text-white" : "text-slate-500 dark:text-slate-400")">
                Annual billing
            </span>
            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-bold text-emerald-600 dark:text-emerald-400 ring-1 ring-emerald-500/20">
                Save 20%
            </span>
        </div>
    </div>

    <!-- Tier Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        @foreach (var tier in Tiers)
        {
            var price = _isAnnual ? tier.AnnualMonthlyPrice : tier.MonthlyPrice;
            <div class="relative flex flex-col justify-between rounded-3xl p-6 sm:p-8 transition-all duration-300 @(tier.IsPopular ? "bg-white dark:bg-slate-900 border-2 border-brand-500 shadow-2xl shadow-brand-500/15 ring-4 ring-brand-500/10 scale-100 md:-translate-y-2 z-10" : "bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-lg")">
                
                @if (tier.IsPopular)
                {
                    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                        <span class="inline-flex items-center gap-1 px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-brand-600 text-white shadow-md">
                            ★ Most Popular
                        </span>
                    </div>
                }

                <div class="space-y-6">
                    <div>
                        <h4 class="text-xl font-bold text-slate-900 dark:text-white">@tier.Name</h4>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">@tier.Description</p>
                    </div>

                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                            $@price
                        </span>
                        <span class="text-xs text-slate-400 font-medium">/month</span>
                    </div>

                    @if (_isAnnual && tier.AnnualMonthlyPrice > 0)
                    {
                        <p class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold -mt-3">
                            Billed annually ($@(price * 12)/yr)
                        </p>
                    }

                    <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Features included:</p>
                        <ul class="space-y-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
                            @foreach (var feature in tier.Features)
                            {
                                <li class="flex items-start gap-2.5">
                                    @if (feature.Included)
                                    {
                                        <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    }
                                    <span class="@(!feature.Included ? "text-slate-400 dark:text-slate-500 line-through" : "")">
                                        @feature.Name
                                        @if (!string.IsNullOrWhiteSpace(feature.Note))
                                        {
                                            <span class="text-xs text-slate-400 block sm:inline"> (@feature.Note)</span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="mt-8 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <TwButton Variant="@(tier.IsPopular ? ButtonVariant.Primary : ButtonVariant.Outline)"
                              ResponsiveFullWidth="true"
                              OnClick="() => HandleSelectTier(tier)">
                        @tier.CtaText
                    </TwButton>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<PricingTier> Tiers { get; set; } = new();
    [Parameter] public EventCallback<PricingTier> OnSelectTier { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _isAnnual = true;

    private void ToggleBilling()
    {
        _isAnnual = !_isAnnual;
    }

    private async Task HandleSelectTier(PricingTier tier)
    {
        await OnSelectTier.InvokeAsync(tier);
    }
}
