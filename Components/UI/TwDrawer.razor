@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-hidden" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs transition-opacity"
             @onclick="HandleBackdropClick"></div>

        <div class="fixed inset-0 overflow-hidden">
            <div class="pointer-events-none fixed inset-y-0 @PlacementWrapperClass max-w-full flex">
                <div class="pointer-events-auto w-screen @WidthClass bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 shadow-2xl flex flex-col justify-between overflow-y-auto @PlacementBorderClass">
                    <div>
                        <!-- Drawer Header -->
                        <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <div>
                                @if (!string.IsNullOrWhiteSpace(Title))
                                {
                                    <h3 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white">@Title</h3>
                                }
                                @if (!string.IsNullOrWhiteSpace(Subtitle))
                                {
                                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">@Subtitle</p>
                                }
                            </div>
                            <button type="button"
                                    @onclick="CloseAsync"
                                    class="p-2 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                        <!-- Content -->
                        <div class="p-4 sm:p-6">
                            @ChildContent
                        </div>
                    </div>

                    <!-- Footer -->
                    @if (FooterContent is not null)
                    {
                        <div class="p-4 sm:p-5 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/30 pb-safe">
                            @FooterContent
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public DrawerPlacement Placement { get; set; } = DrawerPlacement.Right;
    [Parameter] public string Width { get; set; } = "max-w-md";
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    private string PlacementWrapperClass => Placement switch
    {
        DrawerPlacement.Left => "left-0 pr-10",
        DrawerPlacement.Bottom => "bottom-0 inset-x-0 !h-auto max-h-[85vh]",
        _ => "right-0 pl-10"
    };

    private string PlacementBorderClass => Placement switch
    {
        DrawerPlacement.Left => "border-r",
        DrawerPlacement.Bottom => "border-t rounded-t-3xl",
        _ => "border-l"
    };

    private string WidthClass => Placement == DrawerPlacement.Bottom ? "w-full" : Width;

    private async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick)
        {
            await CloseAsync();
        }
    }
}
