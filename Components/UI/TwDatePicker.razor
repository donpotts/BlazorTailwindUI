@namespace BlazorTailwindUI.Components.UI
@using System.Globalization

<div class="relative w-full @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            @Label
            @if (Required)
            {
                <span class="text-rose-500 ml-0.5">*</span>
            }
        </label>
    }

    <!-- Input Trigger Field -->
    <div class="relative flex items-center">
        <button type="button"
                @onclick="TogglePicker"
                class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl border text-sm transition-all text-left focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white dark:bg-slate-900 @(_isOpen ? "border-brand-500 ring-2 ring-brand-500/20" : "border-slate-300 dark:border-slate-700 hover:border-slate-400 dark:hover:border-slate-600")">
            
            <div class="flex items-center gap-2.5 truncate">
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="@(Value.HasValue ? "text-slate-900 dark:text-white font-medium" : "text-slate-400")">
                    @(Value.HasValue ? Value.Value.ToString(DateFormat) : Placeholder)
                </span>
            </div>

            @if (Value.HasValue && AllowClear)
            {
                <span @onclick="ClearDate" 
                      @onclick:stopPropagation="true"
                      class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5 rounded transition"
                      title="Clear date">
                    ✕
                </span>
            }
            else
            {
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
            }
        </button>
    </div>

    <!-- Calendar Dropdown Popover -->
    @if (_isOpen)
    {
        <!-- Backdrop to close on click outside -->
        <div class="fixed inset-0 z-40 bg-black/10 dark:bg-black/30 backdrop-blur-none" @onclick="() => _isOpen = false"></div>

        <div class="absolute z-50 mt-2 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl w-72 sm:w-80 transition-all select-none left-0 right-auto">
            <!-- Header: Prev Month, Current Month/Year, Next Month -->
            <div class="flex items-center justify-between mb-3">
                <button type="button" 
                        @onclick="PrevMonth" 
                        class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 focus:outline-none">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                
                <span class="text-sm font-bold text-slate-900 dark:text-white">
                    @_viewDate.ToString("MMMM yyyy")
                </span>

                <button type="button" 
                        @onclick="NextMonth" 
                        class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 focus:outline-none">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>

            <!-- Day of Week Headers -->
            <div class="grid grid-cols-7 gap-1 text-center mb-1">
                @foreach (var day in new[] { "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa" })
                {
                    <span class="text-[11px] font-semibold text-slate-400 uppercase py-1">@day</span>
                }
            </div>

            <!-- Days Matrix -->
            <div class="grid grid-cols-7 gap-1 text-center">
                @foreach (var cell in GetCalendarDays())
                {
                    var isSelected = Value.HasValue && Value.Value.Date == cell.Date.Date;
                    var isToday = cell.Date.Date == DateTime.Today;

                    <button type="button"
                            @onclick="() => SelectDate(cell.Date)"
                            class="h-8 w-8 sm:h-9 sm:w-9 mx-auto flex items-center justify-center rounded-xl text-xs font-semibold transition-all focus:outline-none
                            @(isSelected ? "bg-brand-600 text-white shadow-md shadow-brand-500/30" : 
                              isToday ? "border border-brand-500 text-brand-600 dark:text-brand-400 font-bold" :
                              cell.IsCurrentMonth ? "text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800" :
                              "text-slate-300 dark:text-slate-700 hover:text-slate-400")">
                        @cell.Date.Day
                    </button>
                }
            </div>

            <!-- Quick Preset Action Shortcuts -->
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                <button type="button" @onclick="SelectToday" class="text-brand-600 dark:text-brand-400 font-semibold hover:underline">Today</button>
                <button type="button" @onclick="SelectTomorrow" class="text-slate-500 hover:text-slate-900 dark:hover:text-white transition">Tomorrow</button>
                <button type="button" @onclick="ClearDate" class="text-rose-500 hover:text-rose-600 transition">Clear</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select date...";
    [Parameter] public string DateFormat { get; set; } = "MMM dd, yyyy";
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _isOpen;
    private DateTime _viewDate = DateTime.Today;

    protected override void OnParametersSet()
    {
        if (Value.HasValue)
        {
            _viewDate = Value.Value;
        }
    }

    private void TogglePicker() => _isOpen = !_isOpen;

    private void PrevMonth() => _viewDate = _viewDate.AddMonths(-1);
    private void NextMonth() => _viewDate = _viewDate.AddMonths(1);

    private async Task SelectDate(DateTime date)
    {
        Value = date;
        _isOpen = false;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SelectToday()
    {
        await SelectDate(DateTime.Today);
    }

    private async Task SelectTomorrow()
    {
        await SelectDate(DateTime.Today.AddDays(1));
    }

    private async Task ClearDate()
    {
        Value = null;
        _isOpen = false;
        await ValueChanged.InvokeAsync(null);
    }

    private sealed record CalendarCell(DateTime Date, bool IsCurrentMonth);

    private List<CalendarCell> GetCalendarDays()
    {
        var cells = new List<CalendarCell>();
        var firstOfMonth = new DateTime(_viewDate.Year, _viewDate.Month, 1);
        int leadingDays = (int)firstOfMonth.DayOfWeek;

        var startDate = firstOfMonth.AddDays(-leadingDays);
        for (int i = 0; i < 42; i++)
        {
            var date = startDate.AddDays(i);
            cells.Add(new CalendarCell(date, date.Month == _viewDate.Month));
        }

        return cells;
    }
}
