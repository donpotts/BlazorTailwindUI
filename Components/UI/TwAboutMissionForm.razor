@namespace BlazorTailwindUI.Components.UI

<div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden max-w-5xl mx-auto @CustomClass">
    <!-- Hero / Mission Statement Banner -->
    <div class="p-8 sm:p-12 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-brand-500/10 blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 border border-brand-500/30 text-xs font-semibold">
                <span>🚀</span>
                <span>Our Core Enterprise Charter</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight">
                @MissionHeading
            </h1>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                @MissionStatement
            </p>
        </div>

        <!-- Key Metrics Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-8 border-t border-white/10 relative z-10">
            <div>
                <span class="text-2xl sm:text-3xl font-black text-white block">100+</span>
                <span class="text-xs text-slate-400">Pure Blazor WASM Components</span>
            </div>
            <div>
                <span class="text-2xl sm:text-3xl font-black text-emerald-400 block">.NET 10+</span>
                <span class="text-xs text-slate-400">Cutting-Edge WebAssembly RC</span>
            </div>
            <div>
                <span class="text-2xl sm:text-3xl font-black text-indigo-400 block">0 CDN</span>
                <span class="text-xs text-slate-400">Zero External Dependencies</span>
            </div>
            <div>
                <span class="text-2xl sm:text-3xl font-black text-amber-400 block">60 FPS</span>
                <span class="text-xs text-slate-400">Microsecond Render Target</span>
            </div>
        </div>
    </div>

    <!-- Core Values / Pillars -->
    <div class="p-6 sm:p-8 bg-slate-50/50 dark:bg-slate-950/40 border-b border-slate-200 dark:border-slate-800">
        <div class="text-center max-w-2xl mx-auto space-y-2 mb-8">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">Our Architectural Pillars</h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Engineering excellence crafted for mission-critical industrial applications.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 shadow-xs">
                <span class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold text-lg">
                    ⚡
                </span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Performance Without Compromise</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Zero unnecessary DOM re-renders, virtualized grids, inline SVG micro-sparklines, and pure ahead-of-time (AOT) compilation compatibility.
                </p>
            </div>

            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 shadow-xs">
                <span class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg">
                    🛡️
                </span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Zero-Trust & Air-Gapped Ready</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Designed for defense, banking, and healthcare environments where no external scripts or runtime CDNs are permitted past the perimeter.
                </p>
            </div>

            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 shadow-xs">
                <span class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">
                    🎨
                </span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Modern Tailwind CSS Parity</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Utility-first elegance with seamlessly integrated Dark Mode, semantic color palettes, and responsive design right out of the box.
                </p>
            </div>
        </div>
    </div>

    <!-- Leadership Team -->
    <div class="p-6 sm:p-8 space-y-6 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white">Architectural Leadership</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">The team driving the enterprise Blazor WebAssembly roadmap.</p>
            </div>
            <span class="text-xs font-mono text-slate-400">Global Core Team</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            @foreach (var member in _teamMembers)
            {
                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-850/60 border border-slate-200 dark:border-slate-800 flex items-center gap-3">
                    <img src="@member.Avatar" alt="@member.Name" class="w-12 h-12 rounded-xl object-cover" />
                    <div>
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white">@member.Name</h4>
                        <span class="text-[11px] font-semibold text-brand-600 dark:text-brand-400 block">@member.Role</span>
                        <span class="text-[10px] text-slate-400">@member.Focus</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Executive Inquiry & Contact Form -->
    <div class="p-6 sm:p-8 space-y-5 bg-white dark:bg-slate-900">
        <div class="space-y-1">
            <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white">Connect with Enterprise Leadership</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Submit an inquiry regarding custom enterprise SLA support, security reviews, or architecture audits.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Your Full Name *</label>
                <input type="text" @bind="_inquiry.Name" placeholder="e.g. Marcus Thorne"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
            </div>
            <div class="space-y-1">
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Corporate Email Address *</label>
                <input type="email" @bind="_inquiry.Email" placeholder="m.thorne@enterprise.com"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Inquiry Topic</label>
                <select @bind="_inquiry.Topic"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none">
                    <option value="Architecture Advisory">Enterprise Architecture & Sizing Advisory</option>
                    <option value="Security Audit">Air-Gapped / SOC-2 Compliance Audit Review</option>
                    <option value="Custom Components">Custom Component Development Request</option>
                    <option value="Tier-3 SLA">Tier-3 24/7 Mission-Critical SLA Contract</option>
                </select>
            </div>
            <div class="space-y-1">
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Estimated Production Seats</label>
                <select @bind="_inquiry.SeatCount"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none">
                    <option value="1-50">1 - 50 Developers / Operators</option>
                    <option value="51-250">51 - 250 Enterprise Users</option>
                    <option value="250-1000">250 - 1,000 Global Workstations</option>
                    <option value="1000+">1,000+ Fortune 500 Enterprise Scale</option>
                </select>
            </div>
        </div>

        <div class="space-y-1">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Project Details & Requirements</label>
            <textarea rows="3" @bind="_inquiry.Message" placeholder="Describe your architecture requirements, compliance targets, or timeline..."
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none resize-none"></textarea>
        </div>

        @if (!string.IsNullOrEmpty(_notificationMessage))
        {
            <div class="p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center gap-2">
                <span>✅</span>
                <span>@_notificationMessage</span>
            </div>
        }

        <div class="flex justify-end pt-2">
            <button type="button" @onclick="HandleSubmitInquiry" disabled="@_isSubmitting"
                    class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 disabled:opacity-50 text-white text-xs font-bold transition shadow-lg shadow-brand-500/25 flex items-center gap-2">
                @if (_isSubmitting)
                {
                    <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    <span>Transmitting Inquiry...</span>
                }
                else
                {
                    <span>Send Enterprise Inquiry</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                }
            </button>
        </div>
    </div>
</div>

@code {
    public class TeamMember
    {
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public string Focus { get; set; } = "";
        public string Avatar { get; set; } = "";
    }

    public class ContactInquiryModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Topic { get; set; } = "Architecture Advisory";
        public string SeatCount { get; set; } = "51-250";
        public string Message { get; set; } = "";
    }

    [Parameter] public string MissionHeading { get; set; } = "Empowering Modern Enterprises with Zero-Latency Blazor UI";
    [Parameter] public string MissionStatement { get; set; } = "Our mission is to build the world's most performant, secure, and developer-delightful component library for .NET 10+ WebAssembly, bridging modern Tailwind CSS agility with enterprise-grade reliability and zero third-party telemetry.";
    [Parameter] public string CustomClass { get; set; } = "";
    [Parameter] public EventCallback<ContactInquiryModel> OnInquirySubmitted { get; set; }

    private ContactInquiryModel _inquiry = new();
    private bool _isSubmitting = false;
    private string? _notificationMessage;

    private readonly List<TeamMember> _teamMembers = new()
    {
        new TeamMember { Name = "Dr. Sarah Jenkins", Role = "Principal Architect", Focus = "WASM Runtime & JIT", Avatar = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=256&q=80" },
        new TeamMember { Name = "Alexandre Chen", Role = "Head of Security", Focus = "SOC-2 & Cryptography", Avatar = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=256&q=80" },
        new TeamMember { Name = "Elena Rostova", Role = "Design System Lead", Focus = "Tailwind CSS & Ergonomics", Avatar = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=256&q=80" }
    };

    private async Task HandleSubmitInquiry()
    {
        if (string.IsNullOrWhiteSpace(_inquiry.Name) || string.IsNullOrWhiteSpace(_inquiry.Email))
        {
            _notificationMessage = "Name and Corporate Email are required.";
            return;
        }

        _isSubmitting = true;
        await Task.Delay(700);
        _isSubmitting = false;
        _notificationMessage = $"Thank you, {_inquiry.Name}. An executive architect will contact {_inquiry.Email} within 4 business hours.";

        if (OnInquirySubmitted.HasDelegate)
        {
            await OnInquirySubmitted.InvokeAsync(_inquiry);
        }
    }
}
