@namespace BlazorTailwindUI.Components.UI

<div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-900 text-white shadow-2xl overflow-hidden flex flex-col h-[600px] select-none @CustomClass">
    <!-- Top IDE Menu & Window Bar -->
    <div class="px-4 py-2 bg-slate-950 border-b border-slate-800 flex items-center justify-between text-xs">
        <div class="flex items-center gap-3">
            <span class="p-1 rounded-lg bg-brand-500/20 text-brand-400 font-bold">
                🪟
            </span>
            <span class="font-black tracking-tight text-white">@(Title ?? "IDE Dock Manager Studio")</span>
            <div class="flex items-center gap-1 font-mono text-[11px] text-slate-400">
                <span>•</span>
                <span>Active Workspace: EnterpriseApp.sln</span>
            </div>
        </div>

        <!-- Window View Toggles -->
        <div class="flex items-center gap-2">
            <button type="button" @onclick="() => _showLeftDock = !_showLeftDock"
                    class="px-2 py-1 rounded-lg border border-slate-800 text-[11px] font-mono transition @(_showLeftDock ? "bg-brand-500/20 text-brand-300 border-brand-500/30" : "bg-slate-900 text-slate-500")">
                📁 Explorer
            </button>
            <button type="button" @onclick="() => _showRightDock = !_showRightDock"
                    class="px-2 py-1 rounded-lg border border-slate-800 text-[11px] font-mono transition @(_showRightDock ? "bg-brand-500/20 text-brand-300 border-brand-500/30" : "bg-slate-900 text-slate-500")">
                ⚙️ Properties
            </button>
            <button type="button" @onclick="() => _showBottomDock = !_showBottomDock"
                    class="px-2 py-1 rounded-lg border border-slate-800 text-[11px] font-mono transition @(_showBottomDock ? "bg-brand-500/20 text-brand-300 border-brand-500/30" : "bg-slate-900 text-slate-500")">
                📟 Terminal
            </button>
        </div>
    </div>

    <!-- Main Workspace Area -->
    <div class="flex flex-1 overflow-hidden relative">
        <!-- 1. Left Dock Pane (Solution Explorer) -->
        @if (_showLeftDock)
        {
            <div class="w-64 bg-slate-950/90 border-r border-slate-800 flex flex-col transition-all">
                <!-- Panel Header -->
                <div class="p-2.5 bg-slate-900/60 border-b border-slate-800 flex items-center justify-between text-xs">
                    <span class="font-bold text-slate-300 uppercase tracking-wider text-[10px]">Solution Explorer</span>
                    <div class="flex items-center gap-1 text-slate-400">
                        <button type="button" @onclick="() => _leftPinned = !_leftPinned" title="@(_leftPinned ? "Unpin" : "Pin")" class="hover:text-white">
                            @(_leftPinned ? "📌" : "📍")
                        </button>
                        <button type="button" @onclick="() => _showLeftDock = false" title="Close" class="hover:text-white">✕</button>
                    </div>
                </div>

                <!-- Tree Content -->
                <div class="p-2 space-y-1 overflow-y-auto flex-1 font-mono text-xs text-slate-300">
                    <div class="flex items-center gap-1.5 p-1 rounded hover:bg-white/5 cursor-pointer">
                        <span>▼ 📂</span>
                        <span class="font-bold text-white">BlazorTailwindUI</span>
                    </div>
                    <div class="pl-4 space-y-1">
                        <div class="flex items-center gap-1.5 p-1 rounded hover:bg-white/5 cursor-pointer text-slate-400">
                            <span>▼ 📁</span>
                            <span>Components/UI</span>
                        </div>
                        <div class="pl-4 space-y-1">
                            <div class="flex items-center gap-1.5 p-1 rounded bg-brand-500/10 text-brand-300 font-semibold">
                                <span>📄</span>
                                <span>TwFinancialChart.razor</span>
                            </div>
                            <div class="flex items-center gap-1.5 p-1 rounded hover:bg-white/5 cursor-pointer">
                                <span>📄</span>
                                <span>TwMarkdownEditor.razor</span>
                            </div>
                            <div class="flex items-center gap-1.5 p-1 rounded hover:bg-white/5 cursor-pointer">
                                <span>📄</span>
                                <span>TwPivotGrid.razor</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 2. Center Document Work Area -->
        <div class="flex-1 flex flex-col overflow-hidden bg-slate-900">
            <!-- Document Tabs -->
            <div class="flex items-center bg-slate-950/80 border-b border-slate-800 overflow-x-auto">
                <button type="button" @onclick='() => _activeTab = "chart"'
                        class="px-4 py-2 border-r border-slate-800 text-xs font-mono font-bold flex items-center gap-2 @(_activeTab == "chart" ? "bg-slate-900 text-white border-t-2 border-t-brand-500" : "text-slate-400 hover:text-white")">
                    <span>📈</span>
                    <span>TwFinancialChart.razor</span>
                    <span class="text-[10px] text-slate-500 hover:text-white">✕</span>
                </button>
                <button type="button" @onclick='() => _activeTab = "editor"'
                        class="px-4 py-2 border-r border-slate-800 text-xs font-mono font-bold flex items-center gap-2 @(_activeTab == "editor" ? "bg-slate-900 text-white border-t-2 border-t-brand-500" : "text-slate-400 hover:text-white")">
                    <span>✍️</span>
                    <span>TwMarkdownEditor.razor</span>
                    <span class="text-[10px] text-slate-500 hover:text-white">✕</span>
                </button>
                <button type="button" @onclick='() => _activeTab = "pivot"'
                        class="px-4 py-2 border-r border-slate-800 text-xs font-mono font-bold flex items-center gap-2 @(_activeTab == "pivot" ? "bg-slate-900 text-white border-t-2 border-t-brand-500" : "text-slate-400 hover:text-white")">
                    <span>📊</span>
                    <span>TwPivotGrid.razor</span>
                    <span class="text-[10px] text-slate-500 hover:text-white">✕</span>
                </button>
            </div>

            <!-- Active Document Body -->
            <div class="flex-1 p-5 overflow-y-auto">
                @if (_activeTab == "chart")
                {
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-mono text-emerald-400 font-bold">● High-Frequency Candlestick Vector Stream</span>
                            <span class="text-[11px] font-mono text-slate-500">Lines: 418 • 60 FPS</span>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                            <TwFinancialChart CustomClass="shadow-none border-0 p-0" />
                        </div>
                    </div>
                }
                else if (_activeTab == "editor")
                {
                    <div class="space-y-3">
                        <span class="text-xs font-mono text-brand-300 font-bold">● Markdown & HTML Media Editor</span>
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800">
                            <TwMarkdownEditor CustomClass="shadow-none border-0" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        <span class="text-xs font-mono text-indigo-300 font-bold">● Multi-Dimensional OLAP Pivot Grid</span>
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800">
                            <TwPivotGrid CustomClass="shadow-none border-0 p-0" />
                        </div>
                    </div>
                }
            </div>

            <!-- 3. Bottom Dock Pane (Terminal & Output) -->
            @if (_showBottomDock)
            {
                <div class="h-40 bg-slate-950 border-t border-slate-800 flex flex-col">
                    <div class="px-3 py-1.5 bg-slate-900/60 border-b border-slate-800 flex items-center justify-between text-xs">
                        <div class="flex items-center gap-3 font-mono text-[11px]">
                            <span class="font-bold text-white border-b-2 border-brand-500 pb-0.5">Terminal</span>
                            <span class="text-slate-400 hover:text-white cursor-pointer">Build Output</span>
                            <span class="text-slate-400 hover:text-white cursor-pointer">Error List (0)</span>
                        </div>
                        <div class="flex items-center gap-1 text-slate-400">
                            <button type="button" @onclick="() => _showBottomDock = false" title="Close" class="hover:text-white">✕</button>
                        </div>
                    </div>
                    <div class="p-3 font-mono text-xs text-slate-300 overflow-y-auto space-y-1">
                        <div class="text-emerald-400 font-bold">PS C:\Enterprise\BlazorTailwindUI&gt; dotnet build -c Release</div>
                        <div class="text-slate-400">BlazorTailwindUI -&gt; bin/Release/net11.0/BlazorTailwindUI.dll</div>
                        <div class="text-slate-400">Build succeeded. 0 Warning(s), 0 Error(s). Time Elapsed 00:00:03.42</div>
                        <div class="text-brand-300 font-bold">Done in 3.42s! WASM bundle size: 1.4 MB.</div>
                    </div>
                </div>
            }
        </div>

        <!-- 4. Right Dock Pane (Properties & Inspector) -->
        @if (_showRightDock)
        {
            <div class="w-64 bg-slate-950/90 border-l border-slate-800 flex flex-col transition-all">
                <div class="p-2.5 bg-slate-900/60 border-b border-slate-800 flex items-center justify-between text-xs">
                    <span class="font-bold text-slate-300 uppercase tracking-wider text-[10px]">Properties</span>
                    <button type="button" @onclick="() => _showRightDock = false" title="Close" class="text-slate-400 hover:text-white">✕</button>
                </div>
                <div class="p-3 space-y-3 font-mono text-xs overflow-y-auto">
                    <div class="space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase block">Target Runtime</span>
                        <span class="text-white font-bold block">.NET 11 RC WebAssembly</span>
                    </div>
                    <div class="space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase block">Compilation Mode</span>
                        <span class="text-emerald-400 font-bold block">AOT Ahead-Of-Time</span>
                    </div>
                    <div class="space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase block">CSS Engine</span>
                        <span class="text-brand-300 font-bold block">Tailwind CSS v3.4+ CLI</span>
                    </div>
                    <div class="space-y-1">
                        <span class="text-slate-400 text-[10px] uppercase block">Third-Party CDNs</span>
                        <span class="text-slate-300 font-bold block">0 (Strictly Offline)</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Bottom Status Strip -->
    <div class="px-4 py-1.5 bg-brand-700 text-white flex items-center justify-between text-[11px] font-mono">
        <div class="flex items-center gap-3">
            <span>● Ready</span>
            <span>Master Branch</span>
            <span>UTF-8</span>
        </div>
        <div class="flex items-center gap-2">
            <span>Spaces: 4</span>
            <span>BlazorTailwindUI Dock Engine</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string CustomClass { get; set; } = "";

    private bool _showLeftDock = true;
    private bool _showRightDock = true;
    private bool _showBottomDock = true;
    private bool _leftPinned = true;
    private string _activeTab = "chart";
}
