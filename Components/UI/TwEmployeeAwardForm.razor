    public string GenerateGrantLetter()
    {
        var awardId = string.IsNullOrEmpty(_lastAwardId) ? "AWARD-" + DateTime.UtcNow.ToString("yyyyMMdd") : _lastAwardId;
        var dateFormatted = DateTime.UtcNow.ToString("MMMM dd, yyyy");

        return $@"================================================================================
                    EXECUTIVE MEMORANDUM & GRANT DISBURSEMENT
================================================================================
NOMINATION ID:     {awardId}
DATE ISSUED:       {dateFormatted}
CLASSIFICATION:    CONFIDENTIAL // HR & PAYROLL DISBURSEMENT
STATUS:            APPROVED & AUTHORIZED
--------------------------------------------------------------------------------
RECIPIENT (NOMINEE):
  Name:            {Model.NomineeName}
  Title:           {Model.NomineeTitle}
  Department:      {Model.NomineeDepartment}

NOMINATED BY:
  Nominator:       {Model.NominatorName}
  Relationship:    {Model.Relationship}

HONOR CONFERRED:
  Award Category:  {Model.AwardCategory}
  Citation:        ""{Model.InscriptionText}""

FINANCIAL DISBURSEMENT & BENEFIT ALLOCATION:
  1. Spot Cash Bonus:       {Model.GrantAmountFormatted}
     Payroll Code:          BONUS-SPOT-Q4
     Disbursement Cycle:    Next regular direct deposit payroll run
  2. Extra Paid Time Off:   +{Model.ExtraPtoDays} PTO Days
     HR Accrual Code:       PTO-MERIT-2026
  3. Public Recognition:    {(Model.PublishToWallOfFame ? "Corporate Wall of Fame & All-Hands Broadcast" : "Private / Manager Recognition")}

IMPACT NARRATIVE & JUSTIFICATION:
  ""{Model.ImpactNarrative}""

AUTHORIZATION & SIGNATURES:
  [APPROVED] Office of the Chief Technology Officer
  [VERIFIED] People Operations & Compensation Committee
================================================================================";
    }
}