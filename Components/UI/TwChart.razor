@namespace BlazorTailwindUI.Components.UI

<div class="w-full @Class">
    @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle))
    {
        <div class="mb-4">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">@Title</h4>
            }
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="text-xs text-slate-500">@Subtitle</p>
            }
        </div>
    }

    @if (Type == ChartType.Donut)
    {
        <!-- SVG Donut Chart with Centered Total & Legend -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
            <div class="relative w-44 h-44 shrink-0 flex items-center justify-center">
                <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
                    <!-- Background Track -->
                    <circle cx="50" cy="50" r="40" 
                            class="stroke-slate-100 dark:stroke-slate-800" 
                            stroke-width="12" 
                            fill="none" />
                    
                    <!-- Segment Arcs -->
                    @{
                        double total = DataItems.Sum(d => d.Value);
                        if (total <= 0) total = 1;
                        double circumference = 2 * Math.PI * 40; // ~251.327
                        double accumulatedOffset = 0;

                        for (int i = 0; i < DataItems.Count; i++)
                        {
                            var item = DataItems[i];
                            double percent = item.Value / total;
                            double strokeLength = percent * circumference;
                            double offset = accumulatedOffset;
                            accumulatedOffset += strokeLength;

                            var color = !string.IsNullOrEmpty(item.Color) ? item.Color : GetPaletteColor(i);

                            <circle cx="50" cy="50" r="40"
                                    stroke="@color"
                                    stroke-width="12"
                                    fill="none"
                                    stroke-dasharray="@($"{strokeLength:F2} {circumference:F2}")"
                                    stroke-dashoffset="@($"-{offset:F2}")"
                                    stroke-linecap="round"
                                    class="transition-all duration-500 ease-out hover:opacity-80 cursor-pointer" />
                        }
                    }
                </svg>

                <!-- Center Total Badge -->
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
                    <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
                        @CenterValue
                    </span>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">
                        @CenterLabel
                    </span>
                </div>
            </div>

            <!-- Legend Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs flex-1 w-full">
                @{
                    double totalSum = DataItems.Sum(d => d.Value);
                    if (totalSum <= 0) totalSum = 1;

                    for (int i = 0; i < DataItems.Count; i++)
                    {
                        var item = DataItems[i];
                        var color = !string.IsNullOrEmpty(item.Color) ? item.Color : GetPaletteColor(i);
                        var pct = Math.Round((item.Value / totalSum) * 100, 1);

                        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                            <div class="flex items-center gap-2 truncate">
                                <span class="w-3 h-3 rounded-full shrink-0" style="background-color: @color;"></span>
                                <span class="font-medium text-slate-700 dark:text-slate-300 truncate">@item.Label</span>
                            </div>
                            <span class="font-bold text-slate-900 dark:text-white ml-2">@pct%</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else if (Type == ChartType.Bar)
    {
        <!-- SVG Responsive Bar / Column Chart -->
        <div class="w-full">
            @{
                double maxVal = DataItems.Count > 0 ? DataItems.Max(d => d.Value) : 100;
                if (maxVal <= 0) maxVal = 100;
            }

            <div class="h-44 flex items-end gap-2 sm:gap-4 pt-6 pb-2 px-2 border-b border-slate-200 dark:border-slate-800">
                @for (int i = 0; i < DataItems.Count; i++)
                {
                    var item = DataItems[i];
                    var heightPercent = Math.Clamp((item.Value / maxVal) * 100, 4, 100);
                    var color = !string.IsNullOrEmpty(item.Color) ? item.Color : GetPaletteColor(i);

                    <div class="flex-1 flex flex-col items-center h-full justify-end group cursor-pointer">
                        <!-- Value Tooltip on hover -->
                        <div class="opacity-0 group-hover:opacity-100 transition-opacity mb-1 text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow">
                            @item.Value
                        </div>

                        <!-- Bar Pillar -->
                        <div class="w-full rounded-t-lg transition-all duration-300 group-hover:brightness-110"
                             style="height: @($"{heightPercent:F1}%"); background-color: @color;">
                        </div>

                        <!-- X-Axis Label -->
                        <span class="mt-2 text-[10px] sm:text-xs font-semibold text-slate-500 truncate w-full text-center">
                            @item.Label
                        </span>
                    </div>
                }
            </div>
        </div>
    }
    else if (Type == ChartType.Sparkline)
    {
        <!-- Smooth Area / Sparkline Chart -->
        <div class="w-full h-24 relative overflow-hidden rounded-xl bg-slate-50/50 dark:bg-slate-900/40 p-1">
            <svg class="w-full h-full" viewBox="0 0 300 80" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="sparkGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.0" />
                    </linearGradient>
                </defs>
                @{
                    var pts = BuildSparklinePoints(300, 80);
                }
                <!-- Filled Area -->
                <polygon points="@pts.AreaPoints" fill="url(#sparkGrad)" />
                <!-- Polyline Stroke -->
                <polyline points="@pts.LinePoints" fill="none" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
    }
</div>

@code {
    public enum ChartType
    {
        Donut,
        Bar,
        Sparkline
    }

    public sealed record ChartDataItem(string Label, double Value, string? Color = null);

    [Parameter] public ChartType Type { get; set; } = ChartType.Donut;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string CenterValue { get; set; } = "100%";
    [Parameter] public string CenterLabel { get; set; } = "Total";
    [Parameter] public IReadOnlyList<ChartDataItem> DataItems { get; set; } = Array.Empty<ChartDataItem>();
    [Parameter] public string? Class { get; set; }

    private static readonly string[] DefaultPalette = new[]
    {
        "#4f46e5", // Indigo
        "#10b981", // Emerald
        "#f59e0b", // Amber
        "#f43f5e", // Rose
        "#0ea5e9", // Sky
        "#8b5cf6"  // Violet
    };

    private string GetPaletteColor(int index) => DefaultPalette[index % DefaultPalette.Length];

    private (string LinePoints, string AreaPoints) BuildSparklinePoints(double width, double height)
    {
        if (DataItems.Count < 2) return ("0,40 300,40", "0,80 0,40 300,40 300,80");

        double max = DataItems.Max(d => d.Value);
        double min = DataItems.Min(d => d.Value);
        double range = max - min;
        if (range <= 0) range = 1;

        double stepX = width / (DataItems.Count - 1);
        var linePts = new List<string>();

        for (int i = 0; i < DataItems.Count; i++)
        {
            double x = i * stepX;
            // Invert Y because SVG 0 is top
            double y = height - ((DataItems[i].Value - min) / range * (height - 16) + 8);
            linePts.Add($"{x:F1},{y:F1}");
        }

        string lineString = string.Join(" ", linePts);
        string areaString = $"0,{height:F1} {lineString} {width:F1},{height:F1}";

        return (lineString, areaString);
    }
}
