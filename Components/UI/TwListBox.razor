@typeparam TItem
@* Searchable list with checkboxes (multiple) or radios (single), Select all, and a live count. Native inputs keep it keyboard and screen-reader friendly. *@
<section aria-label="@Label" class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 @Class" data-testid="listbox">
    <div class="flex items-center gap-2 p-2 border-b border-slate-200 dark:border-slate-700">
        <label for="@_id" class="sr-only">Search @Label</label>
        <input id="@_id" type="search" placeholder="Search" @bind="_query" @bind:event="oninput" data-testid="listbox-search"
               class="flex-1 min-h-[36px] rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-3 text-sm text-slate-900 dark:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" />
        @if (Multiple)
        {
            <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-800 dark:text-slate-200 whitespace-nowrap">
                <input type="checkbox" checked="@AllShownSelected" @onchange="e => ToggleAllAsync((bool)(e.Value ?? false))" data-testid="listbox-all" class="rounded border-slate-400 text-brand-600 focus:ring-brand-500" />
                Select all
            </label>
        }
    </div>
    <ul class="max-h-60 overflow-y-auto p-1" data-testid="listbox-items">
        @foreach (var item in Shown())
        {
            var on = IsSelected(item);
            <li>
                <label class="flex items-center gap-2 rounded-lg px-2 min-h-[36px] cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 focus-within:ring-2 focus-within:ring-brand-500">
                    <input type="@(Multiple ? "checkbox" : "radio")" name="@_id" checked="@on" @onchange="() => ToggleAsync(item)" data-testid="listbox-item" data-text="@Text(item)"
                           class="text-brand-600 focus:ring-brand-500" />
                    <span class="text-sm text-slate-900 dark:text-slate-100">@Text(item)</span>
                </label>
            </li>
        }
    </ul>
    @if (!Shown().Any())
    {
        <p class="px-3 py-4 text-sm text-slate-700 dark:text-slate-300" data-testid="listbox-empty">No items match.</p>
    }
    <p class="px-3 py-1.5 border-t border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300" role="status" data-testid="listbox-count">@Selected.Count of @Items.Count selected</p>
</section>

@code {
    private readonly string _id = "lb-" + Guid.NewGuid().ToString("N")[..6];
    private string _query = "";

    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public Func<TItem, string>? TextSelector { get; set; }
    [Parameter] public IReadOnlyList<TItem> Selected { get; set; } = Array.Empty<TItem>();
    [Parameter] public EventCallback<IReadOnlyList<TItem>> SelectedChanged { get; set; }
    [Parameter] public bool Multiple { get; set; } = true;
    [Parameter] public string Label { get; set; } = "Items";
    [Parameter] public string? Class { get; set; }

    private string Text(TItem item) => TextSelector?.Invoke(item) ?? item?.ToString() ?? "";

    private IEnumerable<TItem> Shown() => string.IsNullOrWhiteSpace(_query)
        ? Items
        : Items.Where(i => Text(i).Contains(_query, StringComparison.OrdinalIgnoreCase));

    private bool IsSelected(TItem item) => Selected.Contains(item);

    private bool AllShownSelected => Shown().Any() && Shown().All(IsSelected);

    private async Task SetAsync(IReadOnlyList<TItem> next)
    {
        Selected = next;
        await SelectedChanged.InvokeAsync(next);
    }

    private async Task ToggleAsync(TItem item)
    {
        if (!Multiple) { await SetAsync(new[] { item }); return; }
        var list = Selected.ToList();
        if (!list.Remove(item)) list.Add(item);
        await SetAsync(list);
    }

    private async Task ToggleAllAsync(bool on)
    {
        var shown = Shown().ToList();
        var list = Selected.Where(s => !shown.Contains(s)).ToList();
        if (on) list.AddRange(shown);
        await SetAsync(list);
    }
}
