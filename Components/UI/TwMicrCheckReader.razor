@namespace BlazorTailwindUI.Components.UI
@using BlazorTailwindUI.Models
@using BlazorTailwindUI.Services
@inject OcrEngineService OcrEngine
@inject TwSoundService Sound
@inject ToastService Toast
@inject IJSRuntime JS

<div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden @Class">
    <!-- Header Controls -->
    <div class="p-4 sm:p-5 bg-slate-50 dark:bg-slate-950/80 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl font-bold border border-emerald-500/20">
                🏦
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
                        Check 21 MICR Reader & Check/Draft OCR
                    </h3>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        ANSI X9.27 / E-13B
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                        ABA MOD-10 VERIFIED
                    </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Client-side WebAssembly optical recognition for paper checks, official drafts, and magnetic ink clear bands
                </p>
            </div>
        </div>

        <!-- Sample Selector & Scan Action -->
        <div class="flex items-center gap-2">
            <select @onchange="OnPresetChanged"
                    class="px-3 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-semibold text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
                <option value="check-payroll-1042">Sample: Payroll Check #1042 ($14,850.00)</option>
                <option value="check-vendor-8812">Sample: Vendor Hardware Check #8812 ($8,420.50)</option>
                <option value="check-draft-5021">Sample: Cashier's Trust Draft #5021 ($250,000.00)</option>
                <option value="check-invalid-9901">Sample: Invalid Routing Test #9901 (Checksum Warning)</option>
            </select>

            <button type="button" @onclick="RescanCurrentAsync"
                    disabled="@_isScanning"
                    class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white font-bold text-xs shadow-md transition flex items-center gap-1.5">
                @if (_isScanning)
                {
                    <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    <span>Scanning...</span>
                }
                else
                {
                    <span>⚡ Rescan OCR</span>
                }
            </button>
        </div>
    </div>

    <!-- Main Workspace: Split View (Interactive Check Visual vs OCR Audit Ledger) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- Left: Interactive High-Fidelity Paper Check / Draft Canvas -->
        <div class="lg:col-span-7 p-4 sm:p-6 bg-slate-100/50 dark:bg-slate-950/40 flex flex-col justify-between space-y-4">
            
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full @(_check?.MicrData.IsValidRoutingChecksum == true ? "bg-emerald-500" : "bg-rose-500")"></span>
                    <span class="font-semibold text-slate-700 dark:text-slate-300">Document Surface Preview</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="font-mono text-[11px]">Check 21 Standard Front</span>
                    <button type="button" @onclick="ToggleBoundingBoxes"
                            class="px-2 py-0.5 rounded-lg border text-[11px] font-semibold @(_showBoundingBoxes ? "bg-emerald-50 dark:bg-emerald-950/60 border-emerald-500 text-emerald-700 dark:text-emerald-300" : "bg-white dark:bg-slate-850 border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400")">
                        @(_showBoundingBoxes ? "Hide Bounding Boxes" : "Show Bounding Boxes")
                    </button>
                </div>
            </div>

            <!-- The Paper Check Canvas Element -->
            <div class="relative w-full rounded-2xl border-2 border-slate-300 dark:border-slate-700 bg-amber-50/70 dark:bg-slate-850 shadow-inner p-4 sm:p-6 font-serif select-none transition-all">
                
                <!-- Security Watermark Pattern Background -->
                <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none rounded-2xl bg-[radial-gradient(#000_1px,transparent_1px)] [background-size:16px_16px]"></div>

                <!-- Top Check Row: Payer Details & Check Number / Date -->
                <div class="relative z-10 flex items-start justify-between gap-4">
                    <!-- Payer Information -->
                    <div class="space-y-0.5">
                        <div class="font-sans font-black text-xs sm:text-sm text-slate-900 dark:text-white tracking-wide uppercase">
                            @(_check?.PayerName ?? "Acme Enterprise Dynamics Inc.")
                        </div>
                        <div class="font-sans text-[11px] text-slate-600 dark:text-slate-400">
                            @(_check?.PayerAddress ?? "100 Montgomery St, Suite 1800, San Francisco, CA 94104")
                        </div>
                    </div>

                    <!-- Top Right: Check Number & Date -->
                    <div class="text-right space-y-1">
                        <div class="font-mono font-bold text-xs sm:text-sm text-slate-900 dark:text-white tracking-wider">
                            CHECK NO. <span class="text-emerald-600 dark:text-emerald-400">@(_check?.CheckNumber ?? "1042")</span>
                        </div>
                        <div class="inline-flex items-center gap-1.5 font-sans text-xs border-b border-slate-400 dark:border-slate-600 pb-0.5">
                            <span class="text-[10px] text-slate-500 uppercase font-sans">Date:</span>
                            <span class="font-semibold text-slate-800 dark:text-slate-200">@(_check?.Date ?? "October 24, 2026")</span>
                        </div>
                    </div>
                </div>

                <!-- Middle Row 1: Pay to the Order of & Courtesy Amount Box -->
                <div class="relative z-10 mt-6 flex items-baseline justify-between gap-4">
                    <div class="flex-1 flex items-baseline gap-2 border-b border-slate-400 dark:border-slate-600 pb-1">
                        <span class="font-sans font-bold text-[10px] uppercase text-slate-500 tracking-wider shrink-0">Pay to the Order of:</span>
                        <span class="font-serif italic font-bold text-sm sm:text-base text-slate-950 dark:text-white">
                            @(_check?.Payee ?? "Jane Doe Development Consulting")
                        </span>
                    </div>

                    <!-- Courtesy Amount Box -->
                    <div class="shrink-0 px-3 py-1.5 rounded-lg border-2 border-slate-800 dark:border-slate-400 bg-white/90 dark:bg-slate-900 flex items-center gap-1 font-mono font-bold text-sm sm:text-base text-slate-900 dark:text-white shadow-xs">
                        <span class="text-xs text-slate-400">$</span>
                        <span>@(_check?.CourtesyAmount.ToString("N2") ?? "14,850.00")</span>
                    </div>
                </div>

                <!-- Middle Row 2: Legal Amount Line in Words -->
                <div class="relative z-10 mt-3 flex items-baseline gap-2 border-b border-slate-400 dark:border-slate-600 pb-1">
                    <span class="font-serif italic font-medium text-xs sm:text-sm text-slate-900 dark:text-slate-200 truncate">
                        @(_check?.LegalAmountWords ?? "Fourteen thousand eight hundred fifty and 00/100 Dollars")
                    </span>
                    <span class="font-sans font-bold text-[10px] uppercase text-slate-500 tracking-wider shrink-0 ml-auto">DOLLARS ⚑</span>
                </div>

                <!-- Middle Row 3: Drawee Bank -->
                <div class="relative z-10 mt-3 font-sans text-[11px] text-slate-600 dark:text-slate-400 flex items-center gap-2">
                    <span class="font-semibold text-slate-900 dark:text-slate-200">@(_check?.BankName ?? "JPMorgan Chase Bank, N.A.")</span>
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-200/80 dark:bg-slate-700 font-mono">Check 21 Verified</span>
                </div>

                <!-- Bottom Row: Memo & Signature Line -->
                <div class="relative z-10 mt-5 flex items-end justify-between gap-6 pb-2">
                    <div class="flex-1 flex items-baseline gap-1.5 border-b border-slate-400 dark:border-slate-600 pb-1">
                        <span class="font-sans font-bold text-[10px] uppercase text-slate-500">FOR:</span>
                        <span class="font-sans text-xs text-slate-800 dark:text-slate-200 truncate">
                            @(_check?.Memo ?? "Q3 High-Availability Cloud Architecture Project")
                        </span>
                    </div>

                    <!-- Maker Signature -->
                    <div class="w-48 border-b border-slate-400 dark:border-slate-600 text-center pb-1 relative">
                        <div class="font-serif italic text-base sm:text-lg text-blue-900 dark:text-blue-300 font-black tracking-wider -rotate-1 select-none">
                            Jane D. Consult
                        </div>
                        <span class="font-sans font-bold text-[9px] uppercase text-slate-500 tracking-wider block">Authorized Signature</span>
                        
                        @if (_check?.SignatureDetected == true)
                        {
                            <span class="absolute -top-3 right-0 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700">
                                ✓ Sig Detected (@((_check.SignatureConfidence * 100).ToString("F0"))%)
                            </span>
                        }
                    </div>
                </div>

                <!-- Standard 5/8" MICR Clear Band at the Bottom (ANSI X9.27 E-13B) -->
                <div class="relative z-10 mt-6 pt-3 border-t-2 border-dashed border-slate-300 dark:border-slate-700/80 bg-white/60 dark:bg-slate-900/80 -mx-4 -mb-4 sm:-mx-6 sm:-mb-6 p-4 rounded-b-2xl">
                    <div class="flex items-center justify-between text-[10px] font-sans font-semibold text-slate-400 mb-1">
                        <span class="uppercase tracking-wider">ANSI X9.27 / ISO 1004 MICR E-13B Clear Band</span>
                        <span class="font-mono">Transit ⑆ | On-Us ⑈ | Amount ⑇ | Dash ⑉</span>
                    </div>

                    <!-- Styled E-13B Magnetic Ink Text Line -->
                    <div class="py-2 px-3 rounded-xl bg-slate-950 text-emerald-400 font-mono text-sm sm:text-base tracking-widest flex items-center justify-between overflow-x-auto shadow-inner">
                        <span class="font-bold whitespace-nowrap">
                            @(_check?.MicrData.RawMicrLine ?? "⑆121000358⑆ 0123456789⑈ 1042")
                        </span>
                        <button type="button" @onclick="CopyMicrLineAsync"
                                class="px-2 py-0.5 rounded text-[10px] bg-slate-800 hover:bg-slate-700 text-slate-300 transition shrink-0 ml-2">
                            Copy 📋
                        </button>
                    </div>
                </div>

                <!-- Spatial Bounding Boxes Overlay -->
                @if (_showBoundingBoxes && _check != null)
                {
                    <div class="absolute inset-0 pointer-events-none rounded-2xl overflow-hidden">
                        @foreach (var box in _check.BoundingBoxes)
                        {
                            <div class="absolute border-2 border-emerald-500 bg-emerald-500/10 rounded-lg transition-all animate-fadeIn"
                                 style="left: @(box.LeftPercent)%; top: @(box.TopPercent)%; width: @(box.WidthPercent)%; height: @(box.HeightPercent)%;">
                                <span class="absolute -top-3.5 left-1 px-1 py-0.2 rounded text-[9px] font-mono font-bold bg-emerald-600 text-white shadow-xs">
                                    @box.Label
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- OCR Performance Metadata Footer -->
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400 pt-2">
                <div class="flex items-center gap-3">
                    <span>⚡ OCR Latency: <strong class="text-slate-800 dark:text-slate-200">@(_check?.ProcessingTimeMs ?? 62)ms</strong></span>
                    <span>• Overall Confidence: <strong class="text-emerald-600 dark:text-emerald-400">@(((_check?.OverallConfidence ?? 0.99) * 100).ToString("F1"))%</strong></span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-mono">Check 21 Compliant WebAssembly Engine</span>
                </div>
            </div>
        </div>

        <!-- Right: Check 21 Verification Ledger & Extracted Data Inspector -->
        <div class="lg:col-span-5 p-4 sm:p-6 bg-white dark:bg-slate-900 flex flex-col justify-between space-y-4">
            
            <div class="space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">MICR & Field Verification</h4>
                        <p class="text-sm font-bold text-slate-900 dark:text-white">Drawee & Cheque Integrity</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold @(_check?.MicrData.IsValidRoutingChecksum == true ? "bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800" : "bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-300 dark:border-rose-800")">
                        @(_check?.MicrData.IsValidRoutingChecksum == true ? "✓ CHECKSUM PASS" : "✗ CHECKSUM FAIL")
                    </span>
                </div>

                <!-- Structured Check 21 Elements Table -->
                <div class="space-y-2 text-xs">
                    
                    <!-- 1. ABA Routing Number -->
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-start justify-between gap-3">
                        <div class="space-y-0.5">
                            <span class="font-bold text-slate-500 uppercase text-[10px] block">ABA Routing Transit Number (RTN)</span>
                            <span class="font-mono font-bold text-sm text-slate-900 dark:text-white">@(_check?.MicrData.TransitRoutingNumber)</span>
                            <span class="text-[11px] text-slate-500 block">@(_check?.MicrData.BankName)</span>
                        </div>
                        <div class="text-right">
                            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold @(_check?.MicrData.IsValidRoutingChecksum == true ? "bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300" : "bg-rose-100 dark:bg-rose-900/60 text-rose-700 dark:text-rose-300")">
                                @(_check?.MicrData.IsValidRoutingChecksum == true ? "Mod-10: 0 (Valid)" : $"Mod-10: {_check?.MicrData.Mod10ChecksumValue} (Failed)")
                            </span>
                        </div>
                    </div>

                    <!-- 2. Account Number -->
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-3">
                        <div>
                            <span class="font-bold text-slate-500 uppercase text-[10px] block">On-Us Customer Account Number</span>
                            <span class="font-mono font-bold text-sm text-slate-900 dark:text-white">@(_check?.MicrData.AccountNumber)</span>
                        </div>
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-blue-100 dark:bg-blue-900/60 text-blue-700 dark:text-blue-300 font-bold">
                            On-Us Symbol ⑈
                        </span>
                    </div>

                    <!-- 3. Check Number Matching -->
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-3">
                        <div>
                            <span class="font-bold text-slate-500 uppercase text-[10px] block">Check Sequence Number</span>
                            <span class="font-mono font-bold text-sm text-slate-900 dark:text-white">@(_check?.CheckNumber)</span>
                        </div>
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 font-bold">
                            Matched Top-Right & MICR
                        </span>
                    </div>

                    <!-- 4. Amount Verification (Courtesy vs Legal Words) -->
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 space-y-1">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-slate-500 uppercase text-[10px]">Courtesy Amount vs Legal Words</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300">
                                Exact Match
                            </span>
                        </div>
                        <div class="flex items-center justify-between font-mono font-bold text-sm text-slate-900 dark:text-white">
                            <span>$@(_check?.CourtesyAmount.ToString("N2"))</span>
                            <span class="text-xs font-serif italic font-normal text-slate-600 dark:text-slate-300 truncate max-w-[200px]">@(_check?.LegalAmountWords)</span>
                        </div>
                    </div>
                </div>

                <!-- Mathematical Checksum Formula Explainer Card -->
                <div class="p-3 rounded-xl bg-slate-100/70 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 text-[11px] text-slate-600 dark:text-slate-400 space-y-1">
                    <span class="font-bold text-slate-800 dark:text-slate-200 block">Federal Reserve Routing Transit Check Digit Algorithm:</span>
                    <p class="font-mono text-[10px] text-slate-700 dark:text-slate-300">
                        Formula: [3(d₁ + d₄ + d₇) + 7(d₂ + d₅ + d₈) + 1(d₃ + d₆ + d₉)] mod 10 == 0
                    </p>
                    <p class="text-[10px]">
                        Guarantees automated check sorting machines reject transposed digits or counterfeit MICR encodings at high speeds.
                    </p>
                </div>
            </div>

            <!-- Action Buttons: Approve Deposit / Copy Markdown / Export JSON -->
            <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                <button type="button" @onclick="ApproveDepositAsync"
                        class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md transition flex items-center justify-center gap-2">
                    <span>💳 Approve & Submit Remote Deposit Capture (RDC)</span>
                </button>

                <div class="grid grid-cols-2 gap-2">
                    <button type="button" @onclick="CopyMarkdownTableAsync"
                            class="py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-xs transition flex items-center justify-center gap-1.5">
                        <span>📋 Copy Markdown</span>
                    </button>
                    <button type="button" @onclick="ExportJsonAsync"
                            class="py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-xs transition flex items-center justify-center gap-1.5">
                        <span>📦 Export JSON</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback<CheckDraftOcrResult> OnCheckScanned { get; set; }
    [Parameter] public EventCallback<string> OnInsertMarkdown { get; set; }

    private CheckDraftOcrResult? _check;
    private bool _isScanning = false;
    private bool _showBoundingBoxes = true;
    private string _currentPresetId = "check-payroll-1042";

    protected override async Task OnInitializedAsync()
    {
        await LoadPresetAsync(_currentPresetId);
    }

    private async Task OnPresetChanged(ChangeEventArgs e)
    {
        _currentPresetId = e.Value?.ToString() ?? "check-payroll-1042";
        await LoadPresetAsync(_currentPresetId);
    }

    private async Task LoadPresetAsync(string presetId)
    {
        _isScanning = true;
        StateHasChanged();

        _check = await OcrEngine.ScanCheckOrDraftAsync(presetId);
        _isScanning = false;

        if (OnCheckScanned.HasDelegate && _check != null)
        {
            await OnCheckScanned.InvokeAsync(_check);
        }
    }

    private async Task RescanCurrentAsync()
    {
        await Sound.PlayPopAsync();
        await LoadPresetAsync(_currentPresetId);
        await Sound.PlayChimeAsync();
        Toast.Show("OCR & MICR Rescan Complete", $"Extracted {_check?.CheckNumber} with {((_check?.OverallConfidence ?? 0.99) * 100):F0}% confidence", SemanticVariant.Success);
    }

    private void ToggleBoundingBoxes()
    {
        _showBoundingBoxes = !_showBoundingBoxes;
    }

    private async Task CopyMicrLineAsync()
    {
        if (_check?.MicrData != null)
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", _check.MicrData.RawMicrLine);
            }
            catch
            { }
            await Sound.PlayPopAsync();
            Toast.Show("Copied to Clipboard", "Raw E-13B MICR line copied", SemanticVariant.Info);
        }
    }

    private async Task CopyMarkdownTableAsync()
    {
        if (_check != null)
        {
            var md = OcrEngine.GenerateCheckMarkdown(_check);
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", md);
            }
            catch
            { }
            await Sound.PlayPopAsync();
            Toast.Show("Markdown Report Copied", "Check 21 ledger table copied to clipboard", SemanticVariant.Success);
            
            if (OnInsertMarkdown.HasDelegate)
            {
                await OnInsertMarkdown.InvokeAsync(md);
            }
        }
    }

    private async Task ExportJsonAsync()
    {
        if (_check != null)
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_check, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
            }
            catch
            { }
            await Sound.PlayPopAsync();
            Toast.Show("JSON Payload Copied", "Serialized CheckDraftOcrResult payload copied to clipboard", SemanticVariant.Success);
        }
    }

    private async Task ApproveDepositAsync()
    {
        if (_check?.MicrData.IsValidRoutingChecksum == false)
        {
            await Sound.PlayPopAsync();
            Toast.Show("Deposit Blocked", "ABA routing transit number failed modulus-10 check digit test", SemanticVariant.Danger);
            return;
        }

        await Sound.PlayChimeAsync();
        Toast.Show("Deposit Submitted (RDC)", $"Successfully queued check #{_check?.CheckNumber} for ${_check?.CourtesyAmount:N2} to Federal Reserve automated clearing", SemanticVariant.Success);
    }
}
