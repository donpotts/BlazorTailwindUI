<div class="inline-flex p-1 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-inner @Class">
    @foreach (var tab in Tabs)
    {
        var isActive = tab.Id == ActiveTabId;
        <button type="button"
                @onclick="() => SelectTab(tab.Id)"
                class="relative px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 select-none flex items-center gap-2 @(isActive ? "bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-sm ring-1 ring-slate-900/5 dark:ring-white/10" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
            @if (!string.IsNullOrWhiteSpace(tab.IconSvg))
            {
                <span class="w-4 h-4 @(isActive ? "text-brand-500" : "text-slate-400")">
                    @((MarkupString)tab.IconSvg)
                </span>
            }
            <span>@tab.Label</span>
            @if (!string.IsNullOrWhiteSpace(tab.Badge))
            {
                <span class="px-1.5 py-0.2 rounded-md text-[10px] font-bold @(isActive ? "bg-brand-500/10 text-brand-600 dark:text-brand-400" : "bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300")">
                    @tab.Badge
                </span>
            }
        </button>
    }
</div>

@code {
    public class TabItem
    {
        public string Id { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string? IconSvg { get; set; }
        public string? Badge { get; set; }
    }

    [Parameter] public List<TabItem> Tabs { get; set; } = new();
    [Parameter] public string ActiveTabId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ActiveTabIdChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task SelectTab(string id)
    {
        ActiveTabId = id;
        await ActiveTabIdChanged.InvokeAsync(id);
    }
}
