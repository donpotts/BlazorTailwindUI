@using BlazorTailwindUI.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 md:p-20" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity animate-fade-in"
             @onclick="Close"></div>

        <!-- Palette Modal Container -->
        <div class="relative mx-auto max-w-2xl transform rounded-2xl bg-white dark:bg-slate-900 shadow-2xl ring-1 ring-slate-950/5 dark:ring-white/10 transition-all overflow-hidden animate-zoom-in">
            <!-- Search Header -->
            <div class="relative flex items-center border-b border-slate-200/80 dark:border-slate-800 px-4">
                <svg class="h-5 w-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text"
                       @ref="_inputRef"
                       class="h-14 w-full bg-transparent border-0 pl-3 pr-10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-hidden focus:ring-0 text-base sm:text-sm"
                       placeholder="@Placeholder"
                       value="@_searchQuery"
                       @oninput="HandleInput"
                       @onkeydown="HandleKeyDown" />
                @if (!string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <button type="button"
                            @onclick="() => { _searchQuery = string.Empty; _selectedIndex = 0; }"
                            class="absolute right-12 p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
                <kbd class="hidden sm:inline-flex items-center rounded-md border border-slate-200 dark:border-slate-700 px-2 py-0.5 text-xs font-mono text-slate-400">
                    ESC
                </kbd>
            </div>

            <!-- Results List -->
            <div class="max-h-96 scroll-py-2 overflow-y-auto p-2">
                @if (FilteredItems.Count == 0)
                {
                    <div class="py-14 px-6 text-center text-sm sm:px-14">
                        <svg class="mx-auto h-8 w-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="mt-4 font-semibold text-slate-900 dark:text-white">No results found</p>
                        <p class="mt-1 text-slate-500 dark:text-slate-400">No components or actions matching "@_searchQuery". Try another keyword.</p>
                    </div>
                }
                else
                {
                    var grouped = FilteredItems.GroupBy(i => i.Category).ToList();
                    var flatIndex = 0;
                    @foreach (var group in grouped)
                    {
                        <div class="py-1">
                            <h3 class="px-3 text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                                @group.Key
                            </h3>
                            <ul class="mt-1 text-sm text-slate-700 dark:text-slate-200">
                                @foreach (var item in group)
                                {
                                    var currentIndex = flatIndex++;
                                    var isSelected = currentIndex == _selectedIndex;
                                    <li class="group flex cursor-pointer select-none items-center justify-between rounded-xl px-3 py-2.5 transition-colors @(isSelected ? "bg-brand-500/10 dark:bg-brand-500/20 text-brand-600 dark:text-brand-400 font-medium" : "hover:bg-slate-100 dark:hover:bg-slate-800/60")"
                                        @onclick="() => SelectItem(item)"
                                        @onmouseenter="() => _selectedIndex = currentIndex">
                                        <div class="flex items-center gap-3 min-w-0">
                                            @if (!string.IsNullOrWhiteSpace(item.IconSvg))
                                            {
                                                <span class="shrink-0 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300 @(isSelected ? "!text-brand-500" : "")">
                                                    @((MarkupString)item.IconSvg)
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="w-2 h-2 rounded-full @(isSelected ? "bg-brand-500" : "bg-slate-300 dark:bg-slate-700")"></div>
                                            }
                                            <div class="truncate">
                                                <span class="block truncate">@item.Title</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                                {
                                                    <span class="block text-xs text-slate-400 font-normal truncate">@item.Subtitle</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2 shrink-0">
                                            @if (!string.IsNullOrWhiteSpace(item.ShortcutKey))
                                            {
                                                <kbd class="hidden sm:inline-block rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-xs font-mono text-slate-500 dark:text-slate-400">
                                                    @item.ShortcutKey
                                                </kbd>
                                            }
                                            @if (isSelected)
                                            {
                                                <span class="text-xs text-brand-500 font-mono">↵</span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>

            <!-- Footer Bar with Keyboard Shortcuts -->
            <div class="flex flex-wrap items-center justify-between bg-slate-50 dark:bg-slate-950/60 px-4 py-2.5 text-xs text-slate-400 border-t border-slate-200/80 dark:border-slate-800">
                <div class="flex items-center gap-4">
                    <span class="flex items-center gap-1">
                        <kbd class="rounded-sm bg-white dark:bg-slate-800 px-1.5 py-0.5 border border-slate-200 dark:border-slate-700 font-mono">↑</kbd>
                        <kbd class="rounded-sm bg-white dark:bg-slate-800 px-1.5 py-0.5 border border-slate-200 dark:border-slate-700 font-mono">↓</kbd>
                        <span>Navigate</span>
                    </span>
                    <span class="flex items-center gap-1">
                        <kbd class="rounded-sm bg-white dark:bg-slate-800 px-1.5 py-0.5 border border-slate-200 dark:border-slate-700 font-mono">↵</kbd>
                        <span>Select</span>
                    </span>
                    <span class="flex items-center gap-1">
                        <kbd class="rounded-sm bg-white dark:bg-slate-800 px-1.5 py-0.5 border border-slate-200 dark:border-slate-700 font-mono">ESC</kbd>
                        <span>Close</span>
                    </span>
                </div>
                <div class="hidden md:flex items-center gap-1 text-slate-400">
                    <span>Modern Tailwind Command Palette</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public List<CommandPaletteItem> Items { get; set; } = new();
    [Parameter] public EventCallback<CommandPaletteItem> OnItemSelected { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Type a command, component name, or search...";

    private ElementReference _inputRef;
    private string _searchQuery = string.Empty;
    private int _selectedIndex = 0;
    private DotNetObjectReference<TwCommandPalette>? _dotNetRef;

    private List<CommandPaletteItem> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchQuery))
                return Items;

            var q = _searchQuery.Trim().ToLowerInvariant();
            return Items
                .Where(i => i.Title.ToLowerInvariant().Contains(q) ||
                            (i.Subtitle?.ToLowerInvariant().Contains(q) ?? false) ||
                            i.Category.ToLowerInvariant().Contains(q))
                .ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("blazorTailwind.initCommandPaletteListener", _dotNetRef);
            }
            catch { }
        }

        if (IsOpen)
        {
            try
            {
                await _inputRef.FocusAsync();
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task TogglePaletteFromShortcut()
    {
        IsOpen = !IsOpen;
        _searchQuery = string.Empty;
        _selectedIndex = 0;
        await IsOpenChanged.InvokeAsync(IsOpen);
        StateHasChanged();
    }

    private void HandleInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _selectedIndex = 0;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var count = FilteredItems.Count;
        if (count == 0)
        {
            if (e.Key == "Escape") await Close();
            return;
        }

        if (e.Key == "ArrowDown")
        {
            _selectedIndex = (_selectedIndex + 1) % count;
        }
        else if (e.Key == "ArrowUp")
        {
            _selectedIndex = (_selectedIndex - 1 + count) % count;
        }
        else if (e.Key == "Enter")
        {
            if (_selectedIndex >= 0 && _selectedIndex < count)
            {
                await SelectItem(FilteredItems[_selectedIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task SelectItem(CommandPaletteItem item)
    {
        await Close();
        if (item.Action != null)
        {
            item.Action.Invoke();
        }
        await OnItemSelected.InvokeAsync(item);
    }

    public async Task Open()
    {
        IsOpen = true;
        _searchQuery = string.Empty;
        _selectedIndex = 0;
        await IsOpenChanged.InvokeAsync(true);
        StateHasChanged();
    }

    public async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
    }
}
