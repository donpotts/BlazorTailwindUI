<div class="relative flex items-center my-4 @Class">
    <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
    @if (!string.IsNullOrWhiteSpace(Text) || ChildContent is not null)
    {
        <span class="flex-shrink mx-3 text-xs font-medium text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-900 px-2 rounded">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Text
            }
        </span>
    }
    <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
}
