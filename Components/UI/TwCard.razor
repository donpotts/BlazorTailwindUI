<div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xs @(Hoverable ? "hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200" : "") overflow-hidden @Class">
    @if (HeaderContent is not null || !string.IsNullOrWhiteSpace(Title))
    {
        <div class="px-4 py-3.5 sm:px-6 sm:py-4 border-b border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
            <div>
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h3 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white">@Title</h3>
                }
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">@Subtitle</p>
                }
            </div>
            @HeaderContent
        </div>
    }

    <div class="@(NoPadding ? "" : "p-4 sm:p-6")">
        @ChildContent
    </div>

    @if (FooterContent is not null)
    {
        <div class="px-4 py-3 sm:px-6 sm:py-4 bg-slate-50/70 dark:bg-slate-950/40 border-t border-slate-100 dark:border-slate-800/80">
            @FooterContent
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool Hoverable { get; set; }
    [Parameter] public bool NoPadding { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public string? Class { get; set; }
}
