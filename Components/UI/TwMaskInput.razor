@namespace BlazorTailwindUI.Components.UI
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="btui-mask-input w-full space-y-1.5 @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
            @Label
        </label>
    }

    <div class="relative flex items-center">
        @if (!string.IsNullOrEmpty(PrefixIcon))
        {
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <span>@PrefixIcon</span>
            </div>
        }

        <input type="text"
               value="@_displayValue"
               @oninput="HandleInput"
               @onkeydown="HandleKeyDown"
               disabled="@Disabled"
               readonly="@ReadOnly"
               placeholder="@_placeholder"
               class="w-full @(string.IsNullOrEmpty(PrefixIcon) ? "pl-3" : "pl-9") pr-9 py-2 text-xs font-mono rounded-xl border transition @(string.IsNullOrEmpty(Error) ? "border-slate-300 dark:border-slate-700 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 bg-white dark:bg-slate-800 text-slate-900 dark:text-white" : "border-rose-500 focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 bg-rose-50/20 text-rose-900 dark:text-rose-200") disabled:opacity-50 disabled:cursor-not-allowed" />

        @if (!string.IsNullOrEmpty(Value) && !Disabled && !ReadOnly)
        {
            <button type="button"
                    @onclick="HandleClear"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="text-[11px] font-medium text-rose-600 dark:text-rose-400">@Error</p>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <p class="text-[11px] text-slate-500 dark:text-slate-400">@HelperText</p>
    }
</div>

@code {
    public enum MaskValueMode
    {
        Raw,
        WithFormatting
    }

    public enum MaskPreset
    {
        Custom,
        Phone,
        Ssn,
        CreditCard,
        Date,
        ZipCode
    }

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Mask { get; set; } = "(###) ###-####";
    [Parameter] public char Prompt { get; set; } = '_';
    [Parameter] public MaskValueMode ValueMode { get; set; } = MaskValueMode.Raw;
    [Parameter] public MaskPreset Preset { get; set; } = MaskPreset.Custom;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? PrefixIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string _displayValue = string.Empty;
    private string _placeholder = string.Empty;

    protected override void OnParametersSet()
    {
        ApplyPreset();
        ComputePlaceholder();
        _displayValue = FormatValue(Value);
    }

    private void ApplyPreset()
    {
        switch (Preset)
        {
            case MaskPreset.Phone:
                Mask = "(###) ###-####";
                if (string.IsNullOrEmpty(PrefixIcon)) PrefixIcon = "📞";
                break;
            case MaskPreset.Ssn:
                Mask = "###-##-####";
                if (string.IsNullOrEmpty(PrefixIcon)) PrefixIcon = "🪪";
                break;
            case MaskPreset.CreditCard:
                Mask = "#### #### #### ####";
                if (string.IsNullOrEmpty(PrefixIcon)) PrefixIcon = "💳";
                break;
            case MaskPreset.Date:
                Mask = "##/##/####";
                if (string.IsNullOrEmpty(PrefixIcon)) PrefixIcon = "📅";
                break;
            case MaskPreset.ZipCode:
                Mask = "#####-####";
                if (string.IsNullOrEmpty(PrefixIcon)) PrefixIcon = "📮";
                break;
        }
    }

    private void ComputePlaceholder()
    {
        var sb = new System.Text.StringBuilder();
        foreach (char c in Mask)
        {
            if (c == '#' || c == 'A' || c == '*')
                sb.Append(Prompt);
            else
                sb.Append(c);
        }
        _placeholder = sb.ToString();
    }

    private string FormatValue(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return string.Empty;
        var cleanRaw = StripLiterals(raw);
        var sb = new System.Text.StringBuilder();
        int rawIndex = 0;

        foreach (char m in Mask)
        {
            if (rawIndex >= cleanRaw.Length) break;

            if (m == '#' || m == 'A' || m == '*')
            {
                char ch = cleanRaw[rawIndex];
                if (IsValidChar(ch, m))
                {
                    sb.Append(ch);
                    rawIndex++;
                }
                else
                {
                    rawIndex++;
                }
            }
            else
            {
                sb.Append(m);
            }
        }
        return sb.ToString();
    }

    private string StripLiterals(string input)
    {
        var sb = new System.Text.StringBuilder();
        foreach (char c in input)
        {
            if (char.IsLetterOrDigit(c))
                sb.Append(c);
        }
        return sb.ToString();
    }

    private bool IsValidChar(char c, char maskSlot) => maskSlot switch
    {
        '#' => char.IsDigit(c),
        'A' => char.IsLetter(c),
        '*' => char.IsLetterOrDigit(c),
        _ => true
    };

    private async Task HandleInput(ChangeEventArgs e)
    {
        string rawInput = e.Value?.ToString() ?? string.Empty;
        string clean = StripLiterals(rawInput);
        _displayValue = FormatValue(clean);

        string outputVal = (ValueMode == MaskValueMode.Raw) ? clean : _displayValue;
        Value = outputVal;
        await ValueChanged.InvokeAsync(outputVal);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        // Special backspace handling for literal characters
    }

    private async Task HandleClear()
    {
        _displayValue = string.Empty;
        Value = string.Empty;
        await ValueChanged.InvokeAsync(string.Empty);
    }
}
