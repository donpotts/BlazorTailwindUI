<span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium @VariantClasses @Class">
    @if (ShowDot)
    {
        <span class="h-1.5 w-1.5 rounded-full @DotClasses"></span>
    }
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SemanticVariant Variant { get; set; } = SemanticVariant.Default;
    [Parameter] public bool ShowDot { get; set; }
    [Parameter] public string? Class { get; set; }

    private string VariantClasses => Variant switch
    {
        SemanticVariant.Primary => "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-100 ring-1 ring-inset ring-brand-500/30",
        SemanticVariant.Success => "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300 ring-1 ring-inset ring-emerald-500/30",
        SemanticVariant.Warning => "bg-amber-50 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300 ring-1 ring-inset ring-amber-500/30",
        SemanticVariant.Danger => "bg-rose-50 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300 ring-1 ring-inset ring-rose-500/30",
        SemanticVariant.Info => "bg-sky-50 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300 ring-1 ring-inset ring-sky-500/30",
        _ => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 ring-1 ring-inset ring-slate-500/20"
    };

    private string DotClasses => Variant switch
    {
        SemanticVariant.Primary => "bg-brand-500",
        SemanticVariant.Success => "bg-emerald-500",
        SemanticVariant.Warning => "bg-amber-500",
        SemanticVariant.Danger => "bg-rose-500",
        SemanticVariant.Info => "bg-sky-500",
        _ => "bg-slate-400"
    };
}
