<div class="inline-flex items-center gap-1 select-none @Class" role="radiogroup" aria-label="Rating">
    @for (int i = 1; i <= MaxStars; i++)
    {
        var starNumber = i;
        var isFilled = starNumber <= (HoverRating ?? Value);

        <button type="button"
                disabled="@ReadOnly"
                @onclick="() => SetRating(starNumber)"
                @onmouseenter="() => Hover(starNumber)"
                @onmouseleave="ClearHover"
                class="p-0.5 transition-transform duration-100 @(ReadOnly ? "cursor-default" : "hover:scale-110 cursor-pointer") focus:outline-none">
            <svg class="w-5 h-5 @(isFilled ? "text-amber-400 fill-amber-400" : "text-slate-300 dark:text-slate-700")"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
        </button>
    }

    @if (ShowValueText)
    {
        <span class="ml-2 text-xs font-semibold text-slate-600 dark:text-slate-400">
            @Value.ToString("0.0")
        </span>
    }
</div>

@code {
    [Parameter] public int Value { get; set; } = 4;
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int MaxStars { get; set; } = 5;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ShowValueText { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private int? HoverRating;

    private void Hover(int star)
    {
        if (!ReadOnly) HoverRating = star;
    }

    private void ClearHover()
    {
        if (!ReadOnly) HoverRating = null;
    }

    private async Task SetRating(int rating)
    {
        if (!ReadOnly)
        {
            Value = rating;
            await ValueChanged.InvokeAsync(rating);
        }
    }
}
