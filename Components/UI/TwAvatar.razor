<div class="relative inline-flex items-center justify-center shrink-0 rounded-full bg-brand-100 dark:bg-brand-500/20 text-brand-700 dark:text-brand-100 font-semibold select-none @SizeClasses @Class">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="@Alt" class="h-full w-full rounded-full object-cover" />
    }
    else
    {
        <span>@Initials</span>
    }

    @if (!string.IsNullOrWhiteSpace(StatusColor))
    {
        <span class="absolute bottom-0 right-0 block h-2.5 w-2.5 rounded-full ring-2 ring-white dark:ring-slate-900 @StatusColor"></span>
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string Initials { get; set; } = "UI";
    [Parameter] public string Alt { get; set; } = "Avatar";
    [Parameter] public ComponentSize Size { get; set; } = ComponentSize.Md;
    [Parameter] public string? StatusColor { get; set; }
    [Parameter] public string? Class { get; set; }

    private string SizeClasses => Size switch
    {
        ComponentSize.Xs => "h-7 w-7 text-xs",
        ComponentSize.Sm => "h-8 w-8 text-xs",
        ComponentSize.Lg => "h-12 w-12 text-base",
        _ => "h-10 w-10 text-sm"
    };
}
