@namespace BlazorTailwindUI.Components.UI

<div class="space-y-1.5 @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="flex items-center justify-between">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                @Label
            </label>
            @if (MaxTags.HasValue)
            {
                <span class="text-[10px] text-slate-400 font-mono">
                    @(Tags?.Count ?? 0) / @MaxTags
                </span>
            }
        </div>
    }

    <!-- Tags Container Box -->
    <div class="min-h-[44px] w-full p-1.5 rounded-xl border transition-all flex flex-wrap items-center gap-1.5 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20 @(Disabled ? "opacity-50 cursor-not-allowed" : "")">
        @if (Tags != null)
        {
            @foreach (var tag in Tags)
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-brand-50 dark:bg-brand-500/15 text-brand-700 dark:text-brand-300 border border-brand-500/20 animate-zoom-in">
                    <span>@tag</span>
                    @if (!Disabled)
                    {
                        <button type="button"
                                @onclick="() => RemoveTag(tag)"
                                class="p-0.5 rounded-full hover:bg-brand-200/50 dark:hover:bg-brand-500/30 text-brand-500 dark:text-brand-400 transition focus:outline-none"
                                aria-label="Remove tag @tag">
                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </span>
            }
        }

        <!-- Text Input Slot -->
        @if (!IsMaxReached && !Disabled)
        {
            <input type="text"
                   @bind="_currentInput"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   placeholder="@(Tags?.Any() == true ? "" : Placeholder)"
                   class="flex-1 min-w-[120px] bg-transparent border-0 px-2 py-1 text-xs sm:text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none" />
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
            @HelperText
        </p>
    }
</div>

@code {
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public EventCallback<List<string>> TagsChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Type tag and press Enter...";
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public int? MaxTags { get; set; }
    [Parameter] public bool AllowDuplicates { get; set; } = false;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private string _currentInput = "";

    private bool IsMaxReached => MaxTags.HasValue && (Tags?.Count ?? 0) >= MaxTags.Value;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == ",")
        {
            await AddCurrentTag();
        }
        else if (e.Key == "Backspace" && string.IsNullOrEmpty(_currentInput) && Tags?.Any() == true)
        {
            // Delete last tag
            var last = Tags.Last();
            await RemoveTag(last);
        }
    }

    private async Task AddCurrentTag()
    {
        var clean = _currentInput.Replace(",", "").Trim();
        if (string.IsNullOrWhiteSpace(clean))
        {
            _currentInput = "";
            return;
        }

        if (IsMaxReached) return;

        Tags ??= new List<string>();

        if (!AllowDuplicates && Tags.Contains(clean, StringComparer.OrdinalIgnoreCase))
        {
            _currentInput = "";
            return;
        }

        Tags.Add(clean);
        _currentInput = "";
        await TagsChanged.InvokeAsync(Tags);
    }

    private async Task RemoveTag(string tag)
    {
        if (Tags == null) return;
        if (Tags.Remove(tag))
        {
            await TagsChanged.InvokeAsync(Tags);
        }
    }
}
