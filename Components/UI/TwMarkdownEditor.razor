@namespace BlazorTailwindUI.Components.UI
@using System.Text.RegularExpressions
@using System.Text
@using System.IO
@using System.Net.Http
@using System.Net.Http.Headers
@using BlazorTailwindUI.Services
@using BlazorTailwindUI.Models
@using Microsoft.AspNetCore.Components.Forms
@inject OcrEngineService OcrEngine
@inject HttpClient Http
@inject ToastService Toast

<div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden flex flex-col transition-all @(_isFullscreen ? "fixed inset-4 z-50 shadow-2xl" : "max-w-6xl mx-auto") @CustomClass">
    <!-- Top Toolbar Header -->
    <div class="p-3 sm:p-4 bg-slate-50 dark:bg-slate-950/80 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        <!-- Left: Action & Mode Badges -->
        <div class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 font-bold text-sm">
                ✍️
            </span>
            <div>
                <div class="flex items-center gap-2">
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">@(Title ?? "Rich Markdown & Media Studio")</h3>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold @(_isHtmlMode ? "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" : "bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20")">
                        @(_isHtmlMode ? "HTML5 MODE" : "MARKDOWN GFM")
                    </span>
                </div>
                <p class="text-[11px] text-slate-400 hidden sm:block">Live WebAssembly Markdown &amp; HTML editor with multi-format media upload &amp; server API integration</p>
            </div>
        </div>

        <!-- Center / Right: View Mode & Fullscreen -->
        <div class="flex items-center gap-2">
            <!-- Mode Switcher: Markdown vs HTML -->
            <button type="button" @onclick="ToggleHtmlMode"
                    class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-850 text-slate-700 dark:text-slate-300 text-xs font-mono font-semibold hover:border-brand-500 transition shadow-xs"
                    title="Switch between Markdown and Raw HTML syntax">
                @(_isHtmlMode ? "Switch to Markdown" : "Switch to HTML")
            </button>

            <!-- Split / Edit / Preview View Toggles -->
            <div class="flex items-center bg-slate-200/60 dark:bg-slate-800 p-1 rounded-xl text-xs font-semibold">
                <button type="button" @onclick='() => _viewMode = "split"'
                        class="px-2.5 py-1 rounded-lg transition @(_viewMode == "split" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")"
                        title="Split Side-by-Side View">
                    Split ◫
                </button>
                <button type="button" @onclick='() => _viewMode = "edit"'
                        class="px-2.5 py-1 rounded-lg transition @(_viewMode == "edit" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")"
                        title="Editor Only">
                    Edit 📝
                </button>
                <button type="button" @onclick='() => _viewMode = "preview"'
                        class="px-2.5 py-1 rounded-lg transition @(_viewMode == "preview" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")"
                        title="Preview Only">
                    Preview 👁️
                </button>
            </div>

            <!-- Fullscreen Zen Mode -->
            <button type="button" @onclick="() => _isFullscreen = !_isFullscreen"
                    class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-850 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition shadow-xs"
                    title="@(_isFullscreen ? "Exit Fullscreen" : "Fullscreen Mode")">
                @if (_isFullscreen)
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"/></svg>
                }
            </button>
        </div>
    </div>

    <!-- Secondary Formatting & Media Bar -->
    <div class="px-3 sm:px-4 py-2 bg-slate-100/70 dark:bg-slate-950/40 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs">
        <!-- Formatting Buttons -->
        <div class="flex flex-wrap items-center gap-1">
            <button type="button" @onclick='() => WrapSelection("**", "**")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Bold (Ctrl+B)">B</button>
            <button type="button" @onclick='() => WrapSelection("*", "*")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 italic" title="Italic (Ctrl+I)">I</button>
            <button type="button" @onclick='() => WrapSelection("~~", "~~")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 line-through" title="Strikethrough">S</button>
            <span class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></span>

            <button type="button" @onclick='() => InsertAtCursor("# ")' class="px-2 py-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Heading 1">H1</button>
            <button type="button" @onclick='() => InsertAtCursor("## ")' class="px-2 py-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Heading 2">H2</button>
            <button type="button" @onclick='() => InsertAtCursor("### ")' class="px-2 py-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Heading 3">H3</button>
            <span class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></span>

            <button type="button" @onclick='() => InsertAtCursor("> ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Blockquote">❝ Quote</button>
            <button type="button" @onclick='() => InsertAtCursor("- ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Bullet List">• List</button>
            <button type="button" @onclick='() => InsertAtCursor("1. ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Numbered List">1. List</button>
            <button type="button" @onclick='() => InsertAtCursor("- [ ] ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Task Checklist">☑ Task</button>
            <button type="button" @onclick='() => WrapSelection("`", "`")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono" title="Inline Code">&lt;/&gt;</button>
            <button type="button" @onclick='() => InsertCodeBlock()' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono" title="Code Block">``` Block</button>
            <button type="button" @onclick='() => InsertTable()' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Insert Table">▦ Table</button>
        </div>

        <!-- Media Selector Trigger Buttons -->
        <div class="flex items-center gap-1.5 flex-wrap">
            <button type="button" @onclick='() => OpenMediaModal("image")'
                    class="px-2.5 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 font-semibold hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition flex items-center gap-1 shadow-xs"
                    title="Insert Image (PNG, JPG, SVG, WebP, GIF)">
                <span>🖼️</span>
                <span>Image</span>
            </button>
            <button type="button" @onclick='() => OpenMediaModal("video")'
                    class="px-2.5 py-1 rounded-lg bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800 text-purple-700 dark:text-purple-300 font-semibold hover:bg-purple-100 dark:hover:bg-purple-900/40 transition flex items-center gap-1 shadow-xs"
                    title="Insert Video (MP4, WebM, MOV)">
                <span>🎬</span>
                <span>Video (MP4)</span>
            </button>
            <button type="button" @onclick='() => OpenMediaModal("audio")'
                    class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 font-semibold hover:bg-emerald-100 dark:hover:bg-emerald-900/40 transition flex items-center gap-1 shadow-xs"
                    title="Insert Audio (WAV, MP3, AAC, OGG)">
                <span>🎵</span>
                <span>Audio (WAV)</span>
            </button>
            <button type="button" @onclick='() => OpenMediaModal("file")'
                    class="px-2.5 py-1 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 font-semibold hover:bg-amber-100 dark:hover:bg-amber-900/40 transition flex items-center gap-1 shadow-xs"
                    title="Insert Attachment or Document (PDF, ZIP, DOCX, XLSX)">
                <span>📁</span>
                <span>Any File / Doc</span>
            </button>
            <button type="button" @onclick='() => OpenMediaModal("link")'
                    class="px-2.5 py-1 rounded-lg bg-slate-200/80 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold hover:bg-slate-300 transition flex items-center gap-1 shadow-xs"
                    title="Insert Hyperlink">
                <span>🔗</span>
                <span>Link</span>
            </button>
            <button type="button" @onclick='() => _mediaModalType = "ocr"'
                    class="px-2.5 py-1 rounded-lg bg-teal-50 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800 text-teal-700 dark:text-teal-300 font-semibold hover:bg-teal-100 transition flex items-center gap-1 shadow-xs"
                    title="Scan Document OCR / Check MICR">
                <span>📄</span>
                <span>OCR</span>
            </button>
        </div>
    </div>

    <!-- Active Media Ingestion Drawer / Server API Uploader -->
    @if (!string.IsNullOrEmpty(_mediaModalType))
    {
        @if (_mediaModalType == "ocr")
        {
            <div class="p-4 bg-emerald-50/70 dark:bg-slate-850 border-b border-emerald-200 dark:border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 animate-fadeIn">
                <div class="flex items-center gap-3">
                    <span class="text-xl">📄</span>
                    <div>
                        <span class="text-xs font-bold text-slate-900 dark:text-white block uppercase tracking-wider">
                            Form / PDF OCR &amp; Check MICR Ingestion
                        </span>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Extract Check 21 MICR data, Invoices, or W-9 tax tables directly into markdown</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-1.5">
                    <button type="button" @onclick='() => InsertOcrPreset("check")'
                            class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 transition flex items-center gap-1">
                        <span>🏦</span>
                        <span>Check #1042 (MICR)</span>
                    </button>
                    <button type="button" @onclick='() => InsertOcrPreset("invoice")'
                            class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 transition flex items-center gap-1">
                        <span>🧾</span>
                        <span>Invoice #INV-88219</span>
                    </button>
                    <button type="button" @onclick='() => InsertOcrPreset("w9")'
                            class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 transition flex items-center gap-1">
                        <span>📑</span>
                        <span>IRS Form W-9</span>
                    </button>
                    <button type="button" @onclick='() => _mediaModalType = null'
                            class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs">
                        ✕
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="p-4 sm:p-5 bg-gradient-to-r from-slate-50 via-brand-50/30 to-indigo-50/40 dark:from-slate-900 dark:via-slate-850 dark:to-indigo-950/40 border-b border-brand-200 dark:border-slate-800 space-y-4 animate-fadeIn">
                <!-- Top Header with Type Selector & Close -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
                    <div class="flex items-center gap-2.5">
                        <span class="text-2xl p-2 rounded-2xl bg-white dark:bg-slate-800 shadow-xs border border-slate-200 dark:border-slate-700">
                            @GetMediaIcon(_mediaModalType)
                        </span>
                        <div>
                            <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                <span>Media Asset Selector &amp; Uploader</span>
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-mono font-bold uppercase bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
                                    @_mediaModalType.ToUpper()
                                </span>
                            </h4>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">
                                Select or upload assets to server API and insert into @(_isHtmlMode ? "HTML5" : "Markdown GFM") document
                            </p>
                        </div>
                    </div>

                    <!-- Asset Type Switcher Pills -->
                    <div class="flex items-center gap-1 bg-slate-200/60 dark:bg-slate-800/80 p-1 rounded-xl text-xs">
                        <button type="button" @onclick='() => SetMediaType("image")'
                                class="px-2 py-1 rounded-lg transition font-semibold flex items-center gap-1 @(_mediaModalType == "image" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400")">
                            <span>🖼️</span> Image
                        </button>
                        <button type="button" @onclick='() => SetMediaType("video")'
                                class="px-2 py-1 rounded-lg transition font-semibold flex items-center gap-1 @(_mediaModalType == "video" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400")">
                            <span>🎬</span> Video (MP4)
                        </button>
                        <button type="button" @onclick='() => SetMediaType("audio")'
                                class="px-2 py-1 rounded-lg transition font-semibold flex items-center gap-1 @(_mediaModalType == "audio" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400")">
                            <span>🎵</span> Audio (WAV)
                        </button>
                        <button type="button" @onclick='() => SetMediaType("file")'
                                class="px-2 py-1 rounded-lg transition font-semibold flex items-center gap-1 @(_mediaModalType == "file" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400")">
                            <span>📁</span> File
                        </button>
                        <button type="button" @onclick='() => _mediaModalType = null'
                                class="p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 ml-1" title="Close Drawer">
                            ✕
                        </button>
                    </div>
                </div>

                <!-- Source Selection Tabs: Upload to Server vs Sample Library vs Direct URL -->
                <div class="flex items-center gap-2 text-xs font-semibold border-b border-slate-200/80 dark:border-slate-800 pb-2">
                    <button type="button" @onclick='() => _mediaSourceTab = "upload"'
                            class="px-3 py-1.5 rounded-xl transition flex items-center gap-1.5 @(_mediaSourceTab == "upload" ? "bg-brand-600 text-white shadow-xs font-bold" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100")">
                        <span>📤</span> Upload to Server API
                    </button>
                    <button type="button" @onclick='() => _mediaSourceTab = "preset"'
                            class="px-3 py-1.5 rounded-xl transition flex items-center gap-1.5 @(_mediaSourceTab == "preset" ? "bg-brand-600 text-white shadow-xs font-bold" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100")">
                        <span>📚</span> Curated Sample Library
                    </button>
                    <button type="button" @onclick='() => _mediaSourceTab = "url"'
                            class="px-3 py-1.5 rounded-xl transition flex items-center gap-1.5 @(_mediaSourceTab == "url" ? "bg-brand-600 text-white shadow-xs font-bold" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100")">
                        <span>🌐</span> Direct URL / CDN
                    </button>
                </div>

                <!-- TAB CONTENT 1: UPLOAD TO SERVER API -->
                @if (_mediaSourceTab == "upload")
                {
                    <div class="space-y-4">
                        <!-- Drag & Drop / File Input Box -->
                        <div class="relative border-2 border-dashed border-brand-300 dark:border-brand-700 rounded-2xl p-5 text-center bg-white/70 dark:bg-slate-900/60 hover:border-brand-500 transition group cursor-pointer shadow-xs">
                            <InputFile OnChange="HandleFileSelected" accept="@GetAcceptedFileExtensions()"
                                       class="absolute inset-0 opacity-0 w-full h-full cursor-pointer z-10" />
                            <div class="flex flex-col items-center justify-center space-y-2 pointer-events-none">
                                <div class="w-12 h-12 rounded-2xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                                    @GetMediaIcon(_mediaModalType)
                                </div>
                                <div>
                                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">
                                        Click to browse or drag &amp; drop your @GetMediaTypeName(_mediaModalType)
                                    </span>
                                    <p class="text-[11px] text-slate-400">
                                        Supported formats: @GetSupportedExtensionsText(_mediaModalType) • Max size: 50MB
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Server API Endpoint Config & Status Indicator -->
                        <div class="p-3 rounded-xl bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                            <div class="flex items-center gap-2 flex-1">
                                <span class="font-mono text-slate-400 shrink-0">Server API:</span>
                                <input type="text" @bind="UploadApiUrl"
                                       class="flex-1 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white font-mono text-xs focus:ring-1 focus:ring-brand-500"
                                       placeholder="/api/media/upload" title="Server Upload Endpoint Target" />
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                @if (_isUploading)
                                {
                                    <span class="inline-flex items-center gap-1 text-brand-600 dark:text-brand-400 font-bold">
                                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                        <span>Transmitting (@_uploadProgress%)...</span>
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(_uploadStatusMessage))
                                {
                                    <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] font-bold @(_isUploadedToServer ? "bg-emerald-100 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700" : "bg-amber-100 text-amber-700")">
                                        @_uploadStatusMessage
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Upload Progress Bar -->
                        @if (_isUploading)
                        {
                            <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
                                <div class="bg-brand-500 h-2 transition-all duration-300" style="width: @(_uploadProgress)%"></div>
                            </div>
                        }
                    </div>
                }

                <!-- TAB CONTENT 2: CURATED SAMPLE PRESETS -->
                else if (_mediaSourceTab == "preset")
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 text-xs">
                        @if (_mediaModalType == "image")
                        {
                            <button type="button" @onclick='() => SetPresetMedia("https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1200&q=80", "Modern Developer Architecture")'
                                    class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-brand-500 text-left transition flex items-center gap-2">
                                <span class="text-xl">💻</span>
                                <div>
                                    <span class="font-bold text-slate-800 dark:text-slate-200 block">Cloud Architecture</span>
                                    <span class="text-[10px] text-slate-400 font-mono">1200x800 • Unsplash High-Res</span>
                                </div>
                            </button>
                            <button type="button" @onclick='() => SetPresetMedia("https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80", "Executive Financial Analytics")'
                                    class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-brand-500 text-left transition flex items-center gap-2">
                                <span class="text-xl">📊</span>
                                <div>
                                    <span class="font-bold text-slate-800 dark:text-slate-200 block">Analytics Dashboard</span>
                                    <span class="text-[10px] text-slate-400 font-mono">1200x800 • Financial Data</span>
                                </div>
                            </button>
                        }
                        else if (_mediaModalType == "video")
                        {
                            <button type="button" @onclick='() => SetPresetMedia("videos/demo-video.mp4", "1080p Video Masterclass Walkthrough")'
