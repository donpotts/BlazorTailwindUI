@namespace BlazorTailwindUI.Components.UI
@using System.Text.RegularExpressions
@using System.Text
@using BlazorTailwindUI.Services
@using BlazorTailwindUI.Models
@inject OcrEngineService OcrEngine

<div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden flex flex-col transition-all @(_isFullscreen ? "fixed inset-4 z-50 shadow-2xl" : "max-w-6xl mx-auto") @CustomClass">
    <!-- Top Toolbar Header -->
    <div class="p-3 sm:p-4 bg-slate-50 dark:bg-slate-950/80 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        <!-- Left: Action & Mode Badges -->
        <div class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 font-bold text-sm">
                ✍️
            </span>
            <div>
                <div class="flex items-center gap-2">
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">@(Title ?? "Rich Markdown & Media Studio")</h3>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold @(_isHtmlMode ? "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" : "bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20")">
                        @(_isHtmlMode ? "HTML5 MODE" : "MARKDOWN GFM")
                    </span>
                </div>
                <p class="text-[11px] text-slate-400 hidden sm:block">Live WebAssembly Markdown parser with image, video & audio embedding</p>
            </div>
        </div>

        <!-- Center / Right: View Mode & Fullscreen -->
        <div class="flex items-center gap-2">
            <!-- Mode Switcher: Markdown vs HTML -->
            <button type="button" @onclick="ToggleHtmlMode"
                    class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-850 text-slate-700 dark:text-slate-300 text-xs font-mono font-semibold hover:border-brand-500 transition shadow-xs"
                    title="Switch between Markdown and Raw HTML syntax">
                @(_isHtmlMode ? "Switch to Markdown" : "Switch to HTML")
            </button>

            <!-- Split / Edit / Preview View Toggles -->
            <div class="flex items-center bg-slate-200/60 dark:bg-slate-800 p-1 rounded-xl text-xs font-semibold">
                <button type="button" @onclick='() => _viewMode = "split"'
                        class="px-2.5 py-1 rounded-lg transition @(_viewMode == "split" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")"
                        title="Split Side-by-Side View">
                    Split ◫
                </button>
                <button type="button" @onclick='() => _viewMode = "edit"'
                        class="px-2.5 py-1 rounded-lg transition @(_viewMode == "edit" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")"
                        title="Editor Only">
                    Edit 📝
                </button>
                <button type="button" @onclick='() => _viewMode = "preview"'
                        class="px-2.5 py-1 rounded-lg transition @(_viewMode == "preview" ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")"
                        title="Preview Only">
                    Preview 👁️
                </button>
            </div>

            <!-- Fullscreen Zen Mode -->
            <button type="button" @onclick="() => _isFullscreen = !_isFullscreen"
                    class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-850 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition shadow-xs"
                    title="@(_isFullscreen ? "Exit Fullscreen" : "Fullscreen Mode")">
                @if (_isFullscreen)
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"/></svg>
                }
            </button>
        </div>
    </div>

    <!-- Secondary Formatting & Media Bar -->
    <div class="px-3 sm:px-4 py-2 bg-slate-100/70 dark:bg-slate-950/40 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs">
        <!-- Formatting Buttons -->
        <div class="flex flex-wrap items-center gap-1">
            <button type="button" @onclick='() => WrapSelection("**", "**")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Bold (Ctrl+B)">B</button>
            <button type="button" @onclick='() => WrapSelection("*", "*")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 italic" title="Italic (Ctrl+I)">I</button>
            <button type="button" @onclick='() => WrapSelection("~~", "~~")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 line-through" title="Strikethrough">S</button>
            <span class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></span>

            <button type="button" @onclick='() => InsertAtCursor("# ")' class="px-2 py-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Heading 1">H1</button>
            <button type="button" @onclick='() => InsertAtCursor("## ")' class="px-2 py-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Heading 2">H2</button>
            <button type="button" @onclick='() => InsertAtCursor("### ")' class="px-2 py-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold" title="Heading 3">H3</button>
            <span class="w-px h-4 bg-slate-300 dark:bg-slate-700 mx-1"></span>

            <button type="button" @onclick='() => InsertAtCursor("> ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Blockquote">❝ Quote</button>
            <button type="button" @onclick='() => InsertAtCursor("- ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Bullet List">• List</button>
            <button type="button" @onclick='() => InsertAtCursor("1. ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Numbered List">1. List</button>
            <button type="button" @onclick='() => InsertAtCursor("- [ ] ")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Task Checklist">☑ Task</button>
            <button type="button" @onclick='() => WrapSelection("`", "`")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono" title="Inline Code">&lt;/&gt;</button>
            <button type="button" @onclick='() => InsertAtCursor("\n```csharp\n// Code snippet\n```\n")' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono" title="Code Block">``` Block</button>
            <button type="button" @onclick='() => InsertTable()' class="p-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300" title="Insert Table">▦ Table</button>
        </div>

        <!-- Media Insertion Modal Trigger Buttons -->
        <div class="flex items-center gap-1.5">
            <button type="button" @onclick='() => _mediaModalType = "image"'
                    class="px-2.5 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 font-semibold hover:bg-indigo-100 transition flex items-center gap-1">
                <span>🖼️</span>
                <span>Image</span>
            </button>
            <button type="button" @onclick='() => _mediaModalType = "video"'
                    class="px-2.5 py-1 rounded-lg bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800 text-purple-700 dark:text-purple-300 font-semibold hover:bg-purple-100 transition flex items-center gap-1">
                <span>🎬</span>
                <span>Video</span>
            </button>
            <button type="button" @onclick='() => _mediaModalType = "audio"'
                    class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 font-semibold hover:bg-emerald-100 transition flex items-center gap-1">
                <span>🎵</span>
                <span>Audio</span>
            </button>
            <button type="button" @onclick='() => _mediaModalType = "link"'
                    class="px-2.5 py-1 rounded-lg bg-slate-200/80 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold hover:bg-slate-300 transition flex items-center gap-1">
                <span>🔗</span>
                <span>Link</span>
            </button>
            <button type="button" @onclick='() => _mediaModalType = "ocr"'
                    class="px-2.5 py-1 rounded-lg bg-teal-50 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800 text-teal-700 dark:text-teal-300 font-semibold hover:bg-teal-100 transition flex items-center gap-1">
                <span>📄</span>
                <span>OCR / MICR</span>
            </button>
        </div>
    </div>

    <!-- Active Media Ingestion Drawer / Modal -->
    @if (!string.IsNullOrEmpty(_mediaModalType))
    {
        @if (_mediaModalType == "ocr")
        {
            <div class="p-4 bg-emerald-50/70 dark:bg-slate-850 border-b border-emerald-200 dark:border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 animate-fadeIn">
                <div class="flex items-center gap-3">
                    <span class="text-xl">📄</span>
                    <div>
                        <span class="text-xs font-bold text-slate-900 dark:text-white block uppercase tracking-wider">
                            Form / PDF OCR & Check MICR Ingestion
                        </span>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Extract Check 21 MICR data, Invoices, or W-9 tax tables directly into markdown</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-1.5">
                    <button type="button" @onclick='() => InsertOcrPreset("check")'
                            class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 transition flex items-center gap-1">
                        <span>🏦</span>
                        <span>Check #1042 (MICR)</span>
                    </button>
                    <button type="button" @onclick='() => InsertOcrPreset("invoice")'
                            class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 transition flex items-center gap-1">
                        <span>🧾</span>
                        <span>Invoice #INV-88219</span>
                    </button>
                    <button type="button" @onclick='() => InsertOcrPreset("w9")'
                            class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-emerald-600 transition flex items-center gap-1">
                        <span>📑</span>
                        <span>IRS Form W-9</span>
                    </button>
                    <button type="button" @onclick='() => _mediaModalType = null'
                            class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs">
                        ✕
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="p-4 bg-brand-50/70 dark:bg-slate-850 border-b border-brand-200 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 animate-fadeIn">
            <div class="flex items-center gap-3 w-full sm:w-auto">
                <span class="text-xl">
                    @(_mediaModalType == "image" ? "🖼️" : _mediaModalType == "video" ? "🎬" : _mediaModalType == "audio" ? "🎵" : "🔗")
                </span>
                <div class="space-y-0.5 w-full sm:w-auto">
                    <span class="text-xs font-bold text-slate-900 dark:text-white block uppercase tracking-wider">
                        Insert @(_mediaModalType.ToUpper()) Asset
                    </span>
                    <input type="text" @bind="_mediaUrlInput" placeholder="@GetMediaPlaceholder()"
                           class="w-full sm:w-96 px-3 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs text-slate-900 dark:text-white font-mono focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
                </div>
                <div class="space-y-0.5 hidden md:block">
                    <span class="text-xs font-bold text-slate-900 dark:text-white block uppercase tracking-wider">Alt / Title</span>
                    <input type="text" @bind="_mediaAltInput" placeholder="Descriptive caption..."
                           class="w-48 px-3 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
                </div>
            </div>

            <!-- Quick Preset Gallery Selector for Fast Testing -->
            <div class="flex items-center gap-2 self-end sm:self-center">
                @if (_mediaModalType == "image")
                {
                    <button type="button" @onclick='() => SetPresetMedia("https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1200&q=80", "Modern Developer Architecture")'
                            class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 text-[11px] font-mono text-slate-600 dark:text-slate-300 hover:text-brand-500 border border-slate-200 dark:border-slate-700">
                        Unsplash Sample
                    </button>
                }
                else if (_mediaModalType == "video")
                {
                    <button type="button" @onclick='() => SetPresetMedia("videos/demo-video.mp4", "1080p Video Masterclass Walkthrough")'
                            class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 text-[11px] font-mono text-slate-600 dark:text-slate-300 hover:text-brand-500 border border-slate-200 dark:border-slate-700">
                        Masterclass Sample
                    </button>
                }

                <button type="button" @onclick="CommitMediaInsert"
                        class="px-3.5 py-1.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs transition shadow-sm">
                    Insert Media
                </button>
                <button type="button" @onclick='() => _mediaModalType = null'
                        class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs">
                    ✕
                </button>
            </div>
        </div>
        }
    }

    <!-- Main Workspace (Editor / Preview Grid) -->
    <div class="grid grid-cols-1 @(_viewMode == "split" ? "lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800" : "") flex-1 min-h-[460px]">
        <!-- 1. Text Area Editor Pane -->
        @if (_viewMode == "split" || _viewMode == "edit")
        {
            <div class="flex flex-col bg-white dark:bg-slate-900/60 p-4 relative group">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-mono">
                    <span>Source Editor</span>
                    <span>Line Count: @(Value?.Split('\n').Length ?? 1)</span>
                </div>
                <textarea @bind="Value"
                          @bind:event="oninput"
                          placeholder="Type Markdown or HTML here... Use the toolbar above to embed images, video, and audio."
                          class="w-full flex-1 p-3 font-mono text-xs sm:text-sm bg-transparent border-0 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none resize-none leading-relaxed min-h-[380px] selection:bg-brand-500/20"></textarea>
            </div>
        }

        <!-- 2. Rich Live Rendered Preview Pane -->
        @if (_viewMode == "split" || _viewMode == "preview")
        {
            <div class="flex flex-col bg-slate-50/50 dark:bg-slate-950/40 p-5 overflow-y-auto max-h-[580px]">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3 font-mono border-b border-slate-200 dark:border-slate-800 pb-2">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Live WebAssembly Render Preview</span>
                    </span>
                    <button type="button" @onclick="CopyHtml" class="hover:text-brand-500 transition">
                        @(_copied ? "Copied! ✓" : "Copy Rendered HTML")
                    </button>
                </div>

                <!-- Rendered Document Body with Tailwind Typography -->
                <article class="prose prose-sm sm:prose dark:prose-invert max-w-none prose-headings:font-black prose-headings:tracking-tight prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-img:rounded-2xl prose-img:shadow-lg prose-table:border prose-table:border-slate-200 dark:prose-table:border-slate-800 prose-th:bg-slate-100 dark:prose-th:bg-slate-850 prose-th:p-2 prose-td:p-2">
                    @((MarkupString)RenderMarkdownToHtml(Value))
                </article>
            </div>
        }
    </div>

    <!-- Bottom Status & Document Statistics Bar -->
    <div class="px-4 py-3 bg-slate-50 dark:bg-slate-950/80 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
        <!-- Word & Character Counters -->
        <div class="flex items-center gap-4">
            <span><strong>@GetWordCount()</strong> words</span>
            <span>•</span>
            <span><strong>@(Value?.Length ?? 0)</strong> chars</span>
            <span>•</span>
            <span>⏱️ <strong>~@GetReadingTime() min</strong> read</span>
        </div>

        <!-- Quick Document Actions -->
        <div class="flex items-center gap-2">
            <button type="button" @onclick="CopyMarkdown"
                    class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 text-slate-700 dark:text-slate-300 font-semibold transition">
                Copy Raw Markdown
            </button>
            <button type="button" @onclick="ResetToSample"
                    class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 text-slate-700 dark:text-slate-300 font-semibold transition">
                Reset Sample
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string CustomClass { get; set; } = "";

    private string _viewMode = "split"; // split | edit | preview
    private bool _isHtmlMode = false;
    private bool _isFullscreen = false;
    private bool _copied = false;
    private string? _mediaModalType; // image | video | audio | link
    private string _mediaUrlInput = "";
    private string _mediaAltInput = "";

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Value))
        {
            Value = GetDefaultSampleContent();
        }
    }

    private void ToggleHtmlMode()
    {
        _isHtmlMode = !_isHtmlMode;
    }

    private void WrapSelection(string prefix, string suffix)
    {
        Value = $"{Value}\n{prefix}Selected Text{suffix}";
        NotifyChanged();
    }

    private void InsertAtCursor(string snippet)
    {
        Value = $"{Value}\n{snippet}";
        NotifyChanged();
    }

    private void InsertTable()
    {
        var table = "\n| Component | Architecture | Status |\n|---|---|---|\n| TwDataGrid | Virtualized WASM | Production |\n| TwMarkdownEditor | Media-Ready WYSIWYG | Active |\n";
        InsertAtCursor(table);
    }

    private async Task InsertOcrPreset(string type)
    {
        string md;
        if (type == "check")
        {
            var check = await OcrEngine.ScanCheckOrDraftAsync("check-payroll-1042");
            md = "\n" + OcrEngine.GenerateCheckMarkdown(check) + "\n";
        }
        else if (type == "invoice")
        {
            var inv = await OcrEngine.ScanDocumentAsync(OcrDocumentType.CommercialInvoice);
            md = "\n### 🧾 Extracted Commercial Invoice: " + inv.Title + "\n\n" + inv.MarkdownTableRepresentation + "\n";
        }
        else
        {
            var w9 = await OcrEngine.ScanDocumentAsync(OcrDocumentType.TaxFormW9);
            md = "\n### 📑 IRS Form W-9 Verification Report\n\n" + w9.MarkdownTableRepresentation + "\n";
        }

        InsertAtCursor(md);
        _mediaModalType = null;
    }

    private string GetMediaPlaceholder() => _mediaModalType switch
    {
        "image" => "https://example.com/asset.png or /images/logo.png",
        "video" => "videos/demo-video.mp4 or https://example.com/video.mp4",
        "audio" => "audio/sample.mp3 or https://example.com/sound.mp3",
        _ => "https://example.com"
    };

    private void SetPresetMedia(string url, string alt)
    {
        _mediaUrlInput = url;
        _mediaAltInput = alt;
    }

    private void CommitMediaInsert()
    {
        if (string.IsNullOrWhiteSpace(_mediaUrlInput)) return;

        var alt = string.IsNullOrWhiteSpace(_mediaAltInput) ? "Media Asset" : _mediaAltInput;

        if (_isHtmlMode)
        {
            if (_mediaModalType == "image")
            {
                InsertAtCursor($"<img src=\"{_mediaUrlInput}\" alt=\"{alt}\" class=\"rounded-2xl shadow-xl max-w-full my-4\" />");
            }
            else if (_mediaModalType == "video")
            {
                InsertAtCursor($"<video controls src=\"{_mediaUrlInput}\" class=\"w-full rounded-2xl shadow-xl my-4 aspect-video bg-black\"></video>");
            }
            else if (_mediaModalType == "audio")
            {
                InsertAtCursor($"<audio controls src=\"{_mediaUrlInput}\" class=\"w-full my-3\"></audio>");
            }
            else
            {
                InsertAtCursor($"<a href=\"{_mediaUrlInput}\" target=\"_blank\" class=\"text-brand-600 font-bold hover:underline\">{alt}</a>");
            }
        }
        else
        {
            if (_mediaModalType == "image")
            {
                InsertAtCursor($"![{alt}]({_mediaUrlInput})");
            }
            else if (_mediaModalType == "video")
            {
                InsertAtCursor($"<video controls src=\"{_mediaUrlInput}\" class=\"w-full rounded-2xl shadow-xl my-4 aspect-video bg-black\"></video>\n*Caption: {alt}*");
            }
            else if (_mediaModalType == "audio")
            {
                InsertAtCursor($"<audio controls src=\"{_mediaUrlInput}\" class=\"w-full my-3\"></audio>\n*Audio Track: {alt}*");
            }
            else
            {
                InsertAtCursor($"[{alt}]({_mediaUrlInput})");
            }
        }

        _mediaModalType = null;
        _mediaUrlInput = "";
        _mediaAltInput = "";
    }

    private async Task CopyMarkdown()
    {
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }

    private async Task CopyHtml()
    {
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }

    private void ResetToSample()
    {
        Value = GetDefaultSampleContent();
        NotifyChanged();
    }

    private void NotifyChanged()
    {
        ValueChanged.InvokeAsync(Value);
    }

    private int GetWordCount()
    {
        if (string.IsNullOrWhiteSpace(Value)) return 0;
        return Value.Split(new[] { ' ', '\r', '\n', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private int GetReadingTime()
    {
        var words = GetWordCount();
        return Math.Max(1, (int)Math.Ceiling(words / 200.0));
    }

    // High-Speed Pure C# WebAssembly Markdown-to-HTML Parser
    public static string RenderMarkdownToHtml(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "<p class=\"text-slate-400 italic\">Document is empty. Start typing above...</p>";

        var sb = new StringBuilder();
        var lines = markdown.Split('\n');
        bool inCodeBlock = false;
        string codeBlockLang = "";
        var codeContent = new StringBuilder();

        bool inTable = false;
        bool tableHeaderDone = false;

        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd('\r');

            // Code block delimiter
            if (line.TrimStart().StartsWith("```"))
            {
                if (!inCodeBlock)
                {
                    inCodeBlock = true;
                    codeBlockLang = line.Trim().Substring(3).Trim();
                    codeContent.Clear();
                    continue;
                }
                else
                {
                    inCodeBlock = false;
                    sb.AppendLine($"<div class=\"my-4 rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden shadow-lg\">");
                    if (!string.IsNullOrEmpty(codeBlockLang))
                    {
                        sb.AppendLine($"<div class=\"px-4 py-1.5 bg-slate-950 text-[10px] font-mono text-slate-400 uppercase font-bold border-b border-slate-800\">{System.Net.WebUtility.HtmlEncode(codeBlockLang)}</div>");
                    }
                    sb.AppendLine($"<pre class=\"p-4 text-xs font-mono text-slate-100 overflow-x-auto m-0\"><code>{System.Net.WebUtility.HtmlEncode(codeContent.ToString())}</code></pre>");
                    sb.AppendLine($"</div>");
                    continue;
                }
            }

            if (inCodeBlock)
            {
                codeContent.AppendLine(line);
                continue;
            }

            // Tables (| Column | Column |)
            if (line.TrimStart().StartsWith("|") && line.TrimEnd().EndsWith("|"))
            {
                var cells = line.Split('|', StringSplitOptions.RemoveEmptyEntries);
                if (line.Contains("---"))
                {
                    tableHeaderDone = true;
                    continue;
                }

                if (!inTable)
                {
                    inTable = true;
                    tableHeaderDone = false;
                    sb.AppendLine("<div class=\"overflow-x-auto my-4\"><table class=\"w-full text-left text-xs border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\">");
                }

                if (!tableHeaderDone)
                {
                    sb.AppendLine("<thead class=\"bg-slate-100 dark:bg-slate-800 font-bold text-slate-900 dark:text-white\"><tr>");
                    foreach (var c in cells) sb.AppendLine($"<th class=\"p-3 border-b border-slate-200 dark:border-slate-700\">{FormatInline(c.Trim())}</th>");
                    sb.AppendLine("</tr></thead><tbody>");
                }
                else
                {
                    sb.AppendLine("<tr class=\"border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50/50 dark:hover:bg-slate-850/50 transition\">");
                    foreach (var c in cells) sb.AppendLine($"<td class=\"p-3\">{FormatInline(c.Trim())}</td>");
                    sb.AppendLine("</tr>");
                }
                continue;
            }
            else if (inTable)
            {
                inTable = false;
                sb.AppendLine("</tbody></table></div>");
            }

            // HTML media passthrough (<video ...>, <audio ...>, <img ...>)
            if (line.TrimStart().StartsWith("<video") || line.TrimStart().StartsWith("<audio") || (line.TrimStart().StartsWith("<img") && !line.Contains("![alt]")))
            {
                sb.AppendLine(line);
                continue;
            }

            // Headings
            if (line.StartsWith("### "))
            {
                sb.AppendLine($"<h3 class=\"text-lg font-bold text-slate-900 dark:text-white mt-5 mb-2\">{FormatInline(line.Substring(4))}</h3>");
            }
            else if (line.StartsWith("## "))
            {
                sb.AppendLine($"<h2 class=\"text-xl font-black text-slate-900 dark:text-white mt-6 mb-2 border-b border-slate-100 dark:border-slate-800 pb-1.5\">{FormatInline(line.Substring(3))}</h2>");
            }
            else if (line.StartsWith("# "))
            {
                sb.AppendLine($"<h1 class=\"text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mt-6 mb-3\">{FormatInline(line.Substring(2))}</h1>");
            }
            // Blockquotes & Alerts
            else if (line.StartsWith("> "))
            {
                var quoteText = line.Substring(2);
                if (quoteText.StartsWith("[!NOTE]"))
                {
                    sb.AppendLine($"<div class=\"p-4 my-3 rounded-2xl bg-blue-50 dark:bg-blue-950/30 border-l-4 border-blue-500 text-blue-900 dark:text-blue-200 text-xs\"><strong class=\"font-bold block mb-1\">NOTE</strong>{FormatInline(quoteText.Replace("[!NOTE]", "").Trim())}</div>");
                }
                else if (quoteText.StartsWith("[!TIP]"))
                {
                    sb.AppendLine($"<div class=\"p-4 my-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border-l-4 border-emerald-500 text-emerald-900 dark:text-emerald-200 text-xs\"><strong class=\"font-bold block mb-1\">TIP</strong>{FormatInline(quoteText.Replace("[!TIP]", "").Trim())}</div>");
                }
                else if (quoteText.StartsWith("[!IMPORTANT]"))
                {
                    sb.AppendLine($"<div class=\"p-4 my-3 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border-l-4 border-amber-500 text-amber-900 dark:text-amber-200 text-xs\"><strong class=\"font-bold block mb-1\">IMPORTANT</strong>{FormatInline(quoteText.Replace("[!IMPORTANT]", "").Trim())}</div>");
                }
                else
                {
                    sb.AppendLine($"<blockquote class=\"border-l-4 border-brand-500 pl-4 py-1 my-3 text-slate-600 dark:text-slate-300 italic\">{FormatInline(quoteText)}</blockquote>");
                }
            }
            // Horizontal rule
            else if (line.Trim() == "---" || line.Trim() == "***")
            {
                sb.AppendLine("<hr class=\"my-6 border-slate-200 dark:border-slate-800\" />");
            }
            // Checklist item
            else if (line.StartsWith("- [ ] ") || line.StartsWith("- [x] "))
            {
                var isChecked = line.StartsWith("- [x] ");
                var checkText = line.Substring(6);
                sb.AppendLine($"<div class=\"flex items-center gap-2.5 my-1.5 text-xs text-slate-700 dark:text-slate-300\"><input type=\"checkbox\" {(isChecked ? "checked" : "")} disabled class=\"rounded text-brand-600 h-4 w-4\" /><span class=\"{(isChecked ? "line-through opacity-70" : "")}\">{FormatInline(checkText)}</span></div>");
            }
            // Bullet list
            else if (line.StartsWith("- ") || line.StartsWith("* "))
            {
                sb.AppendLine($"<li class=\"ml-4 list-disc text-slate-700 dark:text-slate-300 my-1\">{FormatInline(line.Substring(2))}</li>");
            }
            // Paragraph or empty line
            else if (string.IsNullOrWhiteSpace(line))
            {
                sb.AppendLine("<div class=\"h-2\"></div>");
            }
            else
            {
                sb.AppendLine($"<p class=\"text-slate-700 dark:text-slate-300 leading-relaxed my-2\">{FormatInline(line)}</p>");
            }
        }

        if (inTable)
        {
            sb.AppendLine("</tbody></table></div>");
        }

        return sb.ToString();
    }

    private static string FormatInline(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";

        // Images: ![alt](url)
        input = Regex.Replace(input, @"!\[(.*?)\]\((.*?)\)", "<figure class=\"my-4\"><img src=\"$2\" alt=\"$1\" class=\"rounded-2xl shadow-xl max-w-full h-auto border border-slate-200 dark:border-slate-800\" /><figcaption class=\"text-center text-[11px] font-mono text-slate-400 mt-2\">$1</figcaption></figure>");

        // Links: [text](url)
        input = Regex.Replace(input, @"\[(.*?)\]\((.*?)\)", "<a href=\"$2\" target=\"_blank\" class=\"text-brand-600 dark:text-brand-400 font-bold hover:underline\">$1</a>");

        // Bold: **text**
        input = Regex.Replace(input, @"\*\*(.*?)\*\*", "<strong>$1</strong>");

        // Italic: *text*
        input = Regex.Replace(input, @"\*(.*?)\*", "<em>$1</em>");

        // Strikethrough: ~~text~~
        input = Regex.Replace(input, @"~~(.*?)~~", "<del>$1</del>");

        // Inline Code: `code`
        input = Regex.Replace(input, @"`([^`]+)`", "<code class=\"px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-brand-600 dark:text-brand-400 font-mono text-[11px]\">$1</code>");

        return input;
    }

