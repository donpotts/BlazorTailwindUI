                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" @bind="_videoLoop" class="rounded text-brand-600 w-3.5 h-3.5" />
                                <span class="font-semibold text-slate-700 dark:text-slate-300">Loop</span>
