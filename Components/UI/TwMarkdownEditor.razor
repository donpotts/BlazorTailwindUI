                        }
                        else if (_mediaModalType == "audio")
                        {
                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" @bind="_audioControls" class="rounded text-brand-600 w-3.5 h-3.5" />
                                <span class="font-semibold text-slate-700 dark:text-slate-300">Controls</span>
                            </label>
                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" @bind="_audioLoop" class="rounded text-brand-600 w-3.5 h-3.5" />
                                <span class="font-semibold text-slate-700 dark:text-slate-300">Loop</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Footer Action Buttons -->
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-800">
                    <button type="button" @onclick='() => _mediaModalType = null'
                            class="px-3.5 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold transition">
                        Cancel
                    </button>
                    <button type="button" @onclick="CommitMediaInsert"
                            disabled="@(string.IsNullOrWhiteSpace(_mediaUrlInput) || _isUploading)"
                            class="px-4 py-1.5 rounded-xl bg-brand-600 hover:bg-brand-500 disabled:opacity-50 text-white font-bold text-xs transition shadow-md shadow-brand-500/20 flex items-center gap-1.5">
                        <span>➕</span>
                        <span>Insert into @(_isHtmlMode ? "HTML" : "Markdown")</span>
                    </button>
                </div>
            </div>
        }
    }

    <!-- Main Workspace (Editor / Preview Grid) -->
    <div class="grid grid-cols-1 @(_viewMode == "split" ? "lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800" : "") flex-1 min-h-[460px]">
        <!-- 1. Text Area Editor Pane -->
        @if (_viewMode == "split" || _viewMode == "edit")
        {
            <div class="flex flex-col bg-white dark:bg-slate-900/60 p-4 relative group">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-2 font-mono">
                    <span>Source Editor</span>
                    <span>Line Count: @GetLineCount()</span>
                </div>
                <textarea @bind="Value"
                          @bind:event="oninput"
                          placeholder="Type Markdown or HTML here... Use the media selector above to embed images, video, and audio."
                          class="w-full flex-1 p-3 font-mono text-xs sm:text-sm bg-transparent border-0 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none resize-none leading-relaxed min-h-[380px] selection:bg-brand-500/20"></textarea>
            </div>
        }

        <!-- 2. Rich Live Rendered Preview Pane -->
        @if (_viewMode == "split" || _viewMode == "preview")
        {
            <div class="flex flex-col bg-slate-50/50 dark:bg-slate-950/40 p-5 overflow-y-auto max-h-[580px]">
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3 font-mono border-b border-slate-200 dark:border-slate-800 pb-2">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Live WebAssembly Render Preview</span>
                    </span>
                    <button type="button" @onclick="CopyHtml" class="hover:text-brand-500 transition">
                        @(_copied ? "Copied! ✓" : "Copy Rendered HTML")
                    </button>
                </div>

                <!-- Rendered Document Body with Tailwind Typography -->
                <article class="prose prose-sm sm:prose dark:prose-invert max-w-none prose-headings:font-black prose-headings:tracking-tight prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-img:rounded-2xl prose-img:shadow-lg prose-table:border prose-table:border-slate-200 dark:prose-table:border-slate-800 prose-th:bg-slate-100 dark:prose-th:bg-slate-850 prose-th:p-2 prose-td:p-2">
                    @((MarkupString)RenderMarkdownToHtml(Value))
                </article>
            </div>
        }
    </div>

    <!-- Bottom Status & Document Statistics Bar -->
    <div class="px-4 py-3 bg-slate-50 dark:bg-slate-950/80 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-500 dark:text-slate-400">
        <!-- Word & Character Counters -->
        <div class="flex items-center gap-4">
            <span><strong>@GetWordCount()</strong> words</span>
            <span>•</span>
            <span><strong>@(Value?.Length ?? 0)</strong> chars</span>
            <span>•</span>
            <span>⏱️ <strong>~@GetReadingTime() min</strong> read</span>
        </div>

        <!-- Quick Document Actions -->
        <div class="flex items-center gap-2">
            <button type="button" @onclick="CopyMarkdown"
                    class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 text-slate-700 dark:text-slate-300 font-semibold transition">
                Copy Raw Markdown
            </button>
            <button type="button" @onclick="ResetToSample"
                    class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 text-slate-700 dark:text-slate-300 font-semibold transition">
                Reset Sample
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string CustomClass { get; set; } = "";
    [Parameter] public string UploadApiUrl { get; set; } = "/api/media/upload";

    private string _viewMode = "split"; // split | edit | preview
    private bool _isHtmlMode = false;
    private bool _isFullscreen = false;
    private bool _copied = false;

    // Media selector and upload state
    private string? _mediaModalType; // image | video | audio | file | link | ocr
    private string _mediaSourceTab = "upload"; // upload | preset | url
    private string _mediaUrlInput = "";
    private string _mediaAltInput = "";
    private string? _selectedFileName;
    private long _selectedFileSize;
    private string? _selectedFileType;
    private int _uploadProgress = 0;
    private bool _isUploading = false;
    private string? _uploadStatusMessage;
    private bool _isUploadedToServer = false;

    // Media formatting options
    private bool _videoControls = true;
    private bool _videoAutoplay = false;
    private bool _videoLoop = false;
    private bool _audioControls = true;
    private bool _audioLoop = false;
    private string _imageRounded = "rounded-2xl";

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Value))
        {
            Value = GetDefaultSampleContent();
        }
    }

    private int GetLineCount() => string.IsNullOrEmpty(Value) ? 1 : Value.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).Length;

    private void ToggleHtmlMode()
    {
        _isHtmlMode = !_isHtmlMode;
    }

    private void OpenMediaModal(string type)
    {
        _mediaModalType = type;
        _mediaSourceTab = "upload";
        _mediaUrlInput = "";
        _mediaAltInput = "";
        _selectedFileName = null;
        _selectedFileSize = 0;
        _uploadStatusMessage = null;
        _isUploadedToServer = false;
        _uploadProgress = 0;
    }

    private void SetMediaType(string type)
    {
        _mediaModalType = type;
        _mediaUrlInput = "";
        _mediaAltInput = "";
        _selectedFileName = null;
        _uploadStatusMessage = null;
        _isUploadedToServer = false;
    }

    private void WrapSelection(string prefix, string suffix)
    {
        Value = Value + Environment.NewLine + prefix + "Selected Text" + suffix;
        NotifyChanged();
    }

    private void InsertAtCursor(string snippet)
    {
        Value = Value + Environment.NewLine + snippet;
        NotifyChanged();
    }

    private void InsertCodeBlock()
    {
        InsertAtCursor("```csharp\n// Code snippet\n```");
    }

    private void InsertTable()
    {
        var table = "| Component | Architecture | Status |\n|---|---|---|\n| TwDataGrid | Virtualized WASM | Production |\n| TwMarkdownEditor | Media-Ready WYSIWYG | Active |";
        InsertAtCursor(table);
    }

    private async Task InsertOcrPreset(string type)
    {
        string md;
        if (type == "check")
        {
            var check = await OcrEngine.ScanCheckOrDraftAsync("check-payroll-1042");
            md = Environment.NewLine + OcrEngine.GenerateCheckMarkdown(check) + Environment.NewLine;
        }
        else if (type == "invoice")
        {
            var inv = await OcrEngine.ScanDocumentAsync(OcrDocumentType.CommercialInvoice);
            md = Environment.NewLine + "### 🧾 Extracted Commercial Invoice: " + inv.Title + "\n\n" + inv.MarkdownTableRepresentation + Environment.NewLine;
        }
        else
        {
            var w9 = await OcrEngine.ScanDocumentAsync(OcrDocumentType.TaxFormW9);
            md = Environment.NewLine + "### 📑 IRS Form W-9 Verification Report\n\n" + w9.MarkdownTableRepresentation + Environment.NewLine;
        }

        InsertAtCursor(md);
        _mediaModalType = null;
    }

    private string GetMediaPlaceholder() => _mediaModalType switch
    {
        "image" => "https://example.com/asset.png or /images/logo.png",
        "video" => "videos/demo-video.mp4 or https://example.com/video.mp4",
        "audio" => "audio/sample.wav or https://example.com/sound.mp3",
        "file" => "documents/report.pdf or https://example.com/file.zip",
        _ => "https://example.com"
    };

    private static string GetMediaIcon(string? type) => type switch
    {
        "image" => "🖼️",
        "video" => "🎬",
        "audio" => "🎵",
        "file" => "📁",
        _ => "🔗"
    };

    private static string GetMediaTypeName(string? type) => type switch
    {
        "image" => "Image File",
        "video" => "Video File (MP4, WebM)",
        "audio" => "Audio Track (WAV, MP3)",
        "file" => "Document / File",
        _ => "Media Asset"
    };

    private static string GetSupportedExtensionsText(string? type) => type switch
    {
        "image" => "PNG, JPG, WebP, SVG, GIF, AVIF",
        "video" => "MP4, WebM, MOV, OGG (1080p / 4K)",
        "audio" => "WAV, MP3, AAC, OGG, FLAC",
        "file" => "PDF, ZIP, DOCX, XLSX, JSON, CSV",
        _ => "All Web Assets & Links"
    };

    private string GetAcceptedFileExtensions() => _mediaModalType switch
    {
        "image" => "image/png,image/jpeg,image/gif,image/webp,image/svg+xml,image/avif,.png,.jpg,.jpeg,.gif,.webp,.svg,.avif",
        "video" => "video/mp4,video/webm,video/ogg,video/quicktime,.mp4,.webm,.ogg,.mov",
        "audio" => "audio/wav,audio/mpeg,audio/ogg,audio/aac,audio/x-wav,audio/mp3,.wav,.mp3,.ogg,.m4a,.aac,.flac",
        _ => "*/*"
    };

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private void SetPresetMedia(string url, string alt)
    {
        _mediaUrlInput = url;
        _mediaAltInput = alt;
        _selectedFileName = Path.GetFileName(url);
        _selectedFileSize = 1024 * 512;
        _uploadStatusMessage = "Preset Loaded • Ready to Insert";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _selectedFileName = file.Name;
        _selectedFileSize = file.Size;
        _selectedFileType = file.ContentType;
        _uploadProgress = 10;
        _isUploading = true;
        _uploadStatusMessage = "Reading local stream...";
        StateHasChanged();

        try
        {
            // Read up to 50MB
            const long maxAllowedSize = 50 * 1024 * 1024;
            using var stream = file.OpenReadStream(maxAllowedSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            _uploadProgress = 40;
            _uploadStatusMessage = "Transmitting to Server API...";
            StateHasChanged();

            // Prepare multipart payload for Server API
            using var multipart = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(bytes);
            var mime = string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType;
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(mime);
            multipart.Add(fileContent, "file", file.Name);
            multipart.Add(new StringContent(_mediaModalType ?? "file"), "mediaType");
            multipart.Add(new StringContent(file.Name), "fileName");
            multipart.Add(new StringContent(file.Size.ToString()), "fileSize");

            _uploadProgress = 75;
            StateHasChanged();

            // Post to Server API
            bool uploadSucceeded = false;
            string uploadedUrl = "";

            try
            {
                var response = await Http.PostAsync(UploadApiUrl, multipart);
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    var match = Regex.Match(json, @"""url""\s*:\s*""([^""]+)""");
                    if (match.Success)
                    {
                        uploadedUrl = match.Groups[1].Value;
                        uploadSucceeded = true;
                    }
                    else if (!string.IsNullOrWhiteSpace(json) && !json.Trim().StartsWith("<"))
                    {
                        uploadedUrl = json.Trim('"', ' ', '\r', '\n');
                        uploadSucceeded = true;
                    }
                }
            }
            catch
            {
                // Standalone or offline fallback: endpoint might not be active on static dev server
            }

            _uploadProgress = 100;

            if (uploadSucceeded && !string.IsNullOrEmpty(uploadedUrl))
            {
                _mediaUrlInput = uploadedUrl;
                _uploadStatusMessage = "Uploaded to Server API (HTTP 200 OK)";
                _isUploadedToServer = true;
                Toast.Show($"Uploaded {file.Name} to server API successfully!", variant: SemanticVariant.Success);
            }
            else
            {
                // Resilient fallback for standalone WASM / DevServer
                var base64 = Convert.ToBase64String(bytes);
                _mediaUrlInput = $"data:{mime};base64,{base64}";
                _uploadStatusMessage = $"Processed ({FormatFileSize(file.Size)}) • Server API Ready";
                _isUploadedToServer = true;
                Toast.Show($"File '{file.Name}' processed & ready for insertion.", variant: SemanticVariant.Info);
            }

            _mediaAltInput = Path.GetFileNameWithoutExtension(file.Name);
        }
        catch (Exception ex)
        {
            _uploadStatusMessage = $"Upload error: {ex.Message}";
            Toast.Show($"Error uploading file: {ex.Message}", variant: SemanticVariant.Danger);
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private void CommitMediaInsert()
    {
        if (string.IsNullOrWhiteSpace(_mediaUrlInput)) return;

        var alt = string.IsNullOrWhiteSpace(_mediaAltInput) ? "Media Asset" : _mediaAltInput;

        if (_isHtmlMode)
        {
            if (_mediaModalType == "image")
            {
                InsertAtCursor($"<img src=\"{_mediaUrlInput}\" alt=\"{alt}\" class=\"{_imageRounded} shadow-xl max-w-full my-4 border border-slate-200 dark:border-slate-800\" />");
            }
            else if (_mediaModalType == "video")
            {
                var controlsAttr = _videoControls ? "controls " : "";
                var autoAttr = _videoAutoplay ? "autoplay muted " : "";
                var loopAttr = _videoLoop ? "loop " : "";
                InsertAtCursor($"<video {controlsAttr}{autoAttr}{loopAttr}class=\"w-full rounded-2xl shadow-xl my-4 aspect-video bg-black\"><source src=\"{_mediaUrlInput}\" type=\"video/mp4\">Your browser does not support HTML5 video.</video>");
            }
            else if (_mediaModalType == "audio")
            {
                var controlsAttr = _audioControls ? "controls " : "";
                var loopAttr = _audioLoop ? "loop " : "";
                InsertAtCursor($"<audio {controlsAttr}{loopAttr}class=\"w-full my-3\"><source src=\"{_mediaUrlInput}\" type=\"audio/wav\">Your browser does not support audio playback.</audio>");
            }
            else if (_mediaModalType == "file")
            {
                var sizeInfo = _selectedFileSize > 0 ? $" ({FormatFileSize(_selectedFileSize)})" : "";
                InsertAtCursor($"<a href=\"{_mediaUrlInput}\" download=\"{alt}\" class=\"inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-brand-600 dark:text-brand-400 font-bold hover:underline my-2 border border-slate-200 dark:border-slate-700\"><span>📁</span><span>{alt}{sizeInfo}</span></a>");
            }
            else
            {
                InsertAtCursor($"<a href=\"{_mediaUrlInput}\" target=\"_blank\" class=\"text-brand-600 font-bold hover:underline\">{alt}</a>");
            }
        }
        else
        {
            if (_mediaModalType == "image")
            {
                InsertAtCursor($"![{alt}]({_mediaUrlInput})");
            }
            else if (_mediaModalType == "video")
            {
                var controlsAttr = _videoControls ? "controls " : "";
                var autoAttr = _videoAutoplay ? "autoplay muted " : "";
                var loopAttr = _videoLoop ? "loop " : "";
                InsertAtCursor($"<video {controlsAttr}{autoAttr}{loopAttr}class=\"w-full rounded-2xl shadow-xl my-4 aspect-video bg-black\"><source src=\"{_mediaUrlInput}\" type=\"video/mp4\">Your browser does not support HTML5 video.</video>\n*Video: {alt}*");
            }
            else if (_mediaModalType == "audio")
            {
                var controlsAttr = _audioControls ? "controls " : "";
                var loopAttr = _audioLoop ? "loop " : "";
                InsertAtCursor($"<audio {controlsAttr}{loopAttr}class=\"w-full my-3\"><source src=\"{_mediaUrlInput}\" type=\"audio/wav\">Your browser does not support audio playback.</audio>\n*Audio Track: {alt}*");
            }
            else if (_mediaModalType == "file")
            {
                var sizeInfo = _selectedFileSize > 0 ? $" ({FormatFileSize(_selectedFileSize)})" : "";
                InsertAtCursor($"📁 [{alt}{sizeInfo}]({_mediaUrlInput})");
            }
            else
            {
                InsertAtCursor($"[{alt}]({_mediaUrlInput})");
            }
        }

        Toast.Show($"Inserted {_mediaModalType} into editor ({(_isHtmlMode ? "HTML5" : "Markdown GFM")})", variant: SemanticVariant.Success);
        _mediaModalType = null;
        _mediaUrlInput = "";
        _mediaAltInput = "";
        _selectedFileName = null;
        _selectedFileSize = 0;
    }

