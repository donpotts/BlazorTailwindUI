    private void ResetToSample()
    {
        Value = GetDefaultSampleContent();
        NotifyChanged();
    }

    private void NotifyChanged()
    {
        ValueChanged.InvokeAsync(Value);
    }

    private int GetWordCount()
    {
        if (string.IsNullOrWhiteSpace(Value)) return 0;
        return Value.Split(new[] { ' ', '\r', '\n', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private int GetReadingTime()
    {
        var words = GetWordCount();
        return Math.Max(1, (int)Math.Ceiling(words / 200.0));
    }

    // High-Speed Pure C# WebAssembly Markdown-to-HTML Parser
    public static string RenderMarkdownToHtml(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "<p class=\"text-slate-400 italic\">Document is empty. Start typing above...</p>";

        var sb = new StringBuilder();
        var lines = markdown.Split('\n');
        bool inCodeBlock = false;
        string codeBlockLang = "";
        var codeContent = new StringBuilder();

        bool inTable = false;
        bool tableHeaderDone = false;

        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd('\r');

            // Code block delimiter
            if (line.TrimStart().StartsWith("```"))
            {
                if (!inCodeBlock)
                {
                    inCodeBlock = true;
                    codeBlockLang = line.Trim().Substring(3).Trim();
                    codeContent.Clear();
                    continue;
                }
                else
                {
                    inCodeBlock = false;
                    sb.AppendLine("<div class=\"my-4 rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden shadow-lg\">");
                    if (!string.IsNullOrEmpty(codeBlockLang))
                    {
                        sb.AppendLine($"<div class=\"px-4 py-1.5 bg-slate-950 text-[10px] font-mono text-slate-400 uppercase font-bold border-b border-slate-800\">{System.Net.WebUtility.HtmlEncode(codeBlockLang)}</div>");
                    }
                    sb.AppendLine($"<pre class=\"p-4 text-xs font-mono text-slate-100 overflow-x-auto m-0\"><code>{System.Net.WebUtility.HtmlEncode(codeContent.ToString())}</code></pre>");
                    sb.AppendLine("</div>");
                    continue;
                }
            }

            if (inCodeBlock)
            {
                codeContent.AppendLine(line);
                continue;
            }

            // Tables (| Column | Column |)
            if (line.TrimStart().StartsWith("|") && line.TrimEnd().EndsWith("|"))
            {
                var cells = line.Split('|', StringSplitOptions.RemoveEmptyEntries);
                if (line.Contains("---"))
                {
                    tableHeaderDone = true;
                    continue;
                }

                if (!inTable)
                {
                    inTable = true;
                    tableHeaderDone = false;
                    sb.AppendLine("<div class=\"overflow-x-auto my-4\"><table class=\"w-full text-left text-xs border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden\">");
                }

                if (!tableHeaderDone)
                {
                    sb.AppendLine("<thead class=\"bg-slate-100 dark:bg-slate-800 font-bold text-slate-900 dark:text-white\"><tr>");
                    foreach (var c in cells) sb.AppendLine($"<th class=\"p-3 border-b border-slate-200 dark:border-slate-700\">{FormatInline(c.Trim())}</th>");
                    sb.AppendLine("</tr></thead><tbody>");
                }
                else
                {
                    sb.AppendLine("<tr class=\"border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50/50 dark:hover:bg-slate-850/50 transition\">");
                    foreach (var c in cells) sb.AppendLine($"<td class=\"p-3\">{FormatInline(c.Trim())}</td>");
                    sb.AppendLine("</tr>");
                }
                continue;
            }
            else if (inTable)
            {
                inTable = false;
                sb.AppendLine("</tbody></table></div>");
            }

            // HTML media passthrough (<video ...>, <audio ...>, <source ...>, <img ...>, <a>)
            var trimmed = line.TrimStart();
            if (trimmed.StartsWith("<video") || trimmed.StartsWith("</video>") ||
                trimmed.StartsWith("<audio") || trimmed.StartsWith("</audio>") ||
                trimmed.StartsWith("<source") ||
                trimmed.StartsWith("<a ") || trimmed.StartsWith("</a>") ||
                (trimmed.StartsWith("<img") && !line.Contains("![alt]")))
            {
                sb.AppendLine(line);
                continue;
            }

            // Headings
            if (line.StartsWith("### "))
            {
                sb.AppendLine($"<h3 class=\"text-lg font-bold text-slate-900 dark:text-white mt-5 mb-2\">{FormatInline(line.Substring(4))}</h3>");
            }
            else if (line.StartsWith("## "))
            {
                sb.AppendLine($"<h2 class=\"text-xl font-black text-slate-900 dark:text-white mt-6 mb-2 border-b border-slate-100 dark:border-slate-800 pb-1.5\">{FormatInline(line.Substring(3))}</h2>");
            }
            else if (line.StartsWith("# "))
            {
                sb.AppendLine($"<h1 class=\"text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mt-6 mb-3\">{FormatInline(line.Substring(2))}</h1>");
            }
            // Blockquotes & Alerts
            else if (line.StartsWith("> "))
            {
                var quoteText = line.Substring(2);
                if (quoteText.StartsWith("[!NOTE]"))
                {
                    sb.AppendLine($"<div class=\"p-4 my-3 rounded-2xl bg-blue-50 dark:bg-blue-950/30 border-l-4 border-blue-500 text-blue-900 dark:text-blue-200 text-xs\"><strong class=\"font-bold block mb-1\">NOTE</strong>{FormatInline(quoteText.Replace("[!NOTE]", "").Trim())}</div>");
                }
                else if (quoteText.StartsWith("[!TIP]"))
                {
                    sb.AppendLine($"<div class=\"p-4 my-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border-l-4 border-emerald-500 text-emerald-900 dark:text-emerald-200 text-xs\"><strong class=\"font-bold block mb-1\">TIP</strong>{FormatInline(quoteText.Replace("[!TIP]", "").Trim())}</div>");
                }
                else if (quoteText.StartsWith("[!IMPORTANT]"))
                {
                    sb.AppendLine($"<div class=\"p-4 my-3 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border-l-4 border-amber-500 text-amber-900 dark:text-amber-200 text-xs\"><strong class=\"font-bold block mb-1\">IMPORTANT</strong>{FormatInline(quoteText.Replace("[!IMPORTANT]", "").Trim())}</div>");
                }
                else
                {
                    sb.AppendLine($"<blockquote class=\"border-l-4 border-brand-500 pl-4 py-1 my-3 text-slate-600 dark:text-slate-300 italic\">{FormatInline(quoteText)}</blockquote>");
                }
            }
            // Horizontal rule
            else if (line.Trim() == "---" || line.Trim() == "***")
            {
                sb.AppendLine("<hr class=\"my-6 border-slate-200 dark:border-slate-800\" />");
            }
            // Checklist item
            else if (line.StartsWith("- [ ] ") || line.StartsWith("- [x] "))
            {
                var isChecked = line.StartsWith("- [x] ");
                var checkText = line.Substring(6);
                sb.AppendLine($"<div class=\"flex items-center gap-2.5 my-1.5 text-xs text-slate-700 dark:text-slate-300\"><input type=\"checkbox\" {(isChecked ? "checked" : "")} disabled class=\"rounded text-brand-600 h-4 w-4\" /><span class=\"{(isChecked ? "line-through opacity-70" : "")}\">{FormatInline(checkText)}</span></div>");
            }
            // Bullet list
            else if (line.StartsWith("- ") || line.StartsWith("* "))
            {
                sb.AppendLine($"<li class=\"ml-4 list-disc text-slate-700 dark:text-slate-300 my-1\">{FormatInline(line.Substring(2))}</li>");
            }
            // Paragraph or empty line
            else if (string.IsNullOrWhiteSpace(line))
            {
                sb.AppendLine("<div class=\"h-2\"></div>");
            }
            else
            {
                sb.AppendLine($"<p class=\"text-slate-700 dark:text-slate-300 leading-relaxed my-2\">{FormatInline(line)}</p>");
            }
        }

        if (inTable)
        {
            sb.AppendLine("</tbody></table></div>");
        }

        return sb.ToString();
    }

    private static string FormatInline(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";

        // Images: ![alt](url)
        input = Regex.Replace(input, @"!\[(.*?)\]\((.*?)\)", "<figure class=\"my-4\"><img src=\"$2\" alt=\"$1\" class=\"rounded-2xl shadow-xl max-w-full h-auto border border-slate-200 dark:border-slate-800\" /><figcaption class=\"text-center text-[11px] font-mono text-slate-400 mt-2\">$1</figcaption></figure>");

        // Links: [text](url)
        input = Regex.Replace(input, @"\[(.*?)\]\((.*?)\)", "<a href=\"$2\" target=\"_blank\" class=\"text-brand-600 dark:text-brand-400 font-bold hover:underline\">$1</a>");

        // Bold: **text**
        input = Regex.Replace(input, @"\*\*(.*?)\*\*", "<strong>$1</strong>");

        // Italic: *text*
        input = Regex.Replace(input, @"\*(.*?)\*", "<em>$1</em>");

        // Strikethrough: ~~text~~
        input = Regex.Replace(input, @"~~(.*?)~~", "<del>$1</del>");

        // Inline Code: `code`
        input = Regex.Replace(input, @"`([^`]+)`", "<code class=\"px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-brand-600 dark:text-brand-400 font-mono text-[11px]\">$1</code>");

        return input;
    }

