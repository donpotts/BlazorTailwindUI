                        else
                        {
                            <button type="button" @onclick='() => SetPresetMedia("documents/quarterly-audit.pdf", "Quarterly Compliance Audit PDF Report")'
                                    class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-brand-500 text-left transition flex items-center gap-2">
                                <span class="text-xl">📑</span>
                                <div>
                                    <span class="font-bold text-slate-800 dark:text-slate-200 block">Audit Report (PDF)</span>
                                    <span class="text-[10px] text-slate-400 font-mono">ISO-27001 Verified PDF Document</span>
                                </div>
                            </button>
                        }
                    </div>
                }

                <!-- TAB CONTENT 3: DIRECT URL -->
                else
                {
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">Asset URL / Resource Path</label>
                        <input type="text" @bind="_mediaUrlInput" placeholder="@GetMediaPlaceholder()"
