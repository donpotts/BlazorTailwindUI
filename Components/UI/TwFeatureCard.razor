<div class="relative group p-6 rounded-3xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs hover:shadow-xl hover:border-brand-500/40 dark:hover:border-brand-500/40 transition-all duration-300 flex flex-col justify-between @Class">
    <div>
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-2xl @IconGradientClass text-white flex items-center justify-center shadow-md shadow-brand-500/10 group-hover:scale-110 transition-transform duration-300">
                @IconContent
            </div>
            @if (!string.IsNullOrWhiteSpace(BadgeText))
            {
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    @BadgeText
                </span>
            }
        </div>

        <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            @Title
        </h4>

        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
            @Description
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(LinkText))
    {
        <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80">
            <button type="button"
                    @onclick="OnClick"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 dark:text-brand-400 group-hover:gap-2.5 transition-all">
                <span>@LinkText</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string? LinkText { get; set; } = "Explore feature";
    [Parameter] public string IconGradientClass { get; set; } = "bg-gradient-to-tr from-brand-600 to-indigo-500";
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
}
