<div class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs hover:shadow-lg transition-all duration-300 @Class">
    <!-- Image Header with Aspect Ratio & Badges -->
    <div class="relative w-full aspect-video sm:aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img src="@ImageUrl" alt="@ImageAlt" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        }
        else
        {
            <div class="h-full w-full flex items-center justify-center text-slate-400 bg-gradient-to-tr from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(CategoryBadge))
        {
            <div class="absolute top-3 left-3">
                <span class="inline-flex items-center px-2.5 py-1 rounded-xl text-xs font-semibold backdrop-blur-md bg-slate-900/70 text-white shadow-xs">
                    @CategoryBadge
                </span>
            </div>
        }
    </div>

    <!-- Content Area -->
    <div class="flex-1 p-5 flex flex-col justify-between space-y-4">
        <div class="space-y-2">
            @if (Tags != null && Tags.Any())
            {
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var tag in Tags)
                    {
                        <span class="text-[11px] font-semibold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-500/10 px-2 py-0.5 rounded-md">
                            #@tag
                        </span>
                    }
                </div>
            }

            <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white line-clamp-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                @Title
            </h4>

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-2">
                    @Description
                </p>
            }
        </div>

        <!-- Footer / Author Meta & Action -->
        <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
            @if (!string.IsNullOrWhiteSpace(AuthorName))
            {
                <div class="flex items-center gap-2">
                    <TwAvatar Initials="@AuthorInitials" Size="ComponentSize.Sm" />
                    <div>
                        <p class="text-xs font-semibold text-slate-800 dark:text-slate-200">@AuthorName</p>
                        @if (!string.IsNullOrWhiteSpace(DateText))
                        {
                            <p class="text-[11px] text-slate-400">@DateText</p>
                        }
                    </div>
                </div>
            }

            @if (ActionContent is not null)
            {
                <div>@ActionContent</div>
            }
            else
            {
                <button type="button"
                        @onclick="OnClick"
                        class="p-2 rounded-xl text-slate-400 hover:text-brand-600 hover:bg-brand-50 dark:hover:bg-slate-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string ImageAlt { get; set; } = "Media cover";
    [Parameter] public string? CategoryBadge { get; set; }
    [Parameter] public string? AuthorName { get; set; }
    [Parameter] public string AuthorInitials { get; set; } = "AM";
    [Parameter] public string? DateText { get; set; }
    [Parameter] public IReadOnlyList<string>? Tags { get; set; }
    [Parameter] public RenderFragment? ActionContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
}
