@if (_activeSignModalField != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-xs">
        <div class="w-full max-w-lg rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <!-- Modal Header -->
            <div class="flex items-center justify-between p-5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40">
                <div class="flex items-center gap-2">
                    <span class="text-xl">✍️</span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">
                            Adopt Your Signature
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            Select a cursive calligraphy style or enter your legal name
                        </p>
                    </div>
                </div>
                <button type="button" @onclick="() => _activeSignModalField = null"
                        class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center text-sm font-bold">
                    ✕
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                        Signer Legal Name
                    </label>
                    <input type="text" @bind="_modalSignerName" @bind:event="oninput"
                           placeholder="Enter your full legal name (e.g. Jane M. Doe)"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-indigo-500" />
                </div>

                <!-- Calligraphic Style Options Preview -->
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                        Choose Calligraphic Script Style
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        @foreach (var style in _cursiveStyles)
                        {
                            <button type="button" @onclick="() => _selectedCursiveStyle = style.FontClass"
                                    class="p-3 rounded-xl border text-center transition-all @(_selectedCursiveStyle == style.FontClass ? "border-indigo-600 bg-indigo-50/60 dark:bg-indigo-950/50 ring-2 ring-indigo-500/20" : "border-slate-200 dark:border-slate-800 hover:border-slate-300")">
                                <div class="text-2xl text-slate-900 dark:text-white italic py-1"
                                     style="font-family: @style.CssFontFamily;">
                                    @(string.IsNullOrWhiteSpace(_modalSignerName) ? "Signature" : _modalSignerName)
                                </div>
                                <span class="text-[10px] text-slate-500 font-sans">@style.Name</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-[11px] text-slate-500 dark:text-slate-400">
                    By clicking <strong>Adopt & Sign</strong>, I agree that my signature constitutes a legally binding electronic signature identical to my handwritten signature under the ESIGN Act.
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-2 p-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40">
                <button type="button" @onclick="() => _activeSignModalField = null"
                        class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
                    Cancel
                </button>
                <button type="button" @onclick="AdoptSignature"
                        class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md transition">
                    Adopt & Sign
                </button>
            </div>
        </div>
    </div>
}

