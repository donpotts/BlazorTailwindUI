@code {
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public PdfContractDocument Document { get; set; } = CreateDefaultContract();

    private int _activePageIndex = 1;
    private bool _isDesignerMode = false;
    private bool _showDataPayloadModal = false;

    private PdfContractField? _activeSignModalField;
    private string _modalSignerName = "Jane M. Doe";
    private string _selectedCursiveStyle = "Dancing Script";

    private PdfContractField? _activeInitialModalField;
    private string _modalInitials = "JMD";

    private record CursiveFontPreset(string Name, string FontClass, string CssFontFamily);

    private readonly List<CursiveFontPreset> _cursiveStyles = new()
    {
        new("Dancing Script", "dancing-script", "'Dancing Script', 'Brush Script MT', cursive"),
        new("Caveat Calligraphy", "caveat", "'Caveat', 'Segoe Script', cursive"),
        new("Great Vibes Script", "great-vibes", "'Great Vibes', cursive"),
        new("Sacramento Formal", "sacramento", "'Sacramento', cursive")
    };

    public int RequiredFieldsCount => Document.Fields.Count(f => f.IsRequired);
    public int CompletedFieldsCount => Document.Fields.Count(f => f.IsRequired && f.IsFilled);

    private void SetMode(bool designer)
    {
        _isDesignerMode = designer;
        StateHasChanged();
    }

    private void OnCheckboxChanged(PdfContractField field, ChangeEventArgs e)
    {
        field.Value = (bool)(e.Value ?? false) ? "true" : "false";
    }

    private void ToggleReadOnly(ChangeEventArgs e)
    {
        Document.IsReadOnly = (bool)(e.Value ?? false);
        Toast?.Show($"Form mode set to: {(Document.IsReadOnly ? "Read-Only (Locked)" : "Interactive Fill")}", variant: SemanticVariant.Info);
    }

    private void OpenSignModal(PdfContractField field)
    {
        _activeSignModalField = field;
        if (!string.IsNullOrEmpty(field.SignerName))
        {
            _modalSignerName = field.SignerName;
        }
    }

    private void AdoptSignature()
    {
        if (_activeSignModalField != null)
        {
            _activeSignModalField.Value = _modalSignerName;
            _activeSignModalField.SignerName = _modalSignerName;
            _activeSignModalField.SignedAt = DateTime.UtcNow;
            _activeSignModalField.SignatureStyle = _selectedCursiveStyle;
            _activeSignModalField = null;
            Toast?.Show($"Signature adopted for {_modalSignerName}!", variant: SemanticVariant.Success);
        }
    }

    private void OpenInitialModal(PdfContractField field)
    {
        _activeInitialModalField = field;
        if (!string.IsNullOrEmpty(field.Value))
        {
            _modalInitials = field.Value;
        }
    }

    private void AdoptInitials()
    {
        if (_activeInitialModalField != null)
        {
            _activeInitialModalField.Value = _modalInitials.ToUpperInvariant();
            _activeInitialModalField.SignedAt = DateTime.UtcNow;
            _activeInitialModalField = null;
            Toast?.Show($"Initials applied: {_modalInitials}!", variant: SemanticVariant.Success);
        }
    }

    private void StampNow(PdfContractField field)
    {
        field.Value = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
        field.SignedAt = DateTime.UtcNow;
        Toast?.Show("Stamped current date & time.", variant: SemanticVariant.Info);
    }

    private void AddField(PdfFieldType type)
    {
        var newField = new PdfContractField
        {
            Type = type,
            Page = _activePageIndex,
            Label = type switch
            {
                PdfFieldType.SignHere => "Authorized Signature",
                PdfFieldType.InitialHere => "Section Initials",
                PdfFieldType.DateTimeStamp => "Date Executed",
                PdfFieldType.Checkbox => "Accept Terms",
                _ => "Contract Input"
            },
            IsRequired = true
        };
        Document.Fields.Add(newField);
        Toast?.Show($"Added {type} field to Page {_activePageIndex}!", variant: SemanticVariant.Success);
    }

    private void LoadSampleData()
    {
        foreach (var field in Document.Fields)
        {
            if (field.Label.Contains("Company") || field.Label.Contains("Party"))
                field.Value = "Apex Global Cloud Solutions, Inc.";
            else if (field.Label.Contains("Representative") || field.Label.Contains("Name"))
                field.Value = "Jane M. Doe";
            else if (field.Label.Contains("Title"))
                field.Value = "Chief Information Security Officer";
            else if (field.Label.Contains("Date"))
                field.Value = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
            else if (field.Type == PdfFieldType.Checkbox)
                field.Value = "true";
            else if (field.Type == PdfFieldType.InitialHere)
                field.Value = "JMD";
            else if (field.Type == PdfFieldType.SignHere)
            {
                field.Value = "Jane M. Doe";
                field.SignerName = "Jane M. Doe";
                field.SignedAt = DateTime.UtcNow;
            }
        }
        Toast?.Show("Sample contract data pre-filled successfully!", variant: SemanticVariant.Success);
    }

    private void SealContract()
    {
        var uncompleted = Document.Fields.Where(f => f.IsRequired && !f.IsFilled).ToList();
        if (uncompleted.Any())
        {
            Toast?.Show($"Please complete all required fields ({uncompleted.Count} remaining) before sealing.", variant: SemanticVariant.Warning);
            return;
        }

        // Generate cryptographic attestation SHA-256
        var payloadToHash = $"{Document.DocumentId}:{Document.Title}:{DateTime.UtcNow:O}:{Document.Fields.Count}";
        using var sha = SHA256.Create();
        var hashBytes = sha.ComputeHash(Encoding.UTF8.GetBytes(payloadToHash));
        Document.Sha256Fingerprint = Convert.ToHexString(hashBytes).ToLowerInvariant();

        Document.CertificateId = $"CERT-{DateTime.UtcNow.Year}-ESIGN-{Random.Shared.Next(10000, 99999)}";
        Document.SealedAtUtc = DateTime.UtcNow;
        Document.Status = "Executed & Sealed";
        Document.IsSealed = true;
        Document.IsReadOnly = true;
        _isDesignerMode = false;

        Toast?.Show("Contract Executed, Sealed, and Locked as Read-Only!", variant: SemanticVariant.Success);
    }

    private void UnlockContractForDemo()
    {
        Document.IsSealed = false;
        Document.IsFlattened = false;
        Document.IsReadOnly = false;
        Document.Status = "Pending Signatures";
        Toast?.Show("Contract unlocked for demonstration mode.", variant: SemanticVariant.Info);
    }

    private async Task FlattenAndStampDocument()
    {
        using (OtelService.StartSpan("TwPdfFormFiller", "FlattenAndStampDocument", "UserAction", new() { ["pdf.fields"] = Document.Fields.Count.ToString(), ["pdf.id"] = Document.DocumentId }))
        {
            // Auto-fill any remaining blank fields with realistic contract values
            foreach (var field in Document.Fields)
            {
                if (string.IsNullOrWhiteSpace(field.Value))
                {
                    if (field.Type == PdfFieldType.SignHere)
                    {
                        field.Value = "Jane M. Doe";
                        field.SignerName = "Jane M. Doe";
                        field.SignedAt = DateTime.UtcNow;
                    }
                    else if (field.Type == PdfFieldType.InitialHere)
                    {
                        field.Value = "JMD";
                        field.SignedAt = DateTime.UtcNow;
                    }
                    else if (field.Type == PdfFieldType.DateTimeStamp)
                    {
                        field.Value = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
                        field.SignedAt = DateTime.UtcNow;
                    }
                    else if (field.Type == PdfFieldType.Checkbox)
                    {
                        field.Value = "true";
                    }
                    else
                    {
                        field.Value = string.IsNullOrEmpty(field.Placeholder) ? "Apex Global Cloud Solutions, Inc." : field.Placeholder;
                    }
                }
            }

            Document.IsFlattened = true;
            Document.IsReadOnly = true;
            Document.FlattenedAtUtc = DateTime.UtcNow;
            Document.FlattenedContentStreamId = $"STRM-FLAT-{Guid.NewGuid().ToString("N")[..8].ToUpperInvariant()}";

            // Generate cryptographic attestation SHA-256 for flattened state
            var payloadToHash = $"{Document.DocumentId}:{Document.Title}:{Document.FlattenedAtUtc:O}:{Document.Fields.Count}:FLATTENED";
            using var sha = SHA256.Create();
            var hashBytes = sha.ComputeHash(Encoding.UTF8.GetBytes(payloadToHash));
            Document.FlattenedHash = Convert.ToHexString(hashBytes).ToLowerInvariant();
            if (string.IsNullOrEmpty(Document.Sha256Fingerprint))
            {
                Document.Sha256Fingerprint = Document.FlattenedHash;
            }

            Document.Status = "Flattened & Merged";
            _isDesignerMode = false;

            Toast?.Show("Form fields flattened & stamped! AcroForm annotations purged into immutable vector stream.", variant: SemanticVariant.Success);
            await Task.CompletedTask;
        }
    }

    private void UnflattenForEditing()
    {
        Document.IsFlattened = false;
        Document.IsReadOnly = false;
        Document.Status = "Interactive Fill";
        Toast?.Show("Document unflattened. Form inputs restored to interactive mode.", variant: SemanticVariant.Info);
    }

    private async Task DownloadMergedPdf()
    {
        try
        {
            var base64 = PdfFlattenStreamGenerator.GenerateFlattenedPdfBase64(Document);
            var filename = $"{Document.DocumentId}_Flattened_Merged.pdf";
            await JS.InvokeVoidAsync("pdfHelper.downloadBlob", filename, "application/pdf", base64);
            Toast?.Show($"Generated and downloaded: {filename}", variant: SemanticVariant.Success);
        }
        catch (Exception ex)
        {
            Toast?.Show($"PDF generation notice: {ex.Message}", variant: SemanticVariant.Info);
        }
    }

    private async Task PrintDocument()
    {
        try
        {
            await JS.InvokeVoidAsync("pdfHelper.printDocument");
        }
        catch
        {
            // fallback
        }
    }

    private string GetContractDataJson()
    {
        var export = new
        {
            DocumentId = Document.DocumentId,
            Title = Document.Title,
            ContractType = Document.ContractType,
            EffectiveDate = Document.EffectiveDate,
            Status = Document.Status,
            IsSealed = Document.IsSealed,
            IsReadOnly = Document.IsReadOnly,
            SealedAtUtc = Document.SealedAtUtc,
            CertificateId = Document.CertificateId,
            Sha256Fingerprint = Document.Sha256Fingerprint,
            SignerIp = Document.SignerIp,
            Fields = Document.Fields.Select(f => new
            {
                Id = f.Id,
                Type = f.Type.ToString(),
                Label = f.Label,
                Page = f.Page,
                Value = f.Value,
                IsRequired = f.IsRequired,
                SignedAt = f.SignedAt,
                SignerName = f.SignerName
            })
        };
        return JsonSerializer.Serialize(export, new JsonSerializerOptions { WriteIndented = true });
    }

    private async Task CopyJsonToClipboard()
    {
        try
        {
            var json = GetContractDataJson();
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
            Toast?.Show("JSON payload copied to clipboard!", variant: SemanticVariant.Success);
            _showDataPayloadModal = false;
        }
        catch
        {
            Toast?.Show("Select and copy JSON directly.", variant: SemanticVariant.Info);
        }
    }

