@namespace BlazorTailwindUI.Components.UI

<div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden flex @(Orientation == SplitOrientation.Vertical ? "flex-col" : "flex-row") @CustomClass"
     style="min-height: @(MinHeight)px;">

    <!-- First Pane -->
    <div class="overflow-auto transition-all" 
         style="@GetPaneOneStyle()">
        @if (PaneOne != null)
        {
            @PaneOne
        }
    </div>

    <!-- Divider Bar / Gutter -->
    <div class="relative flex items-center justify-center bg-slate-100 dark:bg-slate-800 hover:bg-brand-500/10 dark:hover:bg-brand-500/20 transition-colors select-none group @(Orientation == SplitOrientation.Vertical ? "h-2 w-full cursor-row-resize" : "w-2.5 h-full cursor-col-resize")">
        <!-- Grip Handle Dots -->
        <div class="flex @(Orientation == SplitOrientation.Vertical ? "flex-row" : "flex-col") gap-1 text-slate-400 group-hover:text-brand-500">
            <span class="w-1 h-1 rounded-full bg-current"></span>
            <span class="w-1 h-1 rounded-full bg-current"></span>
            <span class="w-1 h-1 rounded-full bg-current"></span>
        </div>

        <!-- Quick Collapse / Reset Controls -->
        <div class="absolute opacity-0 group-hover:opacity-100 transition-opacity bg-white dark:bg-slate-850 border border-slate-250 dark:border-slate-700 rounded-md shadow-xs flex items-center p-0.5 z-20">
            <button type="button" @onclick="CollapsePaneOne" class="p-0.5 hover:bg-slate-100 dark:hover:bg-slate-700 rounded text-slate-600 dark:text-slate-300" title="Collapse Left/Top">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Orientation == SplitOrientation.Vertical ? "M5 15l7-7 7 7" : "M15 19l-7-7 7-7")" />
                </svg>
            </button>
            <button type="button" @onclick="ResetSplit" class="p-0.5 hover:bg-slate-100 dark:hover:bg-slate-700 rounded text-slate-600 dark:text-slate-300 text-[9px] font-mono font-bold" title="50/50 Reset">
                ½
            </button>
            <button type="button" @onclick="CollapsePaneTwo" class="p-0.5 hover:bg-slate-100 dark:hover:bg-slate-700 rounded text-slate-600 dark:text-slate-300" title="Collapse Right/Bottom">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(Orientation == SplitOrientation.Vertical ? "M19 9l-7 7-7-7" : "M9 5l7 7-7 7")" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Second Pane -->
    <div class="overflow-auto flex-1 transition-all">
        @if (PaneTwo != null)
        {
            @PaneTwo
        }
    </div>
</div>

@code {
    public enum SplitOrientation
    {
        Horizontal,
        Vertical
    }

    [Parameter] public SplitOrientation Orientation { get; set; } = SplitOrientation.Horizontal;
    [Parameter] public double SplitPercentage { get; set; } = 40; // 0 to 100
    [Parameter] public double MinPercentage { get; set; } = 15;
    [Parameter] public double MaxPercentage { get; set; } = 85;
    [Parameter] public int MinHeight { get; set; } = 280;
    [Parameter] public string CustomClass { get; set; } = "";
    [Parameter] public RenderFragment? PaneOne { get; set; }
    [Parameter] public RenderFragment? PaneTwo { get; set; }

    [Parameter] public EventCallback<double> SplitPercentageChanged { get; set; }

    private string GetPaneOneStyle()
    {
        var clamped = Math.Clamp(SplitPercentage, 0, 100);
        if (Orientation == SplitOrientation.Vertical)
        {
            return $"height: {clamped}%; flex-shrink: 0;";
        }
        return $"width: {clamped}%; flex-shrink: 0;";
    }

    private async Task CollapsePaneOne()
    {
        SplitPercentage = 0;
        await SplitPercentageChanged.InvokeAsync(SplitPercentage);
    }

    private async Task CollapsePaneTwo()
    {
        SplitPercentage = 100;
        await SplitPercentageChanged.InvokeAsync(SplitPercentage);
    }

    private async Task ResetSplit()
    {
        SplitPercentage = 50;
        await SplitPercentageChanged.InvokeAsync(SplitPercentage);
    }
}
