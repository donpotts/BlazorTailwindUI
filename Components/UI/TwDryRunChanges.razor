@* Preview of what an action WOULD change, shown before approval (modelled on OpenBot (CopilotKit/OpenBot, MIT) boundaries/dry-run; own implementation). Pure view of a before/after list. *@
<section aria-label="Proposed changes" class="rounded-2xl border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/10 p-4 @Class" data-testid="dry-run">
    <header class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-sm font-black text-amber-950 dark:text-amber-100">@Title</h3>
        <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-amber-200 dark:bg-amber-500/30 text-amber-950 dark:text-amber-100" data-testid="dry-run-count">@Changes.Count change@(Changes.Count == 1 ? "" : "s")</span>
    </header>

    @if (Changes.Count == 0)
    {
        <p class="text-sm text-amber-950 dark:text-amber-100" data-testid="dry-run-none">Nothing would change.</p>
    }
    else
    {
        <ul class="divide-y divide-amber-200 dark:divide-amber-500/20" data-testid="dry-run-list">
            @foreach (var c in Changes)
            {
                <li class="py-2 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm" data-testid="dry-run-change" data-kind="@c.Kind.ToString().ToLowerInvariant()">
                    <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded @KindClass(c.Kind)">@KindLabel(c.Kind)</span>
                    <span class="font-semibold text-slate-900 dark:text-slate-100">@c.Target</span>
                    @if (c.Kind != DryRunKind.Create && c.Before is not null)
                    {
                        <del class="text-slate-700 dark:text-slate-300" data-testid="dry-run-before"><span class="sr-only">was </span>@c.Before</del>
                    }
                    @if (c.Kind != DryRunKind.Delete && c.After is not null)
                    {
                        <ins class="no-underline font-semibold text-emerald-900 dark:text-emerald-200" data-testid="dry-run-after"><span class="sr-only">becomes </span>@c.After</ins>
                    }
                </li>
            }
        </ul>
    }
    @ChildContent
</section>

@code {
    public enum DryRunKind { Create, Update, Delete }
    public sealed record DryRunChange(DryRunKind Kind, string Target, string? Before = null, string? After = null);

    [Parameter, EditorRequired] public IReadOnlyList<DryRunChange> Changes { get; set; } = Array.Empty<DryRunChange>();
    [Parameter] public string Title { get; set; } = "If you approve, this will change:";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private static string KindLabel(DryRunKind k) => k switch { DryRunKind.Create => "Add", DryRunKind.Delete => "Remove", _ => "Change" };

    private static string KindClass(DryRunKind k) => k switch
    {
        DryRunKind.Create => "bg-emerald-200 text-emerald-950 dark:bg-emerald-500/30 dark:text-emerald-100",
        DryRunKind.Delete => "bg-red-200 text-red-950 dark:bg-red-500/30 dark:text-red-100",
        _ => "bg-sky-200 text-sky-950 dark:bg-sky-500/30 dark:text-sky-100"
    };
}
