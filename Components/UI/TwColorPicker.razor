@namespace BlazorTailwindUI.Components.UI
@inject ToastService Toast

<div class="relative w-full @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
                @Label
            </label>
            @if (ShowValueBadge)
            {
                <span class="text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                    @Value
                </span>
            }
        </div>
    }

    @if (Inline)
    {
        <!-- Inline Swatch Grid & Picker -->
        <div class="space-y-3 p-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-xs">
            <div class="flex flex-wrap items-center gap-2">
                @foreach (var hex in PresetColors)
                {
                    var isSelected = string.Equals(Value, hex, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            @onclick="() => SelectColor(hex)"
                            class="w-8 h-8 rounded-xl shadow-xs border border-black/10 dark:border-white/10 transition-all hover:scale-110 active:scale-95 focus:outline-none relative flex items-center justify-center @(isSelected ? "ring-2 ring-offset-2 ring-slate-900 dark:ring-white dark:ring-offset-slate-900 scale-105" : "opacity-85 hover:opacity-100")"
                            style="background-color: @hex;"
                            title="@hex">
                        @if (isSelected)
                        {
                            <span class="text-white drop-shadow-md text-xs font-bold">✓</span>
                        }
                    </button>
                }
            </div>

            @if (AllowCustom)
            {
                <div class="flex items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="relative w-7 h-7 rounded-lg overflow-hidden border border-slate-300 dark:border-slate-700 shrink-0 shadow-inner">
                        <input type="color"
                               value="@Value"
                               @onchange="HandleNativeColorChange"
                               class="absolute -top-2 -left-2 w-11 h-11 cursor-pointer border-0 p-0"
                               title="Open Color Wheel" />
                    </div>

                    <input type="text"
                           value="@Value"
                           @onchange="HandleHexChange"
                           maxlength="7"
                           class="flex-1 px-2.5 py-1 text-xs font-mono uppercase rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-brand-500" />

                    @if (ShowCopy)
                    {
                        <button type="button"
                                @onclick="CopyColor"
                                class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition"
                                title="Copy HEX">
                            Copy
                        </button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <!-- Trigger Button -->
        <button type="button"
                @onclick="() => _isOpen = !_isOpen"
                class="w-full flex items-center justify-between px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm hover:border-slate-400 dark:hover:border-slate-600 focus:outline-none focus:ring-2 focus:ring-brand-500 transition shadow-xs">
            
            <div class="flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-lg shadow-inner border border-black/10 dark:border-white/10 shrink-0 ring-1 ring-black/5" 
                      style="background-color: @Value;"></span>
                <span class="font-mono text-xs font-bold text-slate-800 dark:text-slate-200 uppercase">
                    @Value
                </span>
            </div>

            <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 @(_isOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>

        <!-- Color Palette Popover -->
        @if (_isOpen)
        {
            <div class="fixed inset-0 z-40" @onclick="() => _isOpen = false"></div>

            <div class="absolute z-50 mt-2 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl w-72 space-y-3 left-0 animate-fade-in-down origin-top-left">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Presets</span>
                    <div class="grid grid-cols-6 gap-2 mt-2">
                        @foreach (var hex in PresetColors)
                        {
                            var isSelected = string.Equals(Value, hex, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    @onclick="() => SelectColor(hex)"
                                    class="w-8 h-8 rounded-xl shadow-xs border border-black/10 dark:border-white/10 transition-transform hover:scale-110 active:scale-95 focus:outline-none relative flex items-center justify-center @(isSelected ? "ring-2 ring-offset-2 ring-slate-900 dark:ring-white dark:ring-offset-slate-900 scale-105" : "")"
                                    style="background-color: @hex;"
                                    title="@hex">
                                @if (isSelected)
                                {
                                    <span class="text-white drop-shadow-md text-xs font-bold">✓</span>
                                }
                            </button>
                        }
                    </div>
                </div>

                @if (AllowCustom)
                {
                    <div class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-2">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Custom Picker</span>
                        <div class="flex items-center gap-2">
                            <div class="relative w-8 h-8 rounded-lg overflow-hidden border border-slate-300 dark:border-slate-700 shrink-0 shadow-inner">
                                <input type="color"
                                       value="@Value"
                                       @onchange="HandleNativeColorChange"
                                       class="absolute -top-2 -left-2 w-12 h-12 cursor-pointer border-0 p-0"
                                       title="Color Wheel" />
                            </div>

                            <input type="text"
                                   value="@Value"
                                   @onchange="HandleHexChange"
                                   maxlength="7"
                                   class="flex-1 px-2.5 py-1.5 text-xs font-mono uppercase rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-brand-500" />
                            
                            @if (ShowCopy)
                            {
                                <button type="button"
                                        @onclick="CopyColor"
                                        class="px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition"
                                        title="Copy HEX">
                                    Copy
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "#6366f1";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; } = "Pick Accent Color";
    [Parameter] public bool ShowValueBadge { get; set; } = true;
    [Parameter] public bool AllowCustom { get; set; } = true;
    [Parameter] public bool ShowCopy { get; set; } = true;
    [Parameter] public bool Inline { get; set; }
    [Parameter] public string[] PresetColors { get; set; } = new[]
    {
        "#6366f1", // Indigo
        "#8b5cf6", // Violet
        "#0ea5e9", // Sky
        "#06b6d4", // Cyan
        "#14b8a6", // Teal
        "#10b981", // Emerald
        "#f59e0b", // Amber
        "#f97316", // Orange
        "#f43f5e", // Rose
        "#ec4899", // Pink
        "#d946ef", // Fuchsia
        "#64748b"  // Slate
    };
    [Parameter] public string? Class { get; set; }

    private bool _isOpen;

    private async Task SelectColor(string hex)
    {
        Value = hex;
        _isOpen = false;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task HandleNativeColorChange(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString() ?? "#6366f1";
        Value = hex;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task HandleHexChange(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        if (!input.StartsWith("#") && !string.IsNullOrWhiteSpace(input)) input = "#" + input;
        Value = input;
        await ValueChanged.InvokeAsync(Value);
    }

    private void CopyColor()
    {
        Toast.Show("Copied to clipboard", Value.ToUpperInvariant(), SemanticVariant.Success);
    }
}
