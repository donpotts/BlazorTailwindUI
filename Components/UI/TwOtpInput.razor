@namespace BlazorTailwindUI.Components.UI
@inject IJSRuntime JS

<div class="space-y-2 @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
            @Label
        </label>
    }

    <div class="flex items-center gap-2 sm:gap-3" id="@_containerId">
        @for (int i = 0; i < Length; i++)
        {
            var index = i;
            var digit = GetDigit(index);
            var isFilled = !string.IsNullOrEmpty(digit);

            <input type="@(Masked ? "password" : "text")"
                   maxlength="1"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   autocomplete="one-time-code"
                   disabled="@Disabled"
                   value="@digit"
                   @oninput="(e) => HandleInput(index, e)"
                   @onkeydown="(e) => HandleKeyDown(index, e)"
                   id="@($"{_containerId}-slot-{index}")"
                   class="w-10 h-12 sm:w-12 sm:h-14 text-center text-lg sm:text-xl font-mono font-bold rounded-xl border transition-all focus:outline-none select-none @(HasError ? "border-rose-500 bg-rose-50/50 dark:bg-rose-950/20 text-rose-600 focus:ring-2 focus:ring-rose-500/20" : isFilled ? "border-brand-500 bg-brand-50/30 dark:bg-brand-950/20 text-brand-700 dark:text-brand-300 focus:ring-2 focus:ring-brand-500/30" : "border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white hover:border-slate-400 dark:hover:border-slate-600 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20") @(Disabled ? "opacity-50 cursor-not-allowed" : "")" />
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(HelperText) || !string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="text-[11px] @(HasError ? "text-rose-500 font-medium" : "text-slate-500 dark:text-slate-400")">
            @(HasError ? ErrorMessage : HelperText)
        </p>
    }
</div>

@code {
    private readonly string _containerId = "otp-" + Guid.NewGuid().ToString("N")[..8];
    private string[] _digits = Array.Empty<string>();

    [Parameter] public int Length { get; set; } = 6;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<string> OnCompleted { get; set; }
    [Parameter] public bool Masked { get; set; }
    [Parameter] public bool Mask { get => Masked; set => Masked = value; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized()
    {
        _digits = new string[Length];
        SyncFromValue();
    }

    protected override void OnParametersSet()
    {
        if (_digits.Length != Length)
        {
            _digits = new string[Length];
        }
        SyncFromValue();
    }

    private void SyncFromValue()
    {
        var val = Value ?? "";
        for (int i = 0; i < Length; i++)
        {
            _digits[i] = i < val.Length ? val[i].ToString() : "";
        }
    }

    private string GetDigit(int index) => (index >= 0 && index < _digits.Length) ? _digits[index] : "";

    private async Task HandleInput(int index, ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(input))
        {
            _digits[index] = "";
            await EmitChange();
            return;
        }

        // Handle Paste (multiple chars)
        if (input.Length > 1)
        {
            for (int i = 0; i < input.Length && (index + i) < Length; i++)
            {
                _digits[index + i] = input[i].ToString();
            }
            await EmitChange();
            var nextFocus = Math.Min(Length - 1, index + input.Length);
            await FocusSlot(nextFocus);
            return;
        }

        // Single digit
        _digits[index] = input;
        await EmitChange();

        // Auto advance to next slot
        if (index < Length - 1)
        {
            await FocusSlot(index + 1);
        }
    }

    private async Task HandleKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace")
        {
            if (string.IsNullOrEmpty(_digits[index]) && index > 0)
            {
                _digits[index - 1] = "";
                await EmitChange();
                await FocusSlot(index - 1);
            }
            else
            {
                _digits[index] = "";
                await EmitChange();
            }
        }
        else if (e.Key == "ArrowLeft" && index > 0)
        {
            await FocusSlot(index - 1);
        }
        else if (e.Key == "ArrowRight" && index < Length - 1)
        {
            await FocusSlot(index + 1);
        }
    }

    private async Task FocusSlot(int index)
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('{_containerId}-slot-{index}')?.focus()");
        }
        catch { }
    }

    private async Task EmitChange()
    {
        var result = string.Concat(_digits);
        if (result != Value)
        {
            Value = result;
            await ValueChanged.InvokeAsync(result);
            if (result.Length == Length)
            {
                await OnCompleted.InvokeAsync(result);
            }
        }
    }
}
