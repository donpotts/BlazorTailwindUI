@* Which tools/apps an agent may use and at what level, with revoke (modelled on OpenBot (CopilotKit/OpenBot, MIT) plugins/grant-list; own implementation). Changing a level is a real state change the host receives. *@
<section aria-label="Access grants" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 @Class" data-testid="grants">
    <table class="w-full text-sm">
        <caption class="sr-only">@Caption</caption>
        <thead>
            <tr class="text-start text-xs uppercase text-slate-700 dark:text-slate-300 border-b border-slate-200 dark:border-slate-800">
                <th scope="col" class="px-4 py-2 text-start font-bold">Tool</th>
                <th scope="col" class="px-4 py-2 text-start font-bold">Access</th>
                <th scope="col" class="px-4 py-2"><span class="sr-only">Actions</span></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            @foreach (var g in Items)
            {
                <tr data-testid="grant" data-grant="@g.Tool" data-level="@g.Level.ToString().ToLowerInvariant()">
                    <th scope="row" class="px-4 py-2 text-start font-semibold text-slate-900 dark:text-slate-100">@g.Tool</th>
                    <td class="px-4 py-2">
                        <label class="sr-only" for="@($"lvl-{g.Tool}")">@g.Tool access level</label>
                        <select id="@($"lvl-{g.Tool}")" value="@g.Level" @onchange="e => SetLevelAsync(g, e.Value)" data-testid="grant-level"
                                class="min-h-[36px] rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-2 text-sm text-slate-900 dark:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                            @foreach (var level in Enum.GetValues<GrantLevel>())
                            {
                                <option value="@level" selected="@(level == g.Level)">@Label(level)</option>
                            }
                        </select>
                    </td>
                    <td class="px-4 py-2 text-end">
                        <button type="button" @onclick="() => RevokeAsync(g)" aria-label="@($"Revoke {g.Tool}")" data-testid="grant-revoke"
                                class="px-2.5 min-h-[32px] rounded-lg text-xs font-semibold text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500">Revoke</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Items.Count == 0)
    {
        <p class="px-4 py-6 text-sm text-slate-600 dark:text-slate-400" data-testid="grants-empty">No access granted. The agent cannot use any tools.</p>
    }
</section>

@code {
    public enum GrantLevel { Ask, Read, Write }

    public sealed class Grant
    {
        public string Tool { get; init; } = "";
        public GrantLevel Level { get; set; } = GrantLevel.Ask;
    }

    [Parameter, EditorRequired] public List<Grant> Items { get; set; } = new();
    [Parameter] public EventCallback<Grant> OnChanged { get; set; }
    [Parameter] public EventCallback<Grant> OnRevoked { get; set; }
    [Parameter] public string Caption { get; set; } = "Tools the agent may use";
    [Parameter] public string? Class { get; set; }

    private static string Label(GrantLevel l) => l switch
    {
        GrantLevel.Ask => "Ask every time",
        GrantLevel.Read => "Read only",
        _ => "Read and write"
    };

    private async Task SetLevelAsync(Grant g, object? value)
    {
        if (Enum.TryParse<GrantLevel>(value?.ToString(), out var level) && level != g.Level)
        {
            g.Level = level;
            await OnChanged.InvokeAsync(g);
        }
    }

    private async Task RevokeAsync(Grant g)
    {
        Items.RemoveAll(i => i.Tool == g.Tool); // edit the caller's list so a parent re-render cannot resurrect it
        await OnRevoked.InvokeAsync(g);
    }
}
