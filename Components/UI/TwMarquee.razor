@namespace BlazorTailwindUI.Components.UI

<div class="group relative overflow-hidden flex select-none @(FadeEdges ? "before:absolute before:left-0 before:top-0 before:bottom-0 before:w-16 sm:before:w-28 before:z-10 before:bg-gradient-to-r before:from-white dark:before:from-slate-900 before:to-transparent before:pointer-events-none after:absolute after:right-0 after:top-0 after:bottom-0 after:w-16 sm:after:w-28 after:z-10 after:bg-gradient-to-l after:from-white dark:after:from-slate-900 after:to-transparent after:pointer-events-none" : "") @Class"
     style="--marquee-duration: @($"{DurationSeconds}s");">
    <!-- Track 1 -->
    <div class="flex-shrink-0 flex items-center justify-around gap-8 sm:gap-12 min-w-full @(Reverse ? "animate-marquee-reverse" : "animate-marquee") @(PauseOnHover ? "group-hover:[animation-play-state:paused]" : "") @TrackClass"
         aria-hidden="false">
        @ChildContent
    </div>

    <!-- Track 2 (Duplicate for continuous loop) -->
    <div class="flex-shrink-0 flex items-center justify-around gap-8 sm:gap-12 min-w-full @(Reverse ? "animate-marquee-reverse" : "animate-marquee") @(PauseOnHover ? "group-hover:[animation-play-state:paused]" : "") @TrackClass"
         aria-hidden="true">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int DurationSeconds { get; set; } = 25;
    [Parameter] public bool Reverse { get; set; } = false;
    [Parameter] public bool PauseOnHover { get; set; } = true;
    [Parameter] public bool FadeEdges { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TrackClass { get; set; }
}
