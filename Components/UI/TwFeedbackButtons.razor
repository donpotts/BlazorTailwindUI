@* Thumbs up/down on an agent message (CopilotKit feedback). Selecting the same rating again clears it. *@
<div class="inline-flex items-center gap-1 @Class" role="group" aria-label="@Label" data-testid="feedback">
    <button type="button" @onclick="() => SetAsync(FeedbackRating.Up)" aria-pressed="@(Value == FeedbackRating.Up ? "true" : "false")" aria-label="Good response" data-testid="feedback-up"
            class="@ButtonClass(Value == FeedbackRating.Up, "text-emerald-800 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-500/20")">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>
    </button>
    <button type="button" @onclick="() => SetAsync(FeedbackRating.Down)" aria-pressed="@(Value == FeedbackRating.Down ? "true" : "false")" aria-label="Poor response" data-testid="feedback-down"
            class="@ButtonClass(Value == FeedbackRating.Down, "text-red-800 dark:text-red-300 bg-red-100 dark:bg-red-500/20")">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/></svg>
    </button>
    @if (Value == FeedbackRating.Down && AskReason)
    {
        <label class="sr-only" for="@_reasonId">What went wrong?</label>
        <input id="@_reasonId" placeholder="What went wrong?" @onchange="ReasonAsync" data-testid="feedback-reason"
               class="ms-1 min-h-[32px] w-44 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-2 text-xs text-slate-900 dark:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" />
    }
</div>

@code {
    public enum FeedbackRating { None, Up, Down }

    private readonly string _reasonId = "fb-" + Guid.NewGuid().ToString("N")[..6];

    [Parameter] public FeedbackRating Value { get; set; }
    [Parameter] public EventCallback<FeedbackRating> ValueChanged { get; set; }
    /// <summary>Show a free-text box after a thumbs-down.</summary>
    [Parameter] public bool AskReason { get; set; } = true;
    [Parameter] public EventCallback<string> OnReason { get; set; }
    [Parameter] public string Label { get; set; } = "Rate this response";
    [Parameter] public string? Class { get; set; }

    private Task SetAsync(FeedbackRating rating) => ValueChanged.InvokeAsync(Value == rating ? FeedbackRating.None : rating);

    private Task ReasonAsync(ChangeEventArgs e) => OnReason.InvokeAsync(e.Value?.ToString() ?? "");

    private static string ButtonClass(bool on, string onClass) =>
        "inline-flex items-center justify-center w-9 h-9 rounded-lg border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 " +
        (on ? "border-transparent " + onClass : "border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800");
}
