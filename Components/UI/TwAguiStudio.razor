    private async Task CopyCSharpSnippet()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", GetCSharpSnippet());
        }
        catch (Exception)
        {
            // Clipboard fallback
        }
        Toast.Show("Code Copied", "C# .NET 11 AG-UI code snippet copied to clipboard.", SemanticVariant.Success);
    }

    private string GetCSharpSnippet()
    {
        return @"// .NET 11 C# AG-UI (Adaptive Generative UI) Form Engine & HITL Gate
using BlazorTailwindUI.Models;
using BlazorTailwindUI.Components.UI;

// 1. Synthesize Dynamic AG-UI Form Schema from Agent
var schema = new AguiFormSchema
{
    Title = ""Provision HA Database Cluster"",
    AgentName = ""DevOps Copilot"",
    RiskLevel = ""Medium"",
    OverallConfidence = 0.96,
    Fields = new()
    {
        new AguiFormField { Id = ""ClusterName"", Label = ""Cluster Name"", Type = AguiFieldType.Text, IsRequired = true },
        new AguiFormField { Id = ""EnableMultiAz"", Label = ""High Availability Multi-AZ"", Type = AguiFieldType.Switch },
        new AguiFormField { Id = ""ReplicaCount"", Label = ""Read Replicas"", Type = AguiFieldType.Slider, Min = 1, Max = 10, DependsOnField = ""EnableMultiAz"", DependsOnValue = ""true"" },
        new AguiFormField { Id = ""StorageGb"", Label = ""Storage (GB)"", Type = AguiFieldType.Number, Min = 50, Max = 5000 }
    },
    InitialValues = new() { [""ClusterName""] = ""prod-pg-us-east"", [""EnableMultiAz""] = ""true"", [""ReplicaCount""] = 3 }
};

// 2. Render in Razor Markup with Structured Callback & Sound FX
<TwAguiFormCanvas Schema=""@schema"" OnSubmit=""HandleApproval"" OnCancel=""HandleRejection"" />";
    }

