@namespace BlazorTailwindUI.Components.UI
@inject IJSRuntime JS
@inject ToastService Toast

<div class="space-y-6 @Class">
    <TwConfetti @ref="_confettiRef" />

    <!-- Studio Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-2xl bg-gradient-to-r from-purple-600/10 via-pink-600/10 to-transparent border border-purple-500/20">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg">
                🎆
            </div>
            <div>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">Celebration Animations Studio</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Tune canvas physics particle effects, emoji confetti, and export production code</p>
            </div>
        </div>
        <TwButton Variant="ButtonVariant.Primary" OnClick="TestCelebrationBurst">
            🚀 Test Burst Effect
        </TwButton>
    </div>

    <!-- Main Workspace (Editor + Live Canvas Preview) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Panel: Sliders & Controls -->
        <div class="lg:col-span-5 p-5 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block border-b border-slate-100 dark:border-slate-800 pb-2">
                Physics & Emission Controls
            </span>

            <!-- Particle Count -->
            <div class="space-y-1">
                <div class="flex justify-between text-xs font-bold">
                    <span class="text-slate-700 dark:text-slate-300">Particle Count</span>
                    <span class="font-mono text-brand-600 dark:text-brand-400">@_particleCount units</span>
                </div>
                <input type="range" min="20" max="350" step="10" @bind="_particleCount" @bind:event="oninput" class="w-full accent-brand-600" />
            </div>

            <!-- Spread Angle -->
            <div class="space-y-1">
                <div class="flex justify-between text-xs font-bold">
                    <span class="text-slate-700 dark:text-slate-300">Spread Angle</span>
                    <span class="font-mono text-brand-600 dark:text-brand-400">@_spreadAngle°</span>
                </div>
                <input type="range" min="30" max="360" step="15" @bind="_spreadAngle" @bind:event="oninput" class="w-full accent-brand-600" />
            </div>

            <!-- Ejection Velocity -->
            <div class="space-y-1">
                <div class="flex justify-between text-xs font-bold">
                    <span class="text-slate-700 dark:text-slate-300">Ejection Velocity</span>
                    <span class="font-mono text-brand-600 dark:text-brand-400">@_velocity px/frame</span>
                </div>
                <input type="range" min="10" max="60" step="5" @bind="_velocity" @bind:event="oninput" class="w-full accent-brand-600" />
            </div>

            <!-- Origin Y -->
            <div class="space-y-1">
                <div class="flex justify-between text-xs font-bold">
                    <span class="text-slate-700 dark:text-slate-300">Origin Height</span>
                    <span class="font-mono text-brand-600 dark:text-brand-400">@((int)(_originY * 100))% from top</span>
                </div>
                <input type="range" min="0.1" max="0.9" step="0.05" @bind="_originY" @bind:event="oninput" class="w-full accent-brand-600" />
            </div>

            <!-- Preset Palettes -->
            <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                <span class="text-xs font-bold text-slate-700 dark:text-slate-300 block">Preset Celebrations</span>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" @onclick='() => ApplyPreset("standard")' class="p-2 text-left rounded-xl border border-slate-200 dark:border-slate-750 text-xs font-semibold hover:border-brand-500">
                        🎉 Classic Party
                    </button>
                    <button type="button" @onclick='() => ApplyPreset("golden")' class="p-2 text-left rounded-xl border border-slate-200 dark:border-slate-750 text-xs font-semibold hover:border-brand-500">
                        🏆 Golden Award
                    </button>
                    <button type="button" @onclick='() => ApplyPreset("fireworks")' class="p-2 text-left rounded-xl border border-slate-200 dark:border-slate-750 text-xs font-semibold hover:border-brand-500">
                        🎆 360° Fireworks
                    </button>
                    <button type="button" @onclick='() => ApplyPreset("rocket")' class="p-2 text-left rounded-xl border border-slate-200 dark:border-slate-750 text-xs font-semibold hover:border-brand-500">
                        🚀 Launch Blast
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Panel: Live Test Stage & Generated Code -->
        <div class="lg:col-span-7 space-y-4">
            <!-- Stage Area -->
            <div class="h-64 rounded-3xl bg-slate-900 border border-slate-800 relative overflow-hidden flex flex-col items-center justify-center p-6 text-center shadow-inner">
                <div class="space-y-2 z-10">
                    <span class="text-3xl">✨</span>
                    <h4 class="text-base font-bold text-white">Live Physics Simulation Stage</h4>
                    <p class="text-xs text-slate-400 max-w-sm">Click the button below to test your calibrated particle velocity, spread angle, and trajectory.</p>
                    <div class="pt-2">
                        <TwButton Variant="ButtonVariant.Primary" Size="ComponentSize.Sm" OnClick="TestCelebrationBurst">
                            🎆 Trigger Burst
                        </TwButton>
                    </div>
                </div>

                <!-- Decorative crosshairs -->
                <div class="absolute inset-0 pointer-events-none opacity-20">
                    <div class="w-full h-px bg-slate-500 top-1/2 absolute"></div>
                    <div class="h-full w-px bg-slate-500 left-1/2 absolute"></div>
                </div>
            </div>

            <!-- Code Generator Tabs -->
            <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-mono font-bold text-slate-400">Exported Blazor / C# Snippet</span>
                    <button type="button" @onclick="CopyExportedCode" class="text-xs font-bold text-brand-400 hover:underline">
                        Copy Code
                    </button>
                </div>
                <pre class="font-mono text-xs text-emerald-400 overflow-x-auto p-2 bg-slate-900/60 rounded-xl"><code>@GetGeneratedCode()</code></pre>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Class { get; set; }

    private TwConfetti? _confettiRef;
    private int _particleCount = 120;
    private int _spreadAngle = 100;
    private int _velocity = 30;
    private double _originY = 0.5;

    private async Task TestCelebrationBurst()
    {
        if (_confettiRef != null)
        {
            await _confettiRef.FireAsync(0.5, _originY, _particleCount);
            Toast.Show("Celebration Fired", $"Simulated {_particleCount} particles with {_spreadAngle}° spread.", SemanticVariant.Success);
        }
    }

    private void ApplyPreset(string preset)
    {
        switch (preset)
        {
            case "standard":
                _particleCount = 100;
                _spreadAngle = 90;
                _velocity = 25;
                _originY = 0.6;
                break;
            case "golden":
                _particleCount = 180;
                _spreadAngle = 120;
                _velocity = 35;
                _originY = 0.45;
                break;
            case "fireworks":
                _particleCount = 250;
                _spreadAngle = 360;
                _velocity = 45;
                _originY = 0.4;
                break;
            case "rocket":
                _particleCount = 160;
                _spreadAngle = 45;
                _velocity = 55;
                _originY = 0.8;
                break;
        }
    }

    private string GetGeneratedCode()
    {
        return $@"// 1. In your Razor Component
<TwConfetti @ref=""_confetti"" />

// 2. In your C# Method
private TwConfetti? _confetti;

private async Task Celebrate()
{{
    if (_confetti != null)
    {{
        await _confetti.FireAsync(x: 0.5, y: {_originY:F2}, count: {_particleCount});
    }}
}}";
    }

    private async Task CopyExportedCode()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", GetGeneratedCode());
        }
        catch (Exception) { }
        Toast.Show("Snippet Copied", "Celebration code copied to clipboard.", SemanticVariant.Success);
    }
}
