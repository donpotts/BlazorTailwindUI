@* Structured questions an agent asks the user, one at a time with progress (modelled on OpenBot (CopilotKit/OpenBot, MIT) ui/questionnaire; own implementation). Single or multi choice, optional free text. *@
<section aria-label="@Title" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 space-y-4 @Class" data-testid="questionnaire" data-done="@_done.ToString().ToLowerInvariant()">
    @if (_done)
    {
        <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-200" data-testid="questionnaire-done">Thanks, your answers were sent to the agent.</p>
    }
    else if (Questions.Count > 0)
    {
        var q = Questions[_index];
        <p class="text-xs font-medium text-slate-700 dark:text-slate-300 tabular-nums" data-testid="questionnaire-progress" aria-live="polite">Question @(_index + 1) of @Questions.Count</p>
        <fieldset class="space-y-3">
            <legend class="text-base font-bold text-slate-900 dark:text-white" data-testid="questionnaire-title">@q.Prompt</legend>
            @if (!string.IsNullOrEmpty(q.Description))
            {
                <p class="text-sm text-slate-700 dark:text-slate-300">@q.Description</p>
            }
            <div class="space-y-2">
                @foreach (var opt in q.Options)
                {
                    var on = Selected(q).Contains(opt);
                    <label class="flex items-center gap-3 rounded-xl border px-3 min-h-[44px] cursor-pointer focus-within:ring-2 focus-within:ring-brand-500 @(on ? "border-brand-600 bg-brand-50 dark:bg-brand-500/10" : "border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800")">
                        <input type="@(q.Multiple ? "checkbox" : "radio")" name="@q.Id" checked="@on" @onchange="() => Toggle(q, opt)" data-testid="questionnaire-option" data-option="@opt"
                               class="text-brand-600 focus:ring-brand-500" />
                        <span class="text-sm text-slate-900 dark:text-slate-100">@opt</span>
                    </label>
                }
            </div>
            @if (q.AllowOther)
            {
                <div>
                    <label for="@($"other-{q.Id}")" class="text-xs font-semibold text-slate-800 dark:text-slate-200">Something else</label>
                    <input id="@($"other-{q.Id}")" @bind="_other" @bind:event="oninput" data-testid="questionnaire-other"
                           class="mt-1 w-full min-h-[40px] rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-3 text-sm text-slate-900 dark:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" />
                </div>
            }
        </fieldset>
        <div class="flex justify-between">
            <button type="button" @onclick="Back" disabled="@(_index == 0)" data-testid="questionnaire-back"
                    class="min-h-[40px] px-4 rounded-xl border border-slate-300 dark:border-slate-600 text-sm font-semibold text-slate-900 dark:text-slate-100 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">Back</button>
            <button type="button" @onclick="NextAsync" disabled="@(!Answered(q))" data-testid="questionnaire-next"
                    class="min-h-[40px] px-5 rounded-xl bg-brand-700 text-white text-sm font-bold hover:bg-brand-600 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500">@(_index == Questions.Count - 1 ? "Send answers" : "Next")</button>
        </div>
    }
</section>

@code {
    public sealed class Question
    {
        public string Id { get; init; } = Guid.NewGuid().ToString("N")[..6];
        public string Prompt { get; init; } = "";
        public string? Description { get; init; }
        public List<string> Options { get; init; } = new();
        public bool Multiple { get; init; }
        public bool AllowOther { get; init; }
    }

    private readonly Dictionary<string, HashSet<string>> _answers = new();
    private int _index;
    private bool _done;
    private string _other = "";

    [Parameter, EditorRequired] public IReadOnlyList<Question> Questions { get; set; } = Array.Empty<Question>();
    [Parameter] public string Title { get; set; } = "Questions from the agent";
    /// <summary>Answers keyed by question id, in question order.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, IReadOnlyList<string>>> OnSubmit { get; set; }
    [Parameter] public string? Class { get; set; }

    private HashSet<string> Selected(Question q) => _answers.TryGetValue(q.Id, out var s) ? s : new();

    private bool Answered(Question q) => Selected(q).Count > 0 || (q.AllowOther && !string.IsNullOrWhiteSpace(_other));

    private void Toggle(Question q, string opt)
    {
        if (!_answers.TryGetValue(q.Id, out var set)) _answers[q.Id] = set = new();
        if (q.Multiple) { if (!set.Remove(opt)) set.Add(opt); }
        else { set.Clear(); set.Add(opt); }
    }

    private void Back()
    {
        if (_index > 0) _index--;
        _other = "";
    }

    private async Task NextAsync()
    {
        var q = Questions[_index];
        if (!Answered(q)) return;
        if (q.AllowOther && !string.IsNullOrWhiteSpace(_other))
        {
            if (!_answers.TryGetValue(q.Id, out var set)) _answers[q.Id] = set = new();
            if (!q.Multiple) set.Clear();
            set.Add(_other.Trim());
        }
        _other = "";

        if (_index < Questions.Count - 1) { _index++; return; }

        _done = true;
        var result = Questions.ToDictionary(x => x.Id, x => (IReadOnlyList<string>)Selected(x).ToList());
        await OnSubmit.InvokeAsync(result);
    }
}
