@namespace BlazorTailwindUI.Components.UI
@using Microsoft.AspNetCore.Components

<div class="btui-tile rounded-2xl border transition-all duration-300 overflow-hidden shadow-xs flex flex-col @(IsMaximized ? "fixed inset-4 z-50 bg-white dark:bg-slate-900 shadow-2xl border-brand-500 ring-4 ring-brand-500/20" : $"bg-white dark:bg-slate-900 border-slate-200/90 dark:border-slate-800 {GetSpanClasses()}") @Class">
    <!-- Tile Header -->
    <div class="p-3.5 bg-slate-50/80 dark:bg-slate-850 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-between gap-2">
        <div class="flex items-center gap-2.5 min-w-0">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="text-base select-none">@Icon</span>
            }
            <div class="min-w-0">
                <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">@Title</h4>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="text-[10px] text-slate-500 dark:text-slate-400 truncate">@Subtitle</p>
                }
            </div>
        </div>

        <!-- Tile Actions -->
        <div class="flex items-center gap-1 shrink-0">
            @if (ShowRefresh)
            {
                <button type="button"
                        @onclick="HandleRefresh"
                        title="Refresh data"
                        class="p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </button>
            }

            @if (AllowMinimize)
            {
                <button type="button"
                        @onclick="ToggleMinimize"
                        title="@(IsMinimized ? "Expand Tile" : "Minimize Tile")"
                        class="p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition">
                    @if (IsMinimized)
                    {
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                        </svg>
                    }
                </button>
            }

            @if (AllowMaximize)
            {
                <button type="button"
                        @onclick="ToggleMaximize"
                        title="@(IsMaximized ? "Restore Size" : "Maximize Focus Mode")"
                        class="p-1 rounded-lg @(IsMaximized ? "text-brand-600 bg-brand-50 dark:bg-brand-950/60" : "text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-200/60 dark:hover:bg-slate-800") transition">
                    @if (IsMaximized)
                    {
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                        </svg>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
                        </svg>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Tile Body -->
    @if (!IsMinimized)
    {
        <div class="p-4 flex-1 @(IsMaximized ? "overflow-y-auto max-h-[calc(100vh-120px)]" : "")">
            @ChildContent
        </div>
    }
</div>

@if (IsMaximized)
{
    <!-- Modal Backdrop -->
    <div class="fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-xs transition-opacity" @onclick="ToggleMaximize"></div>
}

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N")[..8];
    [Parameter] public string Title { get; set; } = "Dashboard Metric";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public int ColSpan { get; set; } = 1;
    [Parameter] public int RowSpan { get; set; } = 1;
    [Parameter] public bool AllowMaximize { get; set; } = true;
    [Parameter] public bool AllowMinimize { get; set; } = true;
    [Parameter] public bool ShowRefresh { get; set; } = true;
    [Parameter] public bool IsMaximized { get; set; } = false;
    [Parameter] public EventCallback<bool> IsMaximizedChanged { get; set; }
    [Parameter] public bool IsMinimized { get; set; } = false;
    [Parameter] public EventCallback<bool> IsMinimizedChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string GetSpanClasses()
    {
        string col = ColSpan switch
        {
            2 => "md:col-span-2",
            3 => "md:col-span-3",
            4 => "md:col-span-4",
            _ => "col-span-1"
        };
        string row = RowSpan switch
        {
            2 => "row-span-2",
            _ => "row-span-1"
        };
        return $"{col} {row}";
    }

    private async Task ToggleMaximize()
    {
        IsMaximized = !IsMaximized;
        await IsMaximizedChanged.InvokeAsync(IsMaximized);
    }

    private async Task ToggleMinimize()
    {
        IsMinimized = !IsMinimized;
        await IsMinimizedChanged.InvokeAsync(IsMinimized);
    }

    private async Task HandleRefresh()
    {
        await OnRefresh.InvokeAsync();
    }
}
