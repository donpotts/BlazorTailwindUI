@namespace BlazorTailwindUI.Components.UI
@inject IJSRuntime JS

<div class="rounded-2xl bg-slate-950 border border-slate-800 text-slate-100 overflow-hidden shadow-xl @Class">
    <!-- Header with Window Controls & Tabs -->
    <div class="flex flex-wrap items-center justify-between gap-2 px-3 sm:px-4 py-2.5 bg-slate-900 border-b border-slate-800">
        <div class="flex items-center gap-3 overflow-x-auto max-w-full">
            <!-- macOS Dots -->
            <div class="flex items-center gap-1.5 shrink-0">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>

            <!-- File Tabs -->
            <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
                @for (int i = 0; i < Tabs.Count; i++)
                {
                    var index = i;
                    var tab = Tabs[i];
                    var isActive = index == _activeTabIndex;

                    <button type="button"
                            @onclick="() => _activeTabIndex = index"
                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition focus:outline-none shrink-0 @(isActive ? "bg-slate-800 text-white shadow-xs border border-slate-700/80" : "text-slate-400 hover:text-slate-200 hover:bg-slate-850")">
                        <span>@GetFileIcon(tab.FileName)</span>
                        <span>@tab.FileName</span>
                    </button>
                }
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 shrink-0">
            @if (ActiveTab != null && !string.IsNullOrWhiteSpace(ActiveTab.Language))
            {
                <span class="hidden sm:inline-block px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase tracking-wider bg-slate-800 text-slate-400 border border-slate-700/50">
                    @ActiveTab.Language
                </span>
            }

            @if (AllowCopy && ActiveTab != null)
            {
                <button type="button"
                        @onclick="CopyActiveCode"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 transition-colors focus:outline-none">
                    @if (_copied)
                    {
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-emerald-400 font-semibold text-[11px]">Copied!</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span class="text-[11px]">Copy</span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Code Display Area -->
    <div class="p-4 overflow-x-auto text-xs sm:text-sm font-mono leading-relaxed select-all max-h-[480px]">
        @if (ActiveTab != null)
        {
            @if (ShowLineNumbers)
            {
                var lines = (ActiveTab.Code ?? "").Split('\n');
                <table class="w-full border-collapse">
                    <tbody>
                        @for (int i = 0; i < lines.Length; i++)
                        {
                            var lineNum = i + 1;
                            var lineText = lines[i];
                            <tr class="hover:bg-slate-900/60 transition-colors">
                                <td class="w-10 pr-4 text-right text-slate-600 select-none font-mono text-[11px]">@lineNum</td>
                                <td class="text-emerald-400 whitespace-pre">@lineText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <pre class="text-emerald-400 whitespace-pre"><code>@ActiveTab.Code</code></pre>
            }
        }
    </div>
</div>

@code {
    public sealed record CodeTab(string FileName, string Code, string? Language = "razor");

    [Parameter] public IReadOnlyList<CodeTab> Tabs { get; set; } = Array.Empty<CodeTab>();
    [Parameter] public bool ShowLineNumbers { get; set; } = true;
    [Parameter] public bool AllowCopy { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private int _activeTabIndex = 0;
    private bool _copied = false;

    private CodeTab? ActiveTab => (Tabs.Count > 0 && _activeTabIndex >= 0 && _activeTabIndex < Tabs.Count)
        ? Tabs[_activeTabIndex]
        : null;

    private string GetFileIcon(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".cs" or ".razor" => "⚡",
            ".html" or ".htm" => "🌐",
            ".css" => "🎨",
            ".js" or ".ts" => "📜",
            ".json" => "📦",
            ".md" => "📝",
            _ => "📄"
        };
    }

    private async Task CopyActiveCode()
    {
        if (ActiveTab == null || string.IsNullOrEmpty(ActiveTab.Code)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ActiveTab.Code);
            _copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false;
            StateHasChanged();
        }
        catch
        {
            // Discard
        }
    }
}
