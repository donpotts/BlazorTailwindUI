    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("destroy", $"#{_dashboardContainerId}");
            }
            catch { }
            finally
            {
                await _jsModule.DisposeAsync();
            }
        }
        _dotNetHelper?.Dispose();
    }
