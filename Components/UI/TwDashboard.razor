                            <span class="inline-flex items-center gap-0.5 text-xs font-bold font-mono px-2 py-0.5 rounded-full @(card.IsPositiveTrend == true ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-rose-500/10 text-rose-600 dark:text-rose-400")">
