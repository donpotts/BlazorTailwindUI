    private async Task CopyJsonToClipboardAsync()
    {
        _exportJsonText = JsonSerializer.Serialize(_currentLayout, new JsonSerializerOptions { WriteIndented = true });
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _exportJsonText);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TwDashboard] clipboard copy error: {ex.Message}");
        }
        Toast?.Show("JSON copied to clipboard!", variant: SemanticVariant.Success);
    }

    private async Task ImportJsonAsync()
    {
        try
        {
            var parsed = JsonSerializer.Deserialize<List<TwDashboardCard>>(_exportJsonText);
            if (parsed != null && parsed.Any())
            {
                _currentLayout = parsed;
                _showExportModal = false;
                await ReloadGridAsync();
                Toast?.Show("Custom JSON layout applied successfully!", variant: SemanticVariant.Success);
            }
        }
        catch (Exception ex)
        {
            Toast?.Show($"Invalid JSON: {ex.Message}", variant: SemanticVariant.Warning);
        }
    }

    private RenderFragment RenderDefaultCardContent(TwDashboardCard card) => __builder =>
    {
        switch (card.CardType)
        {
            case "chart":
                @RenderPureSvgChart(card)
