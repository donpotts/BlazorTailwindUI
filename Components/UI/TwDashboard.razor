                            <path d="M0 24 Q 20 8, 40 18 T 80 6 T 100 2" fill="none" stroke="currentColor" stroke-width="2.5" class="text-brand-500" />
                        </svg>
                    </div>
                </div>
                break;
            case "activity":
                <div class="space-y-3">
                    @foreach (var act in _recentActivities)
                    {
                        <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-50/70 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800 text-xs">
                            <span class="text-base shrink-0">
                                @(act.Type switch { "Call" => "📞", "Email" => "✉️", "Meeting" => "👥", _ => "📋" })
