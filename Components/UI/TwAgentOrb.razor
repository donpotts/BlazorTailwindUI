@using BlazorTailwindUI.Models
@* Animated agent avatar whose look carries run state (OpenBot orb). Motion stops under prefers-reduced-motion; status is also text for AT. *@
<span class="relative inline-flex items-center justify-center @SizeClass @Class" role="img" aria-label="@($"{Name}: {StatusText}")" data-testid="agent-orb" data-status="@Status">
    @if (Active)
    {
        <span class="absolute inset-0 rounded-full @Ring opacity-40 animate-ping motion-reduce:animate-none" aria-hidden="true"></span>
    }
    <span class="relative inline-flex items-center justify-center w-full h-full rounded-full bg-gradient-to-br @Gradient text-white font-black shadow-md" aria-hidden="true">
        @Initial
    </span>
    <span class="absolute -bottom-0.5 -end-0.5 w-3 h-3 rounded-full ring-2 ring-white dark:ring-slate-900 @Dot" aria-hidden="true"></span>
</span>

@code {
    [Parameter] public string Name { get; set; } = "Agent";
    [Parameter] public AgentRunStatus Status { get; set; } = AgentRunStatus.Idle;
    /// <summary>sm, md or lg.</summary>
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string? Class { get; set; }

    private bool Active => Status is AgentRunStatus.Running or AgentRunStatus.AwaitingApproval;
    private string Initial => string.IsNullOrWhiteSpace(Name) ? "?" : Name.Trim()[..1].ToUpperInvariant();
    private string SizeClass => Size switch { "sm" => "w-8 h-8 text-xs", "lg" => "w-16 h-16 text-2xl", _ => "w-11 h-11 text-base" };

    private string StatusText => Status switch
    {
        AgentRunStatus.Running => "working",
        AgentRunStatus.AwaitingApproval => "waiting for approval",
        AgentRunStatus.Paused => "paused, you have control",
        AgentRunStatus.Finished => "finished",
        AgentRunStatus.Failed => "failed",
        AgentRunStatus.Cancelled => "stopped",
        _ => "idle"
    };

    private string Gradient => Status switch
    {
        AgentRunStatus.Failed => "from-red-600 to-red-800",
        AgentRunStatus.AwaitingApproval => "from-amber-600 to-orange-800",
        AgentRunStatus.Paused => "from-slate-600 to-slate-800",
        AgentRunStatus.Finished => "from-emerald-600 to-emerald-800",
        _ => "from-brand-600 to-indigo-800"
    };

    private string Ring => Status == AgentRunStatus.AwaitingApproval ? "bg-amber-500" : "bg-brand-500";

    private string Dot => Status switch
    {
        AgentRunStatus.Running => "bg-brand-500",
        AgentRunStatus.AwaitingApproval => "bg-amber-500",
        AgentRunStatus.Paused => "bg-slate-500",
        AgentRunStatus.Finished => "bg-emerald-500",
        AgentRunStatus.Failed => "bg-red-500",
        _ => "bg-slate-400"
    };
}
