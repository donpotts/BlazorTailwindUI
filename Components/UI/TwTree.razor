@namespace BlazorTailwindUI.Components.UI

<div class="space-y-1 select-none @Class">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string> SelectedIdChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    public async Task SelectNodeAsync(string id)
    {
        SelectedId = id;
        await SelectedIdChanged.InvokeAsync(id);
    }
}
