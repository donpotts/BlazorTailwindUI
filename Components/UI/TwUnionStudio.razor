@namespace BlazorTailwindUI.Components.UI
@using BlazorTailwindUI.Models
@using System.Threading
@inject ToastService Toast

<div class="space-y-6">
    <!-- Header with Badges & Description -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-2xl bg-gradient-to-r from-purple-900/40 via-indigo-900/30 to-slate-900/60 border border-purple-500/30 backdrop-blur-sm">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-purple-600/20 border border-purple-500/40 text-purple-400 flex items-center justify-center text-2xl shadow-inner shrink-0">
                🛡️
            </div>
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-base sm:text-lg font-bold text-white tracking-tight">
                        C# 15 Discriminated Union Boundary Studio (<span class="font-mono text-purple-400">TwUnionBoundary</span>)
                    </h3>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                        PILLAR 12 SHIPPED
                    </span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">
                    Closed algebraic hierarchies (<code class="text-purple-300 font-mono">UiState&lt;T&gt;</code> &amp; <code class="text-purple-300 font-mono">Result&lt;T, E&gt;</code>) eliminating untyped nulls, runtime branch regressions, and boilerplate if/else UI conditions.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <button type="button" @onclick="SimulateAsyncBatch"
                    class="px-3.5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold shadow-md transition flex items-center gap-1.5 active:scale-95">
                <span>⚡ Simulate Async Fetch</span>
            </button>
        </div>
    </div>

    <!-- State Selector Buttons -->
    <div class="p-3 rounded-2xl bg-slate-100 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        <div class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>Select Union State:</span>
        </div>
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <button type="button" @onclick="SetLoadingState"
                    class="px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(_currentState.IsLoading ? "bg-indigo-600 text-white shadow-md" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                <span>⏳ 1. Loading</span>
            </button>
            <button type="button" @onclick="SetSuccessState"
                    class="px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(_currentState.IsSuccess ? "bg-emerald-600 text-white shadow-md" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                <span>✅ 2. Success (4 Invoices)</span>
            </button>
            <button type="button" @onclick="SetEmptyState"
                    class="px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(_currentState.IsEmpty ? "bg-amber-600 text-white shadow-md" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                <span>📭 3. Empty (Zero Rows)</span>
            </button>
            <button type="button" @onclick="SetFailureState"
                    class="px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 @(_currentState.IsFailure ? "bg-rose-600 text-white shadow-md" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                <span>⚠️ 4. Failure (HTTP 503)</span>
            </button>
        </div>
    </div>

    <!-- Live TwUnionBoundary Container -->
    <div class="w-full">
        <TwUnionBoundary TItem="List<DemoInvoice>" State="@_currentState" OnRetry="SimulateAsyncBatch">
            <Loading>
                <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4 animate-pulse">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                                <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-900 dark:text-white">Evaluating C# 15 Algebraic Union...</h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Streaming ledger records from SQL Vector store...</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-purple-500/10 text-purple-500 border border-purple-500/20">
                            EVALUATING UNION
                        </span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
                        <div class="h-20 bg-slate-100 dark:bg-slate-800/60 rounded-2xl"></div>
                        <div class="h-20 bg-slate-100 dark:bg-slate-800/60 rounded-2xl"></div>
                    </div>
                </div>
            </Loading>

            <Success Context="invoices">
                <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 flex items-center justify-center text-lg">
                                📊
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                    <span>Enterprise Receivables</span>
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-mono bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                                        @invoices.Count RECORDS
                                    </span>
                                </h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Type-safe payload accessed via <code class="font-mono text-emerald-600 dark:text-emerald-400">Context="invoices"</code>.</p>
                            </div>
                        </div>

                        <div class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-3 py-1.5 rounded-xl border border-emerald-200 dark:border-emerald-800">
                            Total: $@invoices.Sum(i => i.Amount).ToString("N0") USD
                        </div>
                    </div>

                    <!-- Invoices Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-xs text-left">
                            <thead class="text-slate-400 border-b border-slate-100 dark:border-slate-800">
                                <tr>
                                    <th class="py-2 px-3 font-semibold">Invoice ID</th>
                                    <th class="py-2 px-3 font-semibold">Client Name</th>
                                    <th class="py-2 px-3 font-semibold">Issue Date</th>
                                    <th class="py-2 px-3 font-semibold">Status</th>
                                    <th class="py-2 px-3 font-semibold text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono">
                                @foreach (var inv in invoices)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                                        <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">@inv.Id</td>
                                        <td class="py-2.5 px-3 font-sans text-slate-700 dark:text-slate-300">@inv.Client</td>
                                        <td class="py-2.5 px-3 text-slate-500">@inv.Date</td>
                                        <td class="py-2.5 px-3 font-sans">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(inv.Status == "Paid" ? "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20" : "bg-amber-500/10 text-amber-500 border border-amber-500/20")">
                                                @inv.Status
                                            </span>
                                        </td>
                                        <td class="py-2.5 px-3 font-bold text-right text-slate-900 dark:text-white">$@inv.Amount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </Success>

            <Empty>
                <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm text-center flex flex-col items-center justify-center space-y-3">
                    <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-500 flex items-center justify-center text-2xl shadow-inner">
                        📭
                    </div>
                    <div>
                        <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
                            Zero Outstanding Invoices
                        </h4>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm">
                            All corporate receivables for this billing cycle have been reconciled.
                        </p>
                    </div>
                    <button type="button" @onclick="SimulateAsyncBatch"
                            class="px-4 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xs font-semibold transition flex items-center gap-1.5">
                        <span>🔄 Query Alternative Billing Cycle</span>
                    </button>
                </div>
            </Empty>

            <Failure Context="err">
                <div class="p-6 rounded-3xl bg-rose-50/60 dark:bg-rose-950/20 border border-rose-300 dark:border-rose-900/50 shadow-sm space-y-4 text-rose-900 dark:text-rose-200">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-rose-500 text-white flex items-center justify-center text-lg shadow-md shrink-0">
                                ⚠️
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-rose-900 dark:text-rose-100">
                                        Upstream Gateway Timeout
                                    </h4>
                                    <span class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold bg-rose-200 dark:bg-rose-900/60 text-rose-800 dark:text-rose-300">
                                        @err.ErrorCode
                                    </span>
                                </div>
                                <p class="text-xs text-rose-700 dark:text-rose-300 mt-1">
                                    @err.Message
                                </p>
                            </div>
                        </div>

                        <span class="text-[10px] font-mono text-rose-500 dark:text-rose-400 shrink-0">
                            @err.TimestampUtc.ToString("HH:mm:ss") UTC
                        </span>
                    </div>

                    <div class="flex items-center justify-between pt-2 border-t border-rose-200/60 dark:border-rose-900/40">
                        <span class="text-[11px] text-rose-600 dark:text-rose-400">
                            Failure caught by type-safe union boundary with automatic retry dispatch.
                        </span>
                        <button type="button" @onclick="SimulateAsyncBatch"
                                class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-md transition flex items-center gap-1.5 active:scale-95">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                            </svg>
                            <span>Retry Request</span>
                        </button>
                    </div>
                </div>
            </Failure>
        </TwUnionBoundary>
    </div>

    <!-- Code Pattern Inspection Card -->
    <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 text-xs text-slate-300 font-mono space-y-2">
        <div class="flex items-center justify-between text-slate-400 border-b border-slate-800 pb-2">
            <span class="font-bold text-white flex items-center gap-1.5">
                <span>💻</span>
                <span>C# 15 Declarative Razor Template Pattern</span>
            </span>
            <span class="text-[10px] text-purple-400">Compile-Time Checked</span>
        </div>
        <pre class="text-[11px] overflow-x-auto text-purple-300 leading-relaxed">&lt;TwUnionBoundary TItem="List&lt;DemoInvoice&gt;" State="@@state" OnRetry="FetchInvoicesAsync"&gt;
    &lt;Loading&gt; &lt;TwSkeletonTable Rows="4" /&gt; &lt;/Loading&gt;
    &lt;Success Context="invoices"&gt; &lt;InvoicesGrid Items="@@invoices" /&gt; &lt;/Success&gt;
    &lt;Empty&gt; &lt;TwEmptyState Title="Zero Invoices" /&gt; &lt;/Empty&gt;
    &lt;Failure Context="err"&gt; &lt;TwAlert Error="@@err.Message" /&gt; &lt;/Failure&gt;
&lt;/TwUnionBoundary&gt;</pre>
    </div>
</div>

@code {
    public record DemoInvoice(string Id, string Client, string Date, string Status, decimal Amount);

    private UiState<List<DemoInvoice>> _currentState = new UiState<List<DemoInvoice>>.Success(GetSampleInvoices());

    private void SetLoadingState()
    {
        _currentState = new UiState<List<DemoInvoice>>.Loading("Evaluating ledger balance via SIMD stream...", 42.0);
        Toast?.Show("Union State transitioned to: Loading", variant: SemanticVariant.Info);
    }

    private void SetSuccessState()
    {
        _currentState = new UiState<List<DemoInvoice>>.Success(GetSampleInvoices());
        Toast?.Show("Union State transitioned to: Success (4 Records)", variant: SemanticVariant.Success);
    }

    private void SetEmptyState()
    {
        _currentState = new UiState<List<DemoInvoice>>.Empty("Zero Invoices Available", "All accounts receivables for Q4 2026 have been settled.");
        Toast?.Show("Union State transitioned to: Empty", variant: SemanticVariant.Warning);
    }

    private void SetFailureState()
    {
        _currentState = new UiState<List<DemoInvoice>>.Failure(
            "Service Unavailable: Edge Ingress upstream rate-limit exceeded (HTTP 503).",
            new TimeoutException("Connection to downstream payment orchestrator timed out after 5000ms."),
            "HTTP_503_EDGE_TIMEOUT");
        Toast?.Show("Union State transitioned to: Failure (HTTP 503)", variant: SemanticVariant.Danger);
    }

    private async Task SimulateAsyncBatch()
    {
        _currentState = new UiState<List<DemoInvoice>>.Loading("Connecting to resilient async pipeline...", 15.0);
        await Task.Delay(800);
        _currentState = new UiState<List<DemoInvoice>>.Success(GetSampleInvoices());
        Toast?.Show("Simulated async batch fetched and resolved cleanly!", variant: SemanticVariant.Success);
    }

    private static List<DemoInvoice> GetSampleInvoices() => new()
    {
        new("INV-2026-081", "Apex Global Logistics", "Oct 24, 2026", "Paid", 18500m),
        new("INV-2026-082", "Cyberdyne Quantum AI", "Oct 25, 2026", "Pending", 42000m),
        new("INV-2026-083", "Starlight Aerospace", "Oct 26, 2026", "Paid", 96500m),
        new("INV-2026-084", "OmniCorp Robotics", "Oct 27, 2026", "Pending", 31200m)
    };
}
