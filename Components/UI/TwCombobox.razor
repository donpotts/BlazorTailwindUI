@namespace BlazorTailwindUI.Components.UI
@inject IJSRuntime JS

<div class="relative space-y-1.5 @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
            @Label
        </label>
    }

    <!-- Trigger Input -->
    <div class="relative">
        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>

        <input type="text"
               value="@(IsOpen ? _searchText : SelectedItem?.Label ?? "")"
               @oninput="HandleSearchInput"
               @onfocus="OpenDropdown"
               @onkeydown="HandleKeyDown"
               placeholder="@Placeholder"
               disabled="@Disabled"
               class="w-full pl-9 pr-16 py-2.5 rounded-xl border text-xs sm:text-sm transition-all focus:outline-none border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 @(Disabled ? "opacity-50 cursor-not-allowed" : "")" />

        <div class="absolute right-2.5 top-1/2 -translate-y-1/2 flex items-center gap-1 text-slate-400">
            @if (!string.IsNullOrEmpty(Value) && !Disabled)
            {
                <button type="button"
                        @onclick="ClearSelection"
                        class="p-1 hover:text-slate-600 dark:hover:text-slate-200 transition focus:outline-none"
                        aria-label="Clear selection">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            }

            <button type="button"
                    @onclick="ToggleDropdown"
                    class="p-1 hover:text-slate-600 dark:hover:text-slate-200 transition focus:outline-none"
                    aria-label="Toggle options list">
                <svg class="w-4 h-4 transition-transform duration-200 @(IsOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Dropdown Popover -->
    @if (IsOpen)
    {
        <div class="absolute z-50 left-0 right-0 mt-1 max-h-60 overflow-y-auto rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl divide-y divide-slate-100 dark:divide-slate-800/80 p-1.5 animate-zoom-in">
            @if (FilteredItems.Any())
            {
                @for (int i = 0; i < FilteredItems.Count; i++)
                {
                    var item = FilteredItems[i];
                    var isSelected = item.Value == Value;
                    var isHighlighted = i == _highlightedIndex;

                    <button type="button"
                            @onclick="() => SelectItem(item)"
                            class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-left text-xs sm:text-sm transition focus:outline-none @(isSelected ? "bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400 font-semibold" : isHighlighted ? "bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100/70 dark:hover:bg-slate-800/60")">
                        <div class="flex items-center gap-2 truncate">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <span>@item.Icon</span>
                            }
                            <span>@item.Label</span>
                        </div>
                        @if (isSelected)
                        {
                            <svg class="w-4 h-4 text-brand-600 dark:text-brand-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        }
                    </button>
                }
            }
            else
            {
                <div class="p-3 text-center text-xs text-slate-400 dark:text-slate-500">
                    No results found for "@_searchText"
                </div>
            }
        </div>
    }
</div>

@code {
    public sealed record ComboboxItem(string Value, string Label, string? Group = null, string? Icon = null);

    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<ComboboxItem> Items { get; set; } = Array.Empty<ComboboxItem>();
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Select or search option...";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    public bool IsOpen { get; private set; }
    private string _searchText = "";
    private int _highlightedIndex = 0;

    private ComboboxItem? SelectedItem => Items.FirstOrDefault(i => i.Value == Value);

    private IReadOnlyList<ComboboxItem> FilteredItems => string.IsNullOrWhiteSpace(_searchText)
        ? Items
        : Items.Where(i => i.Label.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                           i.Value.Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    private void OpenDropdown()
    {
        if (Disabled) return;
        _searchText = "";
        _highlightedIndex = 0;
        IsOpen = true;
    }

    private void ToggleDropdown()
    {
        if (Disabled) return;
        IsOpen = !IsOpen;
        if (IsOpen)
        {
            _searchText = "";
            _highlightedIndex = 0;
        }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _highlightedIndex = 0;
        IsOpen = true;
    }

    private async Task SelectItem(ComboboxItem item)
    {
        Value = item.Value;
        IsOpen = false;
        _searchText = "";
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task ClearSelection()
    {
        Value = "";
        _searchText = "";
        IsOpen = false;
        await ValueChanged.InvokeAsync("");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!IsOpen && (e.Key == "ArrowDown" || e.Key == "ArrowUp"))
        {
            OpenDropdown();
            return;
        }

        if (e.Key == "Escape")
        {
            IsOpen = false;
        }
        else if (e.Key == "ArrowDown")
        {
            if (_highlightedIndex < FilteredItems.Count - 1)
            {
                _highlightedIndex++;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (_highlightedIndex > 0)
            {
                _highlightedIndex--;
            }
        }
        else if (e.Key == "Enter")
        {
            if (FilteredItems.Count > 0 && _highlightedIndex >= 0 && _highlightedIndex < FilteredItems.Count)
            {
                await SelectItem(FilteredItems[_highlightedIndex]);
            }
        }
    }
}
