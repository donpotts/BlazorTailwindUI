@namespace BlazorTailwindUI.Components.UI

<div class="w-full space-y-1.5 @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="flex items-center justify-between">
            <label class="block text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
                @Label
                @if (Required)
                {
                    <span class="text-rose-500 ml-0.5">*</span>
                }
            </label>
            @if (!string.IsNullOrEmpty(HelperText))
            {
                <span class="text-xs text-slate-400">@HelperText</span>
            }
        </div>
    }

    <!-- Numeric Stepper Container -->
    <div class="relative flex items-center rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 overflow-hidden shadow-sm focus-within:ring-2 focus-within:ring-brand-500/50 focus-within:border-brand-500">
        <!-- Decrement Button -->
        <button type="button"
                @onclick="Decrement"
                disabled="@(Value <= Min)"
                class="px-3.5 py-2.5 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:cursor-not-allowed transition active:scale-95 focus:outline-none shrink-0"
                aria-label="Decrease value">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
            </svg>
        </button>

        <!-- Prefix if present -->
        @if (!string.IsNullOrEmpty(Prefix))
        {
            <span class="pl-2 text-xs font-semibold text-slate-400 select-none">@Prefix</span>
        }

        <!-- Number Input -->
        <input type="number"
               value="@Value"
               min="@Min"
               max="@Max"
               step="@Step"
               @onchange="HandleInputChange"
               class="w-full text-center py-2 text-sm font-bold text-slate-900 dark:text-white bg-transparent border-0 focus:ring-0 focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />

        <!-- Suffix if present -->
        @if (!string.IsNullOrEmpty(Suffix))
        {
            <span class="pr-2 text-xs font-semibold text-slate-400 select-none">@Suffix</span>
        }

        <!-- Increment Button -->
        <button type="button"
                @onclick="Increment"
                disabled="@(Value >= Max)"
                class="px-3.5 py-2.5 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:cursor-not-allowed transition active:scale-95 focus:outline-none shrink-0"
                aria-label="Increase value">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Prefix { get; set; }
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task Decrement()
    {
        if (Value - Step >= Min)
        {
            Value = Math.Round(Value - Step, 4);
            await ValueChanged.InvokeAsync(Value);
        }
    }

    private async Task Increment()
    {
        if (Value + Step <= Max)
        {
            Value = Math.Round(Value + Step, 4);
            await ValueChanged.InvokeAsync(Value);
        }
    }

    private async Task HandleInputChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var parsed))
        {
            Value = Math.Clamp(parsed, Min, Max);
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
