<div class="relative flex flex-col justify-between rounded-3xl p-6 sm:p-8 transition-all duration-300 @(IsPopular ? "bg-white dark:bg-slate-900 border-2 border-brand-500 shadow-xl shadow-brand-500/10 ring-4 ring-brand-500/10" : "bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xs hover:shadow-md") @Class">
    @if (IsPopular)
    {
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
            <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-brand-600 text-white shadow-sm">
                Most Popular
            </span>
        </div>
    }

    <div class="space-y-6">
        <div>
            <h4 class="text-lg font-bold text-slate-900 dark:text-white">@PlanName</h4>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">@Description</p>
            }
        </div>

        <div class="flex items-baseline gap-1">
            <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">@Price</span>
            <span class="text-xs text-slate-400 font-medium">/@Interval</span>
        </div>

        <div class="space-y-3 pt-2">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">What's included</p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
                @if (Features != null)
                {
                    @foreach (var feature in Features)
                    {
                        <li class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>@feature</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="mt-8 pt-4 border-t border-slate-100 dark:border-slate-800">
        <TwButton Variant="@(IsPopular ? ButtonVariant.Primary : ButtonVariant.Outline)"
                  ResponsiveFullWidth="true"
                  OnClick="OnClick">
            @CtaText
        </TwButton>
    </div>
</div>

@code {
    [Parameter] public string PlanName { get; set; } = "Pro";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Price { get; set; } = "$29";
    [Parameter] public string Interval { get; set; } = "mo";
    [Parameter] public bool IsPopular { get; set; }
    [Parameter] public IReadOnlyList<string>? Features { get; set; }
    [Parameter] public string CtaText { get; set; } = "Get Started";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
}
