@namespace BlazorTailwindUI.Components.UI
@using Microsoft.AspNetCore.Components

<div class="btui-nav-drawer @(IsOverlay ? "fixed inset-y-0 left-0 z-50 flex" : "relative flex shrink-0") @Class">
    <!-- Drawer Sidebar -->
    <aside class="flex flex-col bg-white dark:bg-slate-900 border-r border-slate-200/90 dark:border-slate-800 transition-all duration-300 shadow-sm @(IsMini ? "w-16" : "w-64")">
        <!-- Header / Brand Slot -->
        <div class="p-4 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-between gap-2 min-h-[60px]">
            @if (HeaderTemplate != null)
            {
                <div class="truncate">
                    @HeaderTemplate
                </div>
            }
            else
            {
                @if (!IsMini)
                {
                    <div class="flex items-center gap-2 truncate">
                        <span class="text-xl">⚡</span>
                        <span class="font-bold text-sm text-slate-900 dark:text-white truncate">@BrandTitle</span>
                    </div>
                }
                else
                {
                    <div class="w-full flex justify-center">
                        <span class="text-xl">⚡</span>
                    </div>
                }
            }

            @if (AllowToggleMini && !IsMini)
            {
                <button type="button"
                        @onclick="ToggleMini"
                        title="Collapse to Mini Rail"
                        class="p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                    </svg>
                </button>
            }
        </div>

        @if (AllowToggleMini && IsMini)
        {
            <!-- Expand Button in Mini Mode -->
            <div class="p-2 border-b border-slate-100 dark:border-slate-800 flex justify-center">
                <button type="button"
                        @onclick="ToggleMini"
                        title="Expand Navigation Drawer"
                        class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        }

        <!-- Navigation Menu Items -->
        <nav class="flex-1 overflow-y-auto p-2 space-y-1">
            <CascadingValue Value="@IsMini" Name="NavDrawerIsMini">
                <ul class="space-y-1">
                    @ChildContent
                </ul>
            </CascadingValue>
        </nav>

        <!-- Footer / User Slot -->
        @if (FooterTemplate != null)
        {
            <div class="p-3 border-t border-slate-200/80 dark:border-slate-800">
                @FooterTemplate
            </div>
        }
    </aside>

    @if (IsOverlay && IsOpen)
    {
        <!-- Backdrop for Overlay Mode -->
        <div class="fixed inset-0 z-40 bg-slate-950/50 backdrop-blur-xs transition-opacity" @onclick="CloseDrawer"></div>
    }
</div>

@code {
    [Parameter] public string BrandTitle { get; set; } = "Enterprise Hub";
    [Parameter] public bool IsMini { get; set; } = false;
    [Parameter] public EventCallback<bool> IsMiniChanged { get; set; }
    [Parameter] public bool IsOpen { get; set; } = true;
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsOverlay { get; set; } = false;
    [Parameter] public bool AllowToggleMini { get; set; } = true;
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment? FooterTemplate { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    public async Task ToggleMini()
    {
        IsMini = !IsMini;
        await IsMiniChanged.InvokeAsync(IsMini);
    }

    public async Task CloseDrawer()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
