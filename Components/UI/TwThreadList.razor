@implements IDisposable
@using BlazorTailwindUI.Services

<section aria-label="Conversation threads" class="flex flex-col gap-3 @Class" data-testid="thread-list">
    <div class="flex items-center gap-2">
        <label for="@_searchId" class="sr-only">Search threads</label>
        <input id="@_searchId" type="search" placeholder="Search threads" @bind="_query" @bind:event="oninput" data-testid="thread-search"
               class="flex-1 min-h-[40px] rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-3 text-sm text-slate-900 dark:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" />
        <button type="button" @onclick="NewThreadAsync" data-testid="thread-new"
                class="min-h-[40px] px-3 rounded-xl bg-brand-700 text-white text-sm font-bold hover:bg-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500">
            New
        </button>
    </div>

    <label class="inline-flex items-center gap-2 text-xs text-slate-700 dark:text-slate-300">
        <input type="checkbox" @bind="_showArchived" data-testid="thread-show-archived" class="rounded border-slate-400 text-brand-600 focus:ring-brand-500" />
        Show archived
    </label>

    <ul class="space-y-1.5" data-testid="thread-items">
        @foreach (var t in Visible())
        {
            var selected = t.Id == SelectedId;
            <li class="group rounded-xl border @(selected ? "border-brand-500 bg-brand-50 dark:bg-brand-500/10" : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900") @(t.Archived ? "opacity-70" : "")"
                data-testid="thread-item" data-thread="@t.Id" data-pinned="@t.Pinned.ToString().ToLowerInvariant()" data-archived="@t.Archived.ToString().ToLowerInvariant()">
                @if (_renaming == t.Id)
                {
                    <form class="flex gap-1 p-2" @onsubmit="() => CommitRename(t.Id)" @onsubmit:preventDefault="true">
                        <label for="@($"rename-{t.Id}")" class="sr-only">Thread title</label>
                        <input id="@($"rename-{t.Id}")" @bind="_draftTitle" @bind:event="oninput" data-testid="thread-rename-input"
                               class="flex-1 min-h-[36px] rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-950 px-2 text-sm text-slate-900 dark:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500" />
                        <button type="submit" data-testid="thread-rename-save" class="px-2 rounded-lg bg-brand-700 text-white text-xs font-bold">Save</button>
                        <button type="button" @onclick="() => _renaming = null" class="px-2 rounded-lg border border-slate-300 dark:border-slate-600 text-xs font-semibold text-slate-800 dark:text-slate-200">Cancel</button>
                    </form>
                }
                else
                {
                    <button type="button" @onclick="() => SelectAsync(t)" aria-current="@(selected ? "true" : null)" data-testid="thread-select"
                            class="w-full text-start px-3 pt-2.5 pb-1 rounded-t-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                        <span class="flex items-center gap-1.5">
                            @if (t.Pinned)
                            {
                                <span class="text-[10px] font-bold uppercase text-brand-800 dark:text-brand-200">Pinned</span>
                            }
                            <span class="text-sm font-bold text-slate-900 dark:text-white truncate" data-testid="thread-title">@t.Title</span>
                        </span>
                        <span class="block text-xs text-slate-600 dark:text-slate-400 truncate">@(string.IsNullOrEmpty(t.Preview) ? "No messages yet" : t.Preview)</span>
                    </button>
                    <div class="flex items-center gap-1 px-2 pb-2">
                        <button type="button" @onclick="() => Store.SetPinned(t.Id, !t.Pinned)" data-testid="thread-pin" aria-pressed="@t.Pinned.ToString().ToLowerInvariant()"
                                class="px-2 py-1 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">@(t.Pinned ? "Unpin" : "Pin")</button>
                        <button type="button" @onclick="() => StartRename(t)" data-testid="thread-rename"
                                class="px-2 py-1 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">Rename</button>
                        <button type="button" @onclick="() => Store.SetArchived(t.Id, !t.Archived)" data-testid="thread-archive"
                                class="px-2 py-1 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">@(t.Archived ? "Restore" : "Archive")</button>
                        <button type="button" @onclick="() => DeleteAsync(t)" data-testid="thread-delete"
                                class="px-2 py-1 rounded-lg text-xs font-semibold text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500">Delete</button>
                    </div>
                }
            </li>
        }
    </ul>
    @if (!Visible().Any())
    {
        <p class="text-sm text-slate-600 dark:text-slate-400" data-testid="thread-empty">@(string.IsNullOrWhiteSpace(_query) ? "No threads yet. Start one with New." : "No threads match your search.")</p>
    }
</section>

@code {
    private readonly string _searchId = "thread-search-" + Guid.NewGuid().ToString("N")[..6];
    private string _query = "";
    private bool _showArchived;
    private string? _renaming;
    private string _draftTitle = "";
    private IAgentThreadStore? _subscribed;

    [Parameter, EditorRequired] public IAgentThreadStore Store { get; set; } = default!;
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<AgentThread> OnSelect { get; set; }
    [Parameter] public EventCallback<AgentThread> OnCreated { get; set; }
    [Parameter] public EventCallback<AgentThread> OnDeleted { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Store)) return;
        if (_subscribed is not null) _subscribed.Changed -= OnStoreChanged;
        _subscribed = Store;
        _subscribed.Changed += OnStoreChanged;
    }

    private void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    private IEnumerable<AgentThread> Visible() => Store.All
        .Where(t => _showArchived || !t.Archived || t.Id == SelectedId)
        .Where(t => string.IsNullOrWhiteSpace(_query)
            || t.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)
            || t.Messages.Any(m => m.Text.Contains(_query, StringComparison.OrdinalIgnoreCase)));

    private async Task NewThreadAsync()
    {
        var t = Store.Create();
        await OnCreated.InvokeAsync(t);
        await OnSelect.InvokeAsync(t);
    }

    private Task SelectAsync(AgentThread t) => OnSelect.InvokeAsync(t);

    private void StartRename(AgentThread t)
    {
        _renaming = t.Id;
        _draftTitle = t.Title;
    }

    private void CommitRename(string id)
    {
        Store.Rename(id, _draftTitle);
        _renaming = null;
    }

    private async Task DeleteAsync(AgentThread t)
    {
        Store.Delete(t.Id);
        await OnDeleted.InvokeAsync(t);
    }

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.Changed -= OnStoreChanged;
    }
}
