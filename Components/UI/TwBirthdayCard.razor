            PerkGrantTitle = "Luxury Day Spa Retreat Package + Floral Arrangement",
            PerkGrantDescription = "A wholehearted thank you for nurturing our extraordinary workplace culture.",
            Signatures = new()
            {
                new() { AuthorName = "Sarah Jenkins", AuthorRole = "Cloud Lead", Emoji = "❤️", Message = "Happy birthday Elena! You make our company feel like a genuine community!", TimeAgo = "30m ago" },
