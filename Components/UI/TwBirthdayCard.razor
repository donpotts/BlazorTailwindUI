            RoleHumorGreeting = "May your sales pipeline overflow, enterprise deals close ahead of quarter end, and the office victory gong ring all afternoon long!",
            PerkGrantTitle = "Master Sommelier Wine Selection + Gourmet Dinner Voucher",
            PerkGrantDescription = "Reward package for relentless energy and client dedication.",
            Signatures = new()
            {
                new() { AuthorName = "Jordan Hayes", AuthorRole = "Lead PM", Emoji = "🍾", Message = "Happy birthday Liam! Ring the gong loud and proud today!", TimeAgo = "45m ago" },
                new() { AuthorName = "Marcus Vance", AuthorRole = "VP Engineering", Emoji = "🎉", Message = "Have a fantastic celebration Liam, cheers from the whole crew!", TimeAgo = "1h ago" }
            }
        }
    };

    private void SwitchRole(int index)
    {
        _selectedRoleIndex = index;
        _isCardOpened = false;
    }

    private async Task OpenCard()
    {
        _isCardOpened = true;
        await TriggerCelebrationBurst();
    }

    private async Task TriggerCelebrationBurst()
    {
        if (_confettiRef != null)
        {
            await _confettiRef.FireStyleAsync(ActiveRole.ConfettiStyle, 0.5, 0.45, 160);
        }

        try
        {
            await JS.InvokeVoidAsync("playWheelSound", "select");
        }
        catch {}

        Toast.Show($"Happy Birthday {ActiveRole.Name}!", $"Celebrated {ActiveRole.Title} with {ActiveRole.ConfettiStyle} particles.", SemanticVariant.Success);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newMessage))
        {
            SubmitSignature();
        }
    }

    private void SubmitSignature()
    {
        if (string.IsNullOrWhiteSpace(_newMessage)) return;

        var author = string.IsNullOrWhiteSpace(_newAuthorName) ? "Teammate" : _newAuthorName.Trim();
        var role = string.IsNullOrWhiteSpace(_newAuthorRole) ? "Colleague" : _newAuthorRole.Trim();

        ActiveRole.Signatures.Insert(0, new TeamSignature
        {
            AuthorName = author,
            AuthorRole = role,
            Emoji = _selectedSigEmoji,
            Message = _newMessage.Trim(),
            TimeAgo = "Just now"
        });

        _newMessage = "";
        Toast.Show("Wishes Posted!", $"Added your birthday message to {ActiveRole.Name}'s digital card.", SemanticVariant.Success);
    }
}
