@namespace BlazorTailwindUI.Components.UI

<div class="relative @ContainerClass @Class">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    public enum TimelinePosition
    {
        Start,
        Alternate
    }

    [Parameter] public TimelinePosition Position { get; set; } = TimelinePosition.Start;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ContainerClass => "space-y-6";
}
