@namespace BlazorTailwindUI.Components.UI
@inject IJSRuntime JS

<div class="relative rounded-2xl overflow-hidden bg-slate-950 text-slate-200 border border-slate-800/80 shadow-xl font-mono text-xs sm:text-sm select-none @Class">
    <!-- Header Bar -->
    @if (ShowHeader || !string.IsNullOrEmpty(Title))
    {
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-900/90 border-b border-slate-800/80">
            <div class="flex items-center gap-2">
                @if (ShowWindowControls)
                {
                    <div class="flex items-center gap-1.5 mr-2">
                        <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Title))
                {
                    <span class="text-xs text-slate-400 font-semibold font-sans">@Title</span>
                }
            </div>

            @if (ShowCopyButton)
            {
                <button type="button"
                        @onclick="CopyCode"
                        class="px-2 py-1 rounded-lg text-xs font-sans font-medium transition flex items-center gap-1.5 @(_copied ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" : "bg-slate-800/80 text-slate-400 hover:text-white hover:bg-slate-700/80 border border-slate-700/60")"
                        title="Copy command to clipboard">
                    @if (_copied)
                    {
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Copied!</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Copy</span>
                    }
                </button>
            }
        </div>
    }

    <!-- Command Snippet Body -->
    <div class="p-4 flex items-center justify-between gap-4 overflow-x-auto">
        <div class="flex items-center gap-2.5 font-mono">
            @if (!string.IsNullOrEmpty(Prefix))
            {
                <span class="text-brand-400 select-none font-bold">@Prefix</span>
            }
            <span class="text-slate-100 select-text">@Code</span>
        </div>

        @if (!ShowHeader && ShowCopyButton)
        {
            <button type="button"
                    @onclick="CopyCode"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/80 transition flex-shrink-0"
                    title="Copy command">
                @if (_copied)
                {
                    <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                }
            </button>
        }
    </div>
</div>

@code {
    private bool _copied = false;

    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string Prefix { get; set; } = "$";
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowWindowControls { get; set; } = true;
    [Parameter] public bool ShowCopyButton { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private async Task CopyCode()
    {
        if (string.IsNullOrWhiteSpace(Code)) return;

        try
        {
            await JS.InvokeVoidAsync("blazorClipboard.copyText", Code);
            _copied = true;
            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _copied = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch
        { }
    }
}
