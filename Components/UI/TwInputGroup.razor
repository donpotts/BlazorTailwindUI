@namespace BlazorTailwindUI.Components.UI

<div class="space-y-1.5 @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
            @Label
        </label>
    }

    <!-- Input Addon Wrapper -->
    <div class="flex rounded-xl shadow-xs transition-all border @(HasError ? "border-rose-500 focus-within:ring-2 focus-within:ring-rose-500/20" : "border-slate-300 dark:border-slate-700 focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20") bg-white dark:bg-slate-900 overflow-hidden @(Disabled ? "opacity-50 cursor-not-allowed" : "")">
        <!-- Prepend Addon Slot -->
        @if (PrependContent != null || !string.IsNullOrEmpty(PrependText))
        {
            <div class="inline-flex items-center px-3.5 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-700 text-xs sm:text-sm font-medium shrink-0 select-none">
                @if (PrependContent != null)
                {
                    @PrependContent
                }
                else
                {
                    <span>@PrependText</span>
                }
            </div>
        }

        <!-- Native Input -->
        <input type="@Type"
               value="@Value"
               @oninput="HandleInput"
               placeholder="@Placeholder"
               disabled="@Disabled"
               class="flex-1 min-w-0 px-3.5 py-2.5 bg-transparent border-0 text-xs sm:text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none" />

        <!-- Append Addon Slot -->
        @if (AppendContent != null || !string.IsNullOrEmpty(AppendText))
        {
            <div class="inline-flex items-center px-3.5 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-l border-slate-300 dark:border-slate-700 text-xs sm:text-sm font-medium shrink-0 select-none">
                @if (AppendContent != null)
                {
                    @AppendContent
                }
                else
                {
                    <span>@AppendText</span>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(HelperText) || !string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="text-[11px] @(HasError ? "text-rose-500 font-medium" : "text-slate-500 dark:text-slate-400")">
            @(HasError ? ErrorMessage : HelperText)
        </p>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string? PrependText { get; set; }
    [Parameter] public string? AppendText { get; set; }
    [Parameter] public string? PrefixText { get => PrependText; set => PrependText = value; }
    [Parameter] public string? SuffixText { get => AppendText; set => AppendText = value; }
    [Parameter] public RenderFragment? PrependContent { get; set; }
    [Parameter] public RenderFragment? AppendContent { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }
}
