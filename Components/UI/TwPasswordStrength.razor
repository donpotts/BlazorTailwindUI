@namespace BlazorTailwindUI.Components.UI
@using System.Text.RegularExpressions

<div class="space-y-3 @Class">
    <!-- Label -->
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="flex items-center justify-between">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                @Label
            </label>
            @if (!string.IsNullOrEmpty(Value))
            {
                <span class="text-[11px] font-bold @StrengthTextColor">
                    @StrengthLabel
                </span>
            }
        </div>
    }

    <!-- Input with Show/Hide toggle -->
    <div class="relative">
        <input type="@(_showPassword ? "text" : "password")"
               value="@Value"
               @oninput="HandleInput"
               placeholder="@Placeholder"
               disabled="@Disabled"
               class="w-full pl-3.5 pr-10 py-2.5 rounded-xl border text-xs sm:text-sm transition-all focus:outline-none @(Disabled ? "opacity-50 cursor-not-allowed" : "") border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20" />

        <button type="button"
                @onclick="() => _showPassword = !_showPassword"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition focus:outline-none"
                aria-label="@(_showPassword ? "Hide password" : "Show password")">
            @if (_showPassword)
            {
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
            }
            else
            {
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
            }
        </button>
    </div>

    <!-- 4-Stage Strength Progress Bar -->
    @if (!string.IsNullOrEmpty(Value))
    {
        <div class="space-y-1.5">
            <div class="grid grid-cols-4 gap-1.5 h-1.5 w-full">
                <div class="h-full rounded-full transition-all duration-300 @(Score >= 1 ? StrengthBarColor : "bg-slate-200 dark:bg-slate-800")"></div>
                <div class="h-full rounded-full transition-all duration-300 @(Score >= 2 ? StrengthBarColor : "bg-slate-200 dark:bg-slate-800")"></div>
                <div class="h-full rounded-full transition-all duration-300 @(Score >= 3 ? StrengthBarColor : "bg-slate-200 dark:bg-slate-800")"></div>
                <div class="h-full rounded-full transition-all duration-300 @(Score >= 4 ? StrengthBarColor : "bg-slate-200 dark:bg-slate-800")"></div>
            </div>
        </div>
    }

    <!-- Live Requirements Checklist -->
    @if (ShowChecklist)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 text-xs text-slate-600 dark:text-slate-400">
            <div class="flex items-center gap-1.5 @(HasMinLength ? "text-emerald-600 dark:text-emerald-400 font-semibold" : "")">
                <span class="w-3.5 h-3.5 rounded-full flex items-center justify-center text-[10px] @(HasMinLength ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400" : "bg-slate-100 dark:bg-slate-800 text-slate-400")">
                    @(HasMinLength ? "✓" : "○")
                </span>
                <span>At least 8 characters</span>
            </div>
            <div class="flex items-center gap-1.5 @(HasUppercase ? "text-emerald-600 dark:text-emerald-400 font-semibold" : "")">
                <span class="w-3.5 h-3.5 rounded-full flex items-center justify-center text-[10px] @(HasUppercase ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400" : "bg-slate-100 dark:bg-slate-800 text-slate-400")">
                    @(HasUppercase ? "✓" : "○")
                </span>
                <span>Uppercase letter (A-Z)</span>
            </div>
            <div class="flex items-center gap-1.5 @(HasLowercase ? "text-emerald-600 dark:text-emerald-400 font-semibold" : "")">
                <span class="w-3.5 h-3.5 rounded-full flex items-center justify-center text-[10px] @(HasLowercase ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400" : "bg-slate-100 dark:bg-slate-800 text-slate-400")">
                    @(HasLowercase ? "✓" : "○")
                </span>
                <span>Lowercase letter (a-z)</span>
            </div>
            <div class="flex items-center gap-1.5 @(HasNumber ? "text-emerald-600 dark:text-emerald-400 font-semibold" : "")">
                <span class="w-3.5 h-3.5 rounded-full flex items-center justify-center text-[10px] @(HasNumber ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400" : "bg-slate-100 dark:bg-slate-800 text-slate-400")">
                    @(HasNumber ? "✓" : "○")
                </span>
                <span>Number (0-9)</span>
            </div>
            <div class="flex items-center gap-1.5 @(HasSpecial ? "text-emerald-600 dark:text-emerald-400 font-semibold" : "")">
                <span class="w-3.5 h-3.5 rounded-full flex items-center justify-center text-[10px] @(HasSpecial ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400" : "bg-slate-100 dark:bg-slate-800 text-slate-400")">
                    @(HasSpecial ? "✓" : "○")
                </span>
                <span>Special symbol (!@@#$%^&*)</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Password { get => Value; set => Value = value; }
    [Parameter] public EventCallback<string> PasswordChanged { get => ValueChanged; set => ValueChanged = value; }
    [Parameter] public string Label { get; set; } = "Password";
    [Parameter] public string Placeholder { get; set; } = "Enter a secure password...";
    [Parameter] public bool ShowChecklist { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _showPassword = false;

    private bool HasMinLength => (Value?.Length ?? 0) >= 8;
    private bool HasUppercase => Regex.IsMatch(Value ?? "", "[A-Z]");
    private bool HasLowercase => Regex.IsMatch(Value ?? "", "[a-z]");
    private bool HasNumber => Regex.IsMatch(Value ?? "", "[0-9]");
    private bool HasSpecial => Regex.IsMatch(Value ?? "", @"[!@#$%^&*()_+\-=\[\]{};':"",.<>/?]");

    public int Score
    {
        get
        {
            if (string.IsNullOrEmpty(Value)) return 0;
            int score = 0;
            if (HasMinLength) score++;
            if (HasUppercase && HasLowercase) score++;
            if (HasNumber) score++;
            if (HasSpecial) score++;
            return score;
        }
    }

    private string StrengthLabel => Score switch
    {
        0 or 1 => "Weak",
        2 => "Fair",
        3 => "Good",
        4 => "Strong",
        _ => ""
    };

    private string StrengthTextColor => Score switch
    {
        0 or 1 => "text-rose-500",
        2 => "text-amber-500",
        3 => "text-sky-500",
        4 => "text-emerald-500",
        _ => "text-slate-400"
    };

    private string StrengthBarColor => Score switch
    {
        0 or 1 => "bg-rose-500",
        2 => "bg-amber-500",
        3 => "bg-sky-500",
        4 => "bg-emerald-500",
        _ => "bg-slate-300"
    };

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);
    }
}
