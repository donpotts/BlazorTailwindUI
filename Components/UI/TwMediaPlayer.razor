@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_containerRef"
     class="group relative rounded-3xl overflow-hidden bg-slate-950 border border-slate-800 shadow-2xl select-none transition-all @(IsAudio ? "p-6" : "") @Class"
     @onmousemove="HandleMouseMove"
     @onmouseleave="HandleMouseLeave">

    @if (!IsAudio)
    {
        <!-- HTML5 Video Element -->
        <video @ref="_mediaRef"
               src="@Src"
               poster="@(Poster ?? "videos/poster.jpg")"
               preload="metadata"
               playsinline
               loop="@Loop"
               @onclick="TogglePlayPause"
               class="w-full h-auto aspect-video object-cover cursor-pointer block bg-black"></video>

        <!-- Big Center Play Button Overlay (when paused) -->
        @if (!_isPlaying)
        {
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
                <button type="button"
                        @onclick="TogglePlayPause"
                        class="pointer-events-auto w-16 sm:w-20 h-16 sm:h-20 rounded-full bg-white/20 backdrop-blur-md border border-white/40 text-white flex items-center justify-center hover:scale-110 hover:bg-brand-600 hover:border-brand-500 transition-all duration-300 shadow-2xl shadow-black/50 group-hover:scale-105"
                        aria-label="Play Video">
                    <svg class="w-8 sm:w-10 h-8 sm:h-10 ml-1 text-white fill-current" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                    </svg>
                </button>
            </div>
        }

        <!-- Top Header Info Overlay (Fade on idle) -->
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <div class="absolute top-0 inset-x-0 p-4 sm:p-6 bg-gradient-to-b from-black/80 via-black/30 to-transparent z-20 transition-opacity duration-300 @ControlsVisibilityClass">
                <div class="flex items-center justify-between">
                    <div>
                        <h4 class="text-white font-bold text-sm sm:text-base drop-shadow-md">@Title</h4>
                        @if (!string.IsNullOrWhiteSpace(Subtitle))
                        {
                            <p class="text-xs text-slate-300 drop-shadow-sm">@Subtitle</p>
                        }
                    </div>
                    @if (Chapters != null && Chapters.Any())
                    {
                        <span class="text-[11px] font-semibold text-brand-300 px-2.5 py-0.5 rounded-full bg-brand-500/20 backdrop-blur-md border border-brand-500/30">
                            @GetCurrentChapterTitle()
                        </span>
                    }
                </div>
            </div>
        }

        <!-- Bottom Controls Bar Overlay -->
        <div class="absolute bottom-0 inset-x-0 p-3 sm:p-5 bg-gradient-to-t from-black/90 via-black/50 to-transparent z-20 transition-opacity duration-300 @ControlsVisibilityClass">
            <!-- Scrubber Track & Chapters -->
            <div @ref="_scrubberRef"
                 class="relative w-full h-3 mb-2 flex items-center cursor-pointer group/scrubber"
                 @onclick="HandleScrubberClick">
                <!-- Track Background -->
                <div class="absolute inset-x-0 h-1.5 rounded-full bg-white/20 group-hover/scrubber:h-2 transition-all"></div>
                <!-- Buffered Progress -->
                <div class="absolute left-0 h-1.5 rounded-full bg-white/40 group-hover/scrubber:h-2 transition-all"
                     style="width: @(BufferedPercent)%"></div>
                <!-- Played Progress -->
                <div class="absolute left-0 h-1.5 rounded-full bg-brand-500 group-hover/scrubber:h-2 transition-all"
                     style="width: @(ProgressPercent)%"></div>
                <!-- Glowing Thumb -->
                <div class="absolute w-3.5 h-3.5 rounded-full bg-white shadow-md shadow-brand-500/80 -translate-x-1/2 opacity-0 group-hover/scrubber:opacity-100 transition-opacity"
                     style="left: @(ProgressPercent)%"></div>

                <!-- Chapter Cue Ticks -->
                @if (Chapters != null && Duration > 0)
                {
                    @foreach (var ch in Chapters)
                    {
                        var left = (ch.TimeSeconds / Duration) * 100.0;
                        <div class="absolute w-1 h-3 bg-white/70 rounded-full -translate-x-1/2 z-10 hover:w-1.5 hover:bg-brand-400 transition-all pointer-events-none"
                             style="left: @(left)%"
                             title="@ch.Title (@FormatTime(ch.TimeSeconds))"></div>
                    }
                }
            </div>

            <!-- Controls Row -->
            <div class="flex items-center justify-between text-white text-xs sm:text-sm">
                <!-- Left: Play/Pause, Skips, Volume, Timestamp -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <button type="button"
                            @onclick="TogglePlayPause"
                            class="p-2 rounded-xl text-white hover:bg-white/20 transition focus:outline-hidden"
                            title="@(_isPlaying ? "Pause (Space)" : "Play (Space)")">
                        @if (_isPlaying)
                        {
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                        }
                    </button>

                    <!-- Skip -10s -->
                    <button type="button"
                            @onclick="() => SeekRelative(-10)"
                            class="p-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition hidden sm:inline-flex items-center"
                            title="Rewind 10s">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.333 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z" />
                        </svg>
                    </button>

                    <!-- Skip +10s -->
                    <button type="button"
                            @onclick="() => SeekRelative(10)"
                            class="p-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition hidden sm:inline-flex items-center"
                            title="Forward 10s">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.933 12.8a1 1 0 000-1.6L6.6 7.2A1 1 0 005 8v8a1 1 0 001.6.8l5.333-4zM19.933 12.8a1 1 0 000-1.6l-5.333-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.333-4z" />
                        </svg>
                    </button>

                    <!-- Volume Control with Hover Slider -->
                    <div class="flex items-center gap-1.5 group/vol">
                        <button type="button"
                                @onclick="ToggleMute"
                                class="p-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition"
                                title="@(_isMuted ? "Unmute (M)" : "Mute (M)")">
                            @if (_isMuted || _volume == 0)
                            {
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                                </svg>
                            }
                            else if (_volume < 0.5)
                            {
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                </svg>
                            }
                        </button>
                        <input type="range"
                               min="0"
                               max="1"
                               step="0.05"
                               value="@(_isMuted ? 0 : _volume)"
                               @oninput="HandleVolumeChange"
                               class="w-16 h-1 bg-white/30 rounded-lg appearance-none cursor-pointer accent-brand-500 hidden sm:group-hover/vol:inline-block transition-all" />
                    </div>

                    <!-- Timestamps -->
                    <div class="text-[11px] font-mono text-slate-300 ml-1">
                        <span>@FormatTime(CurrentTime)</span>
                        <span class="text-slate-500"> / </span>
                        <span>@FormatTime(Duration)</span>
                    </div>
                </div>

                <!-- Right: Speed, PiP, Fullscreen -->
                <div class="flex items-center gap-1.5 sm:gap-2">
                    <!-- Playback Speed -->
                    <button type="button"
                            @onclick="CyclePlaybackSpeed"
                            class="px-2 py-0.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-mono text-slate-200 transition font-bold"
                            title="Playback Speed">
                        @(_playbackRate)x
                    </button>

                    <!-- Picture in Picture -->
                    <button type="button"
                            @onclick="TogglePiP"
                            class="p-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition hidden sm:inline-block"
                            title="Picture in Picture">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </button>

                    <!-- Fullscreen -->
                    <button type="button"
                            @onclick="ToggleFullscreen"
                            class="p-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition"
                            title="Toggle Fullscreen (F)">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Audio Mode Card -->
        <audio @ref="_mediaRef" src="@Src" loop="@Loop" preload="metadata"></audio>

        <div class="space-y-5">
            <!-- Header with Vinyl / Waveform Animation -->
            <div class="flex items-center gap-4">
                <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-brand-500/20 shrink-0 @(_isPlaying ? "animate-pulse-glow" : "")">
                    <svg class="w-8 h-8 @(_isPlaying ? "animate-spin" : "")" style="animation-duration: 4s;" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z" />
                    </svg>
                </div>

                <div class="grow min-w-0">
                    <h4 class="text-white font-bold text-base truncate">@Title</h4>
                    <p class="text-xs text-slate-400 truncate">@(Subtitle ?? "Audio Stream")</p>
                    <!-- Audio Waveform Ticker Bars -->
                    <div class="flex items-end gap-1 h-4 mt-2">
                        @for (int i = 0; i < 16; i++)
                        {
                            var h = _isPlaying ? (15 + (i * 17) % 85) : 20;
                            <div class="w-1 bg-brand-500 rounded-full transition-all duration-300"
                                 style="height: @(h)%"></div>
                        }
                    </div>
                </div>
            </div>

            <!-- Audio Scrubber Track -->
            <div class="space-y-1">
                <div class="relative w-full h-2 rounded-full bg-slate-800 cursor-pointer"
                     @onclick="HandleScrubberClick">
                    <div class="absolute left-0 h-full rounded-full bg-brand-500 transition-all"
                         style="width: @(ProgressPercent)%"></div>
                    <div class="absolute w-3 h-3 rounded-full bg-white shadow-md shadow-brand-500/50 -translate-x-1/2 -top-0.5"
                         style="left: @(ProgressPercent)%"></div>
                </div>
                <div class="flex justify-between text-[11px] font-mono text-slate-400">
                    <span>@FormatTime(CurrentTime)</span>
                    <span>@FormatTime(Duration)</span>
                </div>
            </div>

            <!-- Audio Controls Bar -->
            <div class="flex items-center justify-between pt-2 border-t border-slate-800">
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="TogglePlayPause" class="p-2.5 rounded-full bg-brand-600 hover:bg-brand-500 text-white shadow-lg transition">
                        @if (_isPlaying)
                        {
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                        }
                    </button>
                    <button type="button" @onclick="() => SeekRelative(-10)" class="p-2 text-slate-400 hover:text-white transition" title="Rewind 10s">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.333 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z" /></svg>
                    </button>
                    <button type="button" @onclick="() => SeekRelative(10)" class="p-2 text-slate-400 hover:text-white transition" title="Forward 10s">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.933 12.8a1 1 0 000-1.6L6.6 7.2A1 1 0 005 8v8a1 1 0 001.6.8l5.333-4zM19.933 12.8a1 1 0 000-1.6l-5.333-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.333-4z" /></svg>
                    </button>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" @onclick="CyclePlaybackSpeed" class="px-2 py-0.5 rounded-md bg-slate-800 text-xs font-mono text-slate-300">
                        @(_playbackRate)x
                    </button>
                    <button type="button" @onclick="ToggleMute" class="p-1.5 text-slate-400 hover:text-white transition">
                        @if (_isMuted || _volume == 0)
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" /></svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    public enum MediaKind
    {
        Video,
        Audio
    }

    public class MediaChapter
    {
        public double TimeSeconds { get; set; }
        public string Title { get; set; } = string.Empty;

        public MediaChapter() { }
        public MediaChapter(double timeSeconds, string title)
        {
            TimeSeconds = timeSeconds;
            Title = title;
        }
    }

    public class MediaStatePayload
    {
        public double CurrentTime { get; set; }
        public double Duration { get; set; }
        public bool Paused { get; set; }
        public bool Muted { get; set; }
        public double Volume { get; set; }
        public double PlaybackRate { get; set; }
        public double BufferedEnd { get; set; }
        public bool Ended { get; set; }
    }

    [Parameter] public string Src { get; set; } = string.Empty;
    [Parameter] public string? Poster { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public MediaKind Type { get; set; } = MediaKind.Video;
    [Parameter] public bool Loop { get; set; }
    [Parameter] public List<MediaChapter>? Chapters { get; set; }
    [Parameter] public string? Class { get; set; }

    private ElementReference _containerRef;
    private ElementReference _mediaRef;
    private ElementReference _scrubberRef;
    private DotNetObjectReference<TwMediaPlayer>? _dotNetRef;

    private bool _isPlaying = false;
    private bool _isMuted = false;
    private double _volume = 1.0;
    private double _playbackRate = 1.0;
    private double CurrentTime { get; set; } = 0;
    private double Duration { get; set; } = 0;
    private double BufferedEnd { get; set; } = 0;
    private bool _controlsVisible = true;
    private System.Threading.Timer? _idleTimer;

    private bool IsAudio => Type == MediaKind.Audio;
    private double ProgressPercent => Duration > 0 ? Math.Min(100.0, (CurrentTime / Duration) * 100.0) : 0;
    private double BufferedPercent => Duration > 0 ? Math.Min(100.0, (BufferedEnd / Duration) * 100.0) : 0;
    private string ControlsVisibilityClass => (_isPlaying && !_controlsVisible) ? "opacity-0 pointer-events-none" : "opacity-100 pointer-events-auto";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("blazorMediaPlayer.init", _mediaRef, _dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public void OnMediaStateUpdate(MediaStatePayload payload)
    {
        CurrentTime = payload.CurrentTime;
        Duration = payload.Duration;
        _isPlaying = !payload.Paused;
        _isMuted = payload.Muted;
        _volume = payload.Volume;
        _playbackRate = payload.PlaybackRate;
        BufferedEnd = payload.BufferedEnd;
        StateHasChanged();
    }

    public async Task PlayAsync()
    {
        try { await JS.InvokeVoidAsync("blazorMediaPlayer.play", _mediaRef); } catch { }
    }

    public async Task PauseAsync()
    {
        try { await JS.InvokeVoidAsync("blazorMediaPlayer.pause", _mediaRef); } catch { }
    }

    public async Task TogglePlayPause()
    {
        if (_isPlaying)
        {
            await PauseAsync();
        }
        else
        {
            await PlayAsync();
        }
    }

    public async Task SeekTo(double seconds)
    {
        try
        {
            await JS.InvokeVoidAsync("blazorMediaPlayer.setCurrentTime", _mediaRef, seconds);
        }
        catch { }
    }

    public async Task SeekRelative(double deltaSeconds)
    {
        var target = Math.Max(0, Math.Min(Duration, CurrentTime + deltaSeconds));
        await SeekTo(target);
    }

    private async Task HandleScrubberClick(MouseEventArgs e)
    {
        if (Duration <= 0) return;
        try
        {
            await JS.InvokeVoidAsync("blazorMediaPlayer.seekFromEvent", _mediaRef, _scrubberRef, e.ClientX);
        }
        catch { }
    }

    private async Task HandleVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var vol))
        {
            _volume = vol;
            _isMuted = vol == 0;
            try
            {
                await JS.InvokeVoidAsync("blazorMediaPlayer.setVolume", _mediaRef, vol);
            }
            catch { }
        }
    }

    private async Task ToggleMute()
    {
        _isMuted = !_isMuted;
        try
        {
            await JS.InvokeVoidAsync("blazorMediaPlayer.setMuted", _mediaRef, _isMuted);
        }
        catch { }
    }

    private async Task CyclePlaybackSpeed()
    {
        var speeds = new[] { 0.5, 1.0, 1.25, 1.5, 2.0 };
        var currentIndex = Array.IndexOf(speeds, _playbackRate);
        var nextIndex = (currentIndex + 1) % speeds.Length;
        _playbackRate = speeds[nextIndex];
        try
        {
            await JS.InvokeVoidAsync("blazorMediaPlayer.setPlaybackRate", _mediaRef, _playbackRate);
        }
        catch { }
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            await JS.InvokeVoidAsync("blazorMediaPlayer.toggleFullscreen", _containerRef);
        }
        catch { }
    }

    private async Task TogglePiP()
    {
        try
        {
            await JS.InvokeVoidAsync("blazorMediaPlayer.togglePiP", _mediaRef);
        }
        catch { }
    }

    private void HandleMouseMove()
    {
        _controlsVisible = true;
        ResetIdleTimer();
    }

    private void HandleMouseLeave()
    {
        if (_isPlaying)
        {
            _controlsVisible = false;
        }
    }

    private void ResetIdleTimer()
    {
        _idleTimer?.Dispose();
        _idleTimer = new System.Threading.Timer(_ =>
        {
            if (_isPlaying)
            {
                _controlsVisible = false;
                InvokeAsync(StateHasChanged);
            }
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    private string GetCurrentChapterTitle()
    {
        if (Chapters == null || !Chapters.Any()) return string.Empty;
        var ch = Chapters.LastOrDefault(c => c.TimeSeconds <= CurrentTime);
        return ch?.Title ?? Chapters.First().Title;
    }

    private string FormatTime(double totalSeconds)
    {
        if (double.IsNaN(totalSeconds) || double.IsInfinity(totalSeconds) || totalSeconds < 0)
            return "00:00";

        var ts = TimeSpan.FromSeconds(totalSeconds);
        return ts.TotalHours >= 1
            ? ts.ToString(@"hh\:mm\:ss")
            : ts.ToString(@"mm\:ss");
    }

    public async ValueTask DisposeAsync()
    {
        _idleTimer?.Dispose();
        _dotNetRef?.Dispose();
    }
}
