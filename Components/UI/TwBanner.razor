@if (_isVisible)
{
    <div class="relative isolate flex items-center gap-x-4 sm:gap-x-6 overflow-hidden bg-slate-900 px-4 py-2.5 sm:px-6 sm:py-3 text-white text-xs sm:text-sm shadow-md @(IsSticky ? "sticky top-0 z-40" : "") @Class">
        <!-- Background Gradient Glow Accents -->
        <div class="absolute left-[max(-7rem,calc(50%-52rem))] top-1/2 -z-10 -translate-y-1/2 transform-gpu blur-2xl pointer-events-none" aria-hidden="true">
            <div class="aspect-577/310 w-[36.0625rem] bg-gradient-to-r from-brand-500 to-indigo-500 opacity-30"
                 style="clip-path: polygon(74.8% 41.9%, 97.2% 73.2%, 100% 34.9%, 92.5% 0.4%, 87.5% 0%, 75% 28.6%, 58.5% 54.6%, 50.1% 56.8%, 46.9% 44%, 48.3% 17.4%, 24.7% 53.9%, 0% 27.9%, 11.9% 74.2%, 24.9% 54.1%, 68.6% 100%, 74.8% 41.9%)"></div>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 grow justify-center">
            @if (!string.IsNullOrWhiteSpace(BadgeText))
            {
                <span class="inline-flex items-center rounded-full bg-brand-500/20 px-2.5 py-0.5 text-xs font-semibold text-brand-300 ring-1 ring-inset ring-brand-500/30">
                    @BadgeText
                </span>
            }
            <span class="font-medium text-slate-200">
                @Text
            </span>
            @if (!string.IsNullOrWhiteSpace(ActionText))
            {
                <button type="button"
                        @onclick="HandleActionClick"
                        class="inline-flex items-center gap-1 font-semibold text-brand-400 hover:text-brand-300 transition-colors">
                    <span>@ActionText</span>
                    <span aria-hidden="true">&rarr;</span>
                </button>
            }
        </div>

        @if (Dismissible)
        {
            <div class="flex flex-1 justify-end">
                <button type="button"
                        @onclick="Dismiss"
                        class="-m-1.5 p-1.5 text-slate-400 hover:text-white transition-colors">
                    <span class="sr-only">Dismiss</span>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public bool IsSticky { get; set; } = false;
    [Parameter] public string? Class { get; set; }

    private bool _isVisible = true;

    private async Task HandleActionClick()
    {
        await OnAction.InvokeAsync();
    }

    private void Dismiss()
    {
        _isVisible = false;
    }
}
