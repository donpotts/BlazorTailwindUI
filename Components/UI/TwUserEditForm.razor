@namespace BlazorTailwindUI.Components.UI

<div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden max-w-4xl mx-auto @CustomClass">
    <!-- Header -->
    <div class="p-6 sm:p-8 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border-b border-slate-800">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="relative group">
                    <img src="@_model.AvatarUrl" alt="@_model.DisplayName"
                         class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover ring-4 ring-white/10 shadow-lg" />
                    <button type="button" @onclick="CycleAvatar"
                            class="absolute -bottom-1 -right-1 p-1.5 rounded-lg bg-brand-500 hover:bg-brand-400 text-white shadow-md transition"
                            title="Change Avatar">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </button>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-xl sm:text-2xl font-black tracking-tight">@_model.FullName</h2>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            Active
                        </span>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-400 mt-0.5">@@@_model.Username • @_model.JobTitle at @_model.Department</p>
                    <div class="flex items-center gap-2 mt-2">
                        <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-white/10 text-slate-300">ID: @_model.UserId</span>
                        <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-brand-500/20 text-brand-300 border border-brand-500/30">Enterprise Pro</span>
                    </div>
                </div>
            </div>

            <!-- Tab Buttons -->
            <div class="flex items-center gap-1 bg-white/5 p-1 rounded-2xl border border-white/10 self-start sm:self-center">
                <button type="button" @onclick='() => _activeTab = "profile"'
                        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(_activeTab == "profile" ? "bg-brand-600 text-white shadow" : "text-slate-400 hover:text-white")">
                    Profile
                </button>
                <button type="button" @onclick='() => _activeTab = "security"'
                        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(_activeTab == "security" ? "bg-brand-600 text-white shadow" : "text-slate-400 hover:text-white")">
                    Security
                </button>
                <button type="button" @onclick='() => _activeTab = "preferences"'
                        class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition @(_activeTab == "preferences" ? "bg-brand-600 text-white shadow" : "text-slate-400 hover:text-white")">
                    Preferences
                </button>
            </div>
        </div>
    </div>

    <!-- Tab Content -->
    <div class="p-6 sm:p-8 space-y-6">
        @if (_activeTab == "profile")
        {
            <div class="space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-800 pb-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Personal Information</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Update your public profile, company role, and contact points.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Legal Full Name</label>
                        <input type="text" @bind="_model.FullName"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Display Name / Alias</label>
                        <input type="text" @bind="_model.DisplayName"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Corporate Email</label>
                        <input type="email" @bind="_model.Email"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Job Title</label>
                        <input type="text" @bind="_model.JobTitle"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Department</label>
                        <select @bind="_model.Department"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none">
                            <option value="Architecture & Platform">Architecture & Platform</option>
                            <option value="Core Engineering">Core Engineering</option>
                            <option value="Product Design">Product Design</option>
                            <option value="Cloud Infrastructure">Cloud Infrastructure</option>
                            <option value="Cybersecurity & SOC">Cybersecurity & SOC</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Direct Phone</label>
                        <input type="tel" @bind="_model.PhoneNumber" placeholder="+1 (555) 019-2834"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none" />
                    </div>
                    <div class="space-y-1">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Timezone</label>
                        <select @bind="_model.Timezone"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none">
                            <option value="UTC-08:00 (Pacific Time)">UTC-08:00 (Pacific Time - US/Canada)</option>
                            <option value="UTC-05:00 (Eastern Time)">UTC-05:00 (Eastern Time - US/Canada)</option>
                            <option value="UTC+00:00 (GMT/UTC)">UTC+00:00 (GMT / London)</option>
                            <option value="UTC+01:00 (Central European)">UTC+01:00 (Central European - Paris/Berlin)</option>
                            <option value="UTC+08:00 (Singapore / HK)">UTC+08:00 (Singapore / Hong Kong / Perth)</option>
                            <option value="UTC+09:00 (Tokyo)">UTC+09:00 (Tokyo / Seoul)</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Professional Bio</label>
                        <span class="text-[11px] font-mono text-slate-400">@(_model.Bio?.Length ?? 0) / 250</span>
                    </div>
                    <textarea rows="3" maxlength="250" @bind="_model.Bio" placeholder="Brief technical summary..."
                              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 focus:outline-none resize-none"></textarea>
                </div>
            </div>
        }
        else if (_activeTab == "security")
        {
            <div class="space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-800 pb-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Security & Access Controls</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Manage two-factor authentication, enterprise sessions, and credentials.</p>
                </div>

                <!-- 2FA Box -->
                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold text-slate-900 dark:text-white">Two-Factor Authentication (2FA)</h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Enforce hardware key (FIDO2 / WebAuthn) or TOTP authenticator app verification upon sign in.</p>
                        </div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" @bind="_model.TwoFactorEnabled" class="sr-only peer">
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-emerald-500"></div>
                    </label>
                </div>

                <!-- Active Session Control -->
                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 space-y-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <h4 class="text-sm font-bold text-slate-900 dark:text-white">Active Concurrent Sessions</h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400">3 devices currently authenticated under this corporate tenant.</p>
                        </div>
                        <button type="button" @onclick="TerminateSessions"
                                class="px-3 py-1.5 rounded-xl border border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 text-xs font-bold hover:bg-rose-100 transition">
                            Revoke Other Sessions
                        </button>
                    </div>

                    <div class="space-y-2 pt-1">
                        <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                            <div class="flex items-center gap-2">
                                <span>💻</span>
                                <div>
                                    <span class="font-bold text-slate-800 dark:text-slate-200">Chrome on Windows 11</span>
                                    <span class="text-slate-400 block text-[11px]">Current session • 192.168.1.104</span>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">This Device</span>
                        </div>
                        <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                            <div class="flex items-center gap-2">
                                <span>📱</span>
                                <div>
                                    <span class="font-bold text-slate-800 dark:text-slate-200">Safari on iPhone 15 Pro</span>
                                    <span class="text-slate-400 block text-[11px]">San Francisco, US • 2 hours ago</span>
                                </div>
                            </div>
                            <span class="text-slate-400 text-[11px]">Active</span>
                        </div>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="p-4 sm:p-5 rounded-2xl border border-rose-200 dark:border-rose-900/60 bg-rose-50/50 dark:bg-rose-950/20 space-y-3">
                    <div class="flex items-center gap-2 text-rose-700 dark:text-rose-400 font-bold text-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span>Danger Zone</span>
                    </div>
                    <p class="text-xs text-rose-600/90 dark:text-rose-400/90">
                        Deactivating your profile immediately revokes all enterprise API keys, access tokens, and project permissions across the workspace.
                    </p>
                    <button type="button" @onclick="HandleDeactivate"
                            class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs transition shadow-sm shadow-rose-600/20">
                        Deactivate Corporate Account
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-800 pb-3">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">Workspace & Notification Preferences</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Tailor notifications, telemetry opt-ins, and automated deployment alerts.</p>
                </div>

                <div class="space-y-3">
                    <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 cursor-pointer">
                        <div>
                            <span class="block text-xs font-bold text-slate-800 dark:text-slate-200">Security Incident & Zero-Day Advisories</span>
                            <span class="block text-[11px] text-slate-500 dark:text-slate-400">Instant notifications when security vulnerabilities are flagged in your pipelines.</span>
                        </div>
                        <input type="checkbox" @bind="_model.NotifySecurityAdvisories" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500 h-4 w-4" />
                    </label>

                    <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 cursor-pointer">
                        <div>
                            <span class="block text-xs font-bold text-slate-800 dark:text-slate-200">CI/CD Pipeline Build Completions</span>
                            <span class="block text-[11px] text-slate-500 dark:text-slate-400">Receive desktop and web push alerts upon successful WASM bundle compilation.</span>
                        </div>
                        <input type="checkbox" @bind="_model.NotifyBuildCompletions" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500 h-4 w-4" />
                    </label>

                    <label class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 cursor-pointer">
                        <div>
                            <span class="block text-xs font-bold text-slate-800 dark:text-slate-200">Weekly Executive Performance Digest</span>
                            <span class="block text-[11px] text-slate-500 dark:text-slate-400">Summarized weekly reports with component render latency and memory footprints.</span>
                        </div>
                        <input type="checkbox" @bind="_model.NotifyWeeklyDigest" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500 h-4 w-4" />
                    </label>
                </div>
            </div>
        }

        <!-- Status Toast Banner -->
        @if (!string.IsNullOrEmpty(_notificationMessage))
        {
            <div class="p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400 text-xs font-medium flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span>✅</span>
                    <span>@_notificationMessage</span>
                </div>
                <button type="button" @onclick='() => _notificationMessage = null' class="text-emerald-600 hover:text-emerald-800 dark:hover:text-emerald-300">✕</button>
            </div>
        }

        <!-- Form Actions Footer -->
        <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
            <button type="button" @onclick="ResetForm"
                    class="w-full sm:w-auto px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold hover:bg-slate-50 dark:hover:bg-slate-750 transition">
                Discard Changes
            </button>
            <button type="button" @onclick="HandleSave" disabled="@_isSaving"
                    class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold transition shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2 disabled:opacity-50">
                @if (_isSaving)
                {
                    <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    <span>Saving Profile...</span>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Save Changes</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    public class UserProfileModel
    {
        public string UserId { get; set; } = "USR-94821";
        public string FullName { get; set; } = "Sarah Jenkins, Ph.D.";
        public string DisplayName { get; set; } = "Dr. Jenkins";
        public string Username { get; set; } = "sjenkins_architect";
        public string Email { get; set; } = "s.jenkins@enterprise-core.org";
        public string JobTitle { get; set; } = "Principal Systems Architect";
        public string Department { get; set; } = "Architecture & Platform";
        public string PhoneNumber { get; set; } = "+1 (555) 392-1084";
        public string Timezone { get; set; } = "UTC-08:00 (Pacific Time)";
        public string Bio { get; set; } = "Specializing in high-throughput WebAssembly runtime optimization, enterprise design systems, and zero-trust security postures.";
        public string AvatarUrl { get; set; } = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=256&q=80";
        public bool TwoFactorEnabled { get; set; } = true;
        public bool NotifySecurityAdvisories { get; set; } = true;
        public bool NotifyBuildCompletions { get; set; } = true;
        public bool NotifyWeeklyDigest { get; set; } = false;
    }

    [Parameter] public UserProfileModel? Model { get; set; }
    [Parameter] public string CustomClass { get; set; } = "";
    [Parameter] public EventCallback<UserProfileModel> OnSaved { get; set; }
    [Parameter] public EventCallback OnDeactivate { get; set; }

    private UserProfileModel _model = new();
    private string _activeTab = "profile";
    private bool _isSaving = false;
    private string? _notificationMessage;

    private readonly string[] _avatarOptions = new[]
    {
        "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=256&q=80",
        "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=256&q=80",
        "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=256&q=80",
        "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=256&q=80"
    };
    private int _avatarIndex = 0;

    protected override void OnInitialized()
    {
        if (Model != null)
        {
            _model = Model;
        }
    }

    private void CycleAvatar()
    {
        _avatarIndex = (_avatarIndex + 1) % _avatarOptions.Length;
        _model.AvatarUrl = _avatarOptions[_avatarIndex];
        _notificationMessage = "Avatar preview updated. Click 'Save Changes' to commit.";
    }

    private void TerminateSessions()
    {
        _notificationMessage = "Successfully revoked all remote sessions. Only this browser remains authenticated.";
    }

    private async Task HandleDeactivate()
    {
        _notificationMessage = "Deactivation request logged. Audit ticket #DEL-8839 created.";
        if (OnDeactivate.HasDelegate)
        {
            await OnDeactivate.InvokeAsync();
        }
    }

    private void ResetForm()
    {
        _model = Model ?? new UserProfileModel();
        _notificationMessage = "Changes discarded.";
    }

    private async Task HandleSave()
    {
        _isSaving = true;
        await Task.Delay(600);
        _isSaving = false;
        _notificationMessage = "User profile and security preferences saved successfully.";

        if (OnSaved.HasDelegate)
        {
            await OnSaved.InvokeAsync(_model);
        }
    }
}
