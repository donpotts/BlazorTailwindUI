<div class="flex flex-wrap gap-2 @Class" role="group" aria-label="@Label" data-testid="chat-suggestions">
    @if (Loading)
    {
        @for (var i = 0; i < 3; i++)
        {
            <span class="h-8 w-28 rounded-full bg-slate-200 dark:bg-slate-800 animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>
        }
        <span class="sr-only" role="status">Loading suggestions</span>
    }
    else
    {
        @foreach (var s in Items)
        {
            <button type="button" @onclick="() => OnPick.InvokeAsync(s)" disabled="@Disabled" data-testid="chat-suggestion"
                    class="inline-flex items-center rounded-full border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 min-h-[36px] text-xs font-semibold text-slate-800 dark:text-slate-200 hover:border-brand-500 hover:text-brand-800 dark:hover:text-brand-200 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                @s
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Items { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> OnPick { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Suggested prompts";
    [Parameter] public string? Class { get; set; }
}
