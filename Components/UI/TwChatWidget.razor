<!-- Floating Launcher Button -->
<div class="fixed z-40 @PositionClass">
    @if (!_isOpen)
    {
        <button type="button"
                @onclick="Toggle"
                aria-label="Open AI Assistant"
                class="group relative flex items-center gap-2.5 p-3.5 sm:px-4 sm:py-3 rounded-full bg-brand-600 hover:bg-brand-700 text-white shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-brand-500/30">
            <!-- Pulsing outer ring -->
            <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500 ring-2 ring-white dark:ring-slate-900"></span>
            </span>

            <svg class="w-6 h-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            <span class="hidden sm:inline font-semibold text-sm">Ask AI</span>
        </button>
    }
</div>

<!-- Floating Window on Tablet/Desktop, Bottom Sheet on Mobile -->
@if (_isOpen)
{
    <!-- Mobile Backdrop -->
    <div class="fixed inset-0 z-50 sm:hidden bg-slate-950/60 backdrop-blur-xs" @onclick="Close"></div>

    <div class="fixed z-50 inset-x-0 bottom-0 sm:inset-auto sm:bottom-6 sm:right-6 w-full sm:w-[450px] h-[85vh] sm:h-[650px] sm:max-h-[85vh] animate-in fade-in slide-in-from-bottom-6 duration-200 shadow-2xl">
        <TwChatBot BotName="@BotName"
                   SelectedModel="@SelectedModel"
                   ShowCloseButton="true"
                   OnClose="Close"
                   Class="!rounded-t-3xl sm:!rounded-3xl h-full shadow-2xl" />
    </div>
}

@code {
    private bool _isOpen;

    [Parameter] public string BotName { get; set; } = "NexusAI";
    [Parameter] public string SelectedModel { get; set; } = "Gemini 2.0 Flash";
    /// <summary>Mobile-first position: sits above bottom nav on mobile (bottom-20), standard bottom-6 on tablet/desktop</summary>
    [Parameter] public string PositionClass { get; set; } = "bottom-20 sm:bottom-6 right-4 sm:right-6";

    public void Toggle() => _isOpen = !_isOpen;
    public void Open() => _isOpen = true;
    public void Close() => _isOpen = false;
}
