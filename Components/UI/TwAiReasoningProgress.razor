<div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/60 overflow-hidden my-2.5 transition-all @Class">
    <!-- Header: Thought summary & toggle -->
    <button type="button"
            @onclick="ToggleExpand"
            class="w-full flex items-center justify-between p-3 sm:px-4 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100/70 dark:hover:bg-slate-800/50 transition-colors">
        <div class="flex items-center gap-2">
            @if (IsThinking)
            {
                <!-- Animated glowing brain / spinning aura -->
                <span class="relative flex h-3.5 w-3.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-brand-500"></span>
                </span>
                <span class="font-semibold text-brand-600 dark:text-brand-400 animate-pulse">
                    @ThinkingLabel
                </span>
            }
            else
            {
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600 dark:text-slate-400 font-semibold">
                    Thought for @(DurationSeconds.ToString("0.0"))s
                </span>
            }
        </div>

        <div class="flex items-center gap-1.5 text-slate-400">
            <span class="text-[11px]">@(_isExpanded ? "Hide reasoning" : "Show reasoning")</span>
            <svg class="w-4 h-4 transition-transform duration-200 @(_isExpanded ? "rotate-180" : "")"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </div>
    </button>

    <!-- Animated progress line under header while thinking -->
    @if (IsThinking)
    {
        <div class="h-0.5 w-full bg-slate-200 dark:bg-slate-800 overflow-hidden relative">
            <div class="absolute inset-y-0 w-1/3 bg-gradient-to-r from-transparent via-brand-500 to-transparent animate-[shimmer_1.5s_infinite] -translate-x-full"></div>
        </div>
    }

    <!-- Expandable Thinking Details & Multi-stage steps -->
    @if (_isExpanded)
    {
        <div class="p-3 sm:px-4 pt-1 space-y-2 text-xs border-t border-slate-200/60 dark:border-slate-800/60 bg-white/50 dark:bg-slate-950/30">
            @if (Steps != null && Steps.Any())
            {
                <div class="space-y-2 py-1">
                    @foreach (var step in Steps)
                    {
                        <div class="flex items-center gap-2.5">
                            @if (step.Status == StepStatus.Completed)
                            {
                                <div class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                                <span class="text-slate-600 dark:text-slate-400 line-through opacity-80">@step.Label</span>
                            }
                            else if (step.Status == StepStatus.InProgress)
                            {
                                <div class="w-4 h-4 flex items-center justify-center shrink-0">
                                    <div class="w-3.5 h-3.5 border-2 border-brand-500 border-t-transparent rounded-full animate-spin"></div>
                                </div>
                                <span class="font-medium text-brand-600 dark:text-brand-400">@step.Label</span>
                            }
                            else
                            {
                                <div class="w-4 h-4 rounded-full border border-slate-300 dark:border-slate-700 flex items-center justify-center shrink-0">
                                    <div class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></div>
                                </div>
                                <span class="text-slate-400 dark:text-slate-500">@step.Label</span>
                            }
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ReasoningText))
            {
                <div class="mt-2 text-slate-600 dark:text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap bg-slate-100 dark:bg-slate-900 p-2.5 rounded-xl border border-slate-200/60 dark:border-slate-800">
                    @ReasoningText
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool IsThinking { get; set; } = true;
    [Parameter] public double DurationSeconds { get; set; } = 2.4;
    [Parameter] public string ThinkingLabel { get; set; } = "Reasoning step-by-step...";
    [Parameter] public string? ReasoningText { get; set; }
    [Parameter] public IReadOnlyList<ReasoningStep>? Steps { get; set; }
    [Parameter] public bool DefaultExpanded { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _isExpanded;

    protected override void OnInitialized()
    {
        _isExpanded = DefaultExpanded || IsThinking;
    }

    private void ToggleExpand() => _isExpanded = !_isExpanded;
}
