@using BlazorTailwindUI.Models
@using BlazorTailwindUI.Services
@inject TwDonutCacheService CacheService

<div class="btui-donut-cache rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden">
    <!-- Header with Donut Caching Status -->
    <div class="p-3 bg-slate-50 dark:bg-slate-850 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold font-mono @(_wasCacheHit ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20" : "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20")">
                <span class="w-1.5 h-1.5 rounded-full @(_wasCacheHit ? "bg-emerald-500" : "bg-amber-500 animate-pulse")"></span>
                @(_wasCacheHit ? "DONUT CACHE HIT" : "FRESH RENDER MISS")
            </span>
            <span class="text-slate-500 dark:text-slate-400 font-mono text-[11px]">Key: @CacheKey</span>
        </div>

        <div class="flex items-center gap-2">
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
                Saved: <strong class="text-slate-900 dark:text-white">@(_entry?.GenerationDurationMs.ToString("F1") ?? "0.0")ms</strong>
            </span>
            <button type="button" @onclick="HandleInvalidate" class="px-2 py-0.5 rounded text-[11px] font-medium bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800 hover:bg-rose-100 transition">
                ⚡ Invalidate Tag (@(Tags.FirstOrDefault() ?? "default"))
            </button>
        </div>
    </div>

    <!-- Cached Shell Content with Hole Punch -->
    <div class="p-4 space-y-4">
        <!-- Static Shell Area -->
        <div class="relative p-3 rounded-xl bg-slate-50/70 dark:bg-slate-850/50 border border-dashed border-slate-200 dark:border-slate-800">
            <div class="absolute -top-2.5 left-3 px-1.5 bg-white dark:bg-slate-900 text-[10px] font-mono text-slate-400 uppercase tracking-wider">
                Static Shell (Edge-Cached)
            </div>
            @if (StaticContent != null)
            {
                @StaticContent
            }
            else
            {
                <div class="text-xs text-slate-600 dark:text-slate-400 py-1">
                    @(_entry?.StaticHtml ?? "Pre-rendered static HTML shell.")
                </div>
            }
        </div>

        <!-- Dynamic Donut Hole Slot -->
        <div class="relative p-3 rounded-xl bg-brand-50/40 dark:bg-brand-950/20 border-2 border-brand-500/40">
            <div class="absolute -top-2.5 left-3 px-1.5 bg-white dark:bg-slate-900 text-[10px] font-mono font-bold text-brand-600 dark:text-brand-400 uppercase tracking-wider flex items-center gap-1">
                <span>🍩</span> Dynamic Donut Hole (Per-Request Perforation)
            </div>
            @if (DynamicHole != null)
            {
                @DynamicHole
            }
            else
            {
                <div class="text-xs font-mono text-brand-700 dark:text-brand-300 py-1">
                    Hole Content at @DateTime.UtcNow.ToString("HH:mm:ss.fff") UTC
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string CacheKey { get; set; } = "default_donut";

    [Parameter]
    public TimeSpan Duration { get; set; } = TimeSpan.FromMinutes(5);

    [Parameter]
    public List<string> Tags { get; set; } = new() { "catalog" };

    [Parameter]
    public RenderFragment? StaticContent { get; set; }

    [Parameter]
    public RenderFragment? DynamicHole { get; set; }

    private DonutCacheEntry? _entry;
    private bool _wasCacheHit;

    protected override async Task OnParametersSetAsync()
    {
        var result = await CacheService.GetOrCreateAsync(
            CacheKey,
            () => Task.FromResult($"<p class='text-xs text-slate-600'>Edge-cached catalog table generated at {DateTime.UtcNow:HH:mm:ss} UTC with zero downstream middleware.</p>"),
            Duration,
            Tags,
            holeCount: 1
        );

        _entry = result.Entry;
        _wasCacheHit = result.WasCacheHit;
    }

    private void HandleInvalidate()
    {
        if (Tags.Count > 0)
        {
            CacheService.InvalidateByTag(Tags[0]);
        }
        else
        {
            CacheService.ClearAll();
        }
        _ = OnParametersSetAsync();
    }
}
